---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { Header } from "../../../../components/layout/Header";
import { Card, CardContent, CardHeader, CardTitle } from "../../../../components/ui/card";
import { Button } from "../../../../components/ui/button";
import { Badge } from "../../../../components/ui/badge";
import { Star, GitFork, Copy, ExternalLink } from "lucide-react";
const { instance, owner, repo } = Astro.params;
const fullName = `${owner}/${repo}`;
---
<BaseLayout title={`${fullName} — Community`}>
  <Header client:load />
  <main class="container px-4 py-8 space-y-6">
    <div class="flex items-center gap-2 text-sm text-muted-foreground"><a href="/explore" class="hover:text-foreground">Explore</a> / <span>{instance}</span> / <span class="text-foreground font-medium">{fullName}</span></div>
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div><h1 class="text-2xl font-bold flex items-center gap-2">{fullName} <Badge variant="outline">public</Badge></h1><p class="text-sm text-muted-foreground">Aggregated from <code>{instance}</code> • Clone via <code>httpCloneUrl</code> on your own node to contribute</p></div>
      <div class="flex gap-2"><Button variant="outline"><Star className="h-4 w-4 mr-1" />Star</Button><Button variant="outline"><GitFork className="h-4 w-4 mr-1" />Fork</Button><Button><Copy className="h-4 w-4 mr-1" />Clone</Button></div>
    </div>
    <div class="grid lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2 space-y-4">
        <Card><CardHeader><CardTitle>README</CardTitle></CardHeader><CardContent class="prose prose-sm dark:prose-invert max-w-none"><p class="text-sm text-muted-foreground">README is fetched from the instance's default branch via git. This federated view mirrors GitHub's repo page.</p></CardContent></Card>
        <Card><CardHeader><CardTitle>How to contribute</CardTitle></CardHeader><CardContent class="text-sm space-y-2"><p>1. You need your own OpenCodeHub node (self-host or use a hosted one).</p><p>2. Clone: <code class="bg-muted px-1.5 py-0.5 rounded text-xs">git clone https://{instance}/{fullName}.git</code></p><p>3. Submit your instance URL at <a href="/instances/submit" class="text-primary underline">/instances/submit</a> if not already listed, then open a cross-instance PR.</p></CardContent></Card>
      </div>
      <div class="space-y-4">
        <Card><CardContent class="p-4 space-y-3">
          <div class="flex justify-between text-sm"><span class="text-muted-foreground">Stars</span><span class="font-semibold flex items-center gap-1"><Star className="h-4 w-4" /> —</span></div>
          <div class="flex justify-between text-sm"><span class="text-muted-foreground">Forks</span><span class="font-semibold flex items-center gap-1"><GitFork className="h-4 w-4" /> —</span></div>
          <Button class="w-full" variant="outline" onclick={`window.open('https://${instance}/${fullName}', '_blank')`}><ExternalLink className="h-4 w-4 mr-1" />View on instance</Button>
        </CardContent></Card>
        <Card class="bg-primary/5 border-primary/20"><CardContent class="p-4 text-xs"><b>Community star</b> is local to this hub (stored in Turso). It does not mutate the remote instance — star there directly if you have an account on that node.</CardContent></Card>
      </div>
    </div>
  </main>
</BaseLayout>

---
import "../styles/globals.css";
import { Toaster } from "../components/ui/toaster";
import Footer from "../components/layout/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "OpenCodeHub Community — Discover & Connect",
  description = "Aggregating public repositories, developers, and nodes from self-hosted OpenCodeHub instances worldwide."
} = Astro.props;
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen bg-background font-sans antialiased text-foreground selection:bg-primary/20 selection:text-primary flex flex-col">
    <div class="flex-1 flex flex-col">
      <slot />
    </div>
    <Footer />
    <Toaster client:load />
  </body>
</html>

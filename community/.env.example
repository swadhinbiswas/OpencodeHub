# ======================================================
# OpenCodeHub Community Hub — Environment Variables
# ======================================================
# REQUIRED: Turso database URL (create at https://turso.tech/dashboard)
# Format: libsql://your-db-name-your-org.turso.io
TURSO_DATABASE_URL=

# REQUIRED: Turso auth token (from https://turso.tech/dashboard → your DB → Tokens)
TURSO_AUTH_TOKEN=

# JWT secret for community auth (change in production)
JWT_SECRET=change-me-in-production

# Upstash Redis (optional — for caching probe/repos data)
# Get these from https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Site URL (where the community hub is hosted)
SITE_URL=http://localhost:4322

{
  "name": "opencodehub",
  "version": "1.0.0",
  "description": "A fully self-hosted, open-source GitHub/GitLab alternative with SSH git hosting, pipelines/actions, and advanced UI",
  "type": "module",
  "workspaces": [
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/swadhinbiswas/OpencodeHub.git"
  },
  "homepage": "https://github.com/swadhinbiswas/OpencodeHub#readme",
  "bugs": {
    "url": "https://github.com/swadhinbiswas/OpencodeHub/issues"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "start:ssh": "bun scripts/ssh-server.ts",
    "start:worker": "bun scripts/worker.ts",
    "migrate": "bun scripts/migrate.ts",
    "preview": "astro preview",
    "astro": "astro",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "git:init": "node scripts/init-git-server.cjs",
    "git:start": "bun scripts/ssh-server.ts",
    "worker:start": "bun scripts/worker.ts",
    "runner:start": "bun src/runner/index.ts",
    "lint": "bunx astro check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit src",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:smoke": "vitest run tests/smoke",
    "test:coverage": "vitest run --coverage",
    "security:audit": "node scripts/security/audit.mjs",
    "security:prepush": "bash scripts/security/pre-push-secret-scan.sh",
    "hooks:install": "bash scripts/security/install-hooks.sh",
    "backup": "bun scripts/backup.ts",
    "docs:parity": "node scripts/check-docs-parity.mjs",
    "perf:baseline": "node scripts/perf/load-baseline.mjs"
  },

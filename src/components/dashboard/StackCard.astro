---
interface Props {
  stack: {
    id: string;
    name: string;
    repoName: string;
    repoOwner: string;
    status: string;
    updatedAt: string;
    prs: {
      id: string;
      number: number;
      title: string;
      status: string;
      url: string;
      position: number;
      isMerged: boolean;
      isClosed: boolean;
    }[];
  };
}

const { stack } = Astro.props;

// Determine stack status color
const isFullyMerged = stack.prs.every(pr => pr.isMerged);
const hasFailures = stack.prs.some(pr => pr.status === 'failure' || pr.status === 'error');
const isDraft = stack.prs.some(pr => pr.status === 'draft');

const statusColor = isFullyMerged ? "text-emerald-500" : hasFailures ? "text-red-400" : isDraft ? "text-muted-foreground" : "text-primary";
const statusBorder = isFullyMerged ? "border-emerald-500/30" : hasFailures ? "border-red-500/30" : isDraft ? "border-border" : "border-primary/30";
const statusBg = isFullyMerged ? "bg-emerald-500/10" : hasFailures ? "bg-red-500/10" : isDraft ? "bg-muted/40" : "bg-primary/10";
---

<div class="rounded-xl border border-border/80 bg-card/60 backdrop-blur-sm p-5 hover:border-border hover:bg-accent/40 transition-colors shadow-sm">
    <!-- Header -->
    <div class="flex items-center justify-between mb-4 pb-3 border-b border-border/60">
        <div>
            <div class="flex items-center gap-2">
                <span class="text-sm font-bold text-foreground">{stack.name}</span>
                <span class="text-xs text-muted-foreground">in {stack.repoOwner}/{stack.repoName}</span>
            </div>
            <div class="text-[11px] text-muted-foreground mt-0.5">
                Updated {new Date(stack.updatedAt).toLocaleDateString()}
            </div>
        </div>
        <div class={`text-xs font-semibold px-2 py-0.5 rounded-full border ${statusBorder} ${statusColor} ${statusBg}`}>
            {isFullyMerged ? "Merged" : hasFailures ? "Failed" : isDraft ? "Draft" : "Active"}
        </div>
    </div>

    <!-- Stack Subway Visualization -->
    <div class="relative pl-2 space-y-0">
        {stack.prs.map((pr, index) => (
            <div class="relative flex items-start gap-3 pb-4 last:pb-0">
                <!-- Connecting Line -->
                {index !== stack.prs.length - 1 && (
                    <div class="absolute left-[5px] top-2.5 bottom-0 w-0.5 bg-border" />
                )}
                
                <!-- Dot -->
                <div class={`relative z-10 w-3 h-3 rounded-full mt-1 border-2 ${
                    pr.isMerged 
                        ? "bg-emerald-500 border-emerald-500" 
                        : pr.isClosed
                            ? "bg-red-500 border-red-500"
                            : "bg-background border-primary"
                }`} />

                <!-- Content -->
                <div class="flex-1 min-w-0">
                    <a href={pr.url} class="block hover:underline truncate text-sm font-semibold text-foreground hover:text-primary transition-colors">
                        {pr.title}
                    </a>
                    <div class="flex items-center gap-2 text-xs text-muted-foreground mt-0.5">
                        <span class="font-mono text-[11px]">#{pr.number}</span>
                        <span>·</span>
                        <span class={
                            pr.isMerged ? "text-emerald-500 font-medium" : pr.isClosed ? "text-red-400 font-medium" : "text-primary font-medium"
                        }>
                            {pr.status.charAt(0).toUpperCase() + pr.status.slice(1)}
                        </span>
                    </div>
                </div>
            </div>
        ))}
    </div>
</div>

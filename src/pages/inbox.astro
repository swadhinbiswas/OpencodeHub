---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDatabase, schema } from "@/db";
import { eq, desc, and } from "drizzle-orm";
import {
  Inbox as InboxIcon,
  GitPullRequest,
  Clock,
  CheckCircle2,
  Eye,
  Layers,
  Sparkles
} from "lucide-react";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login");
}

const db = getDatabase();
const filter = Astro.url.searchParams.get("filter") || "review";

// Fetch PRs based on filter
let prs: any[] = [];
let title = "Inbox";

try {
  if (filter === "review") {
    title = "Needs Your Review";
    const reviewerRequests = await db.query.pullRequestReviewers.findMany({
      where: eq(schema.pullRequestReviewers.userId, user.id),
    });

    const prIds = reviewerRequests.map((r) => r.pullRequestId);
    if (prIds.length > 0) {
      const allOpen = await db.query.pullRequests.findMany({
        where: and(eq(schema.pullRequests.state, "open")),
        orderBy: [desc(schema.pullRequests.updatedAt)],
        with: {
          repository: {
            with: {
              owner: true
            }
          },
          author: true,
        },
      });
      prs = allOpen.filter((pr) => prIds.includes(pr.id));
    }
  } else if (filter === "authored") {
    title = "Your PRs in Review";
    prs = await db.query.pullRequests.findMany({
      where: and(
        eq(schema.pullRequests.authorId, user.id),
        eq(schema.pullRequests.state, "open"),
      ),
      orderBy: [desc(schema.pullRequests.updatedAt)],
      with: {
        repository: {
          with: {
            owner: true
          }
        },
        author: true,
      },
    });
  } else if (filter === "approved") {
    title = "Ready to Merge";
    prs = await db.query.pullRequests.findMany({
      where: and(
        eq(schema.pullRequests.authorId, user.id),
        eq(schema.pullRequests.state, "open"),
        eq(schema.pullRequests.mergeableState, "clean"),
      ),
      orderBy: [desc(schema.pullRequests.updatedAt)],
      with: {
        repository: {
          with: {
            owner: true
          }
        },
        author: true,
      },
    });
  } else if (filter === "all") {
    title = "All PRs";
    prs = await db.query.pullRequests.findMany({
      where: eq(schema.pullRequests.state, "open"),
      orderBy: [desc(schema.pullRequests.updatedAt)],
      limit: 50,
      with: {
        repository: {
          with: {
            owner: true
          }
        },
        author: true,
      },
    });
  }
} catch (e) {
  console.error("Failed to fetch PRs:", e);
}

// Get stack info for each PR
const prsWithStacks = await Promise.all(
  prs.map(async (pr) => {
    let stackInfo = null;
    try {
      const stackEntry = await db.query.prStackEntries.findFirst({
        where: eq(schema.prStackEntries.pullRequestId, pr.id),
        with: {
          stack: {
            with: {
              entries: true,
            },
          },
        },
      });

      if (stackEntry && stackEntry.stack) {
        stackInfo = {
          name: stackEntry.stack.name,
          position: stackEntry.stackOrder + 1,
          count: stackEntry.stack.entries.length,
        };
      }
    } catch (e) {}

    let reviewCount = 0;
    try {
      const reviews = await db.query.pullRequestReviews.findMany({
        where: eq(schema.pullRequestReviews.pullRequestId, pr.id),
      });
      reviewCount = reviews.length;
    } catch (e) {}

    return {
      ...pr,
      stackInfo,
      reviewCount,
    };
  }),
);

// Counts for tabs
const counts = {
  review: 0,
  authored: 0,
};
try {
  const reviewerRequests = await db.query.pullRequestReviewers.findMany({
    where: eq(schema.pullRequestReviewers.userId, user.id),
  });
  counts.review = reviewerRequests.length;

  const authored = await db.query.pullRequests.findMany({
    where: and(
      eq(schema.pullRequests.authorId, user.id),
      eq(schema.pullRequests.state, "open"),
    ),
  });
  counts.authored = authored.length;
} catch (e) {}

function timeAgo(date: string | number | Date) {
  if (!date) return "";
  const seconds = Math.floor((Date.now() - new Date(date).getTime()) / 1000);
  if (seconds < 60) return "just now";
  if (seconds < 3600) return Math.floor(seconds / 60) + "m ago";
  if (seconds < 86400) return Math.floor(seconds / 3600) + "h ago";
  if (seconds < 604800) return Math.floor(seconds / 86400) + "d ago";
  return new Date(date).toLocaleDateString();
}
---

<BaseLayout title="Inbox · OpenCodeHub">
  <div class="container max-w-[1280px] mx-auto py-8 px-4 sm:px-6 space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-border">
      <div>
        <h1 class="text-2xl font-bold text-foreground tracking-tight flex items-center gap-2.5">
          <InboxIcon className="h-6 w-6 text-foreground" />
          <span>Review Inbox</span>
          <span class="rounded-full bg-secondary px-2.5 py-0.5 text-xs font-semibold text-muted-foreground border border-border/60">
            {prsWithStacks.length}
          </span>
        </h1>
        <p class="text-sm text-muted-foreground mt-1">
          High-velocity cockpit for reviews, incoming changes, and mergeable PRs
        </p>
      </div>

      <div class="flex items-center gap-2 self-start sm:self-auto">
        <button
          onclick="document.getElementById('keyboard-shortcuts-modal')?.classList.remove('hidden')"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-border bg-card text-xs font-medium text-foreground hover:bg-accent transition-colors shadow-sm"
        >
          <span>Shortcuts</span>
          <kbd class="px-1.5 py-0.2 bg-secondary rounded text-[10px] font-mono text-muted-foreground">?</kbd>
        </button>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="inline-flex items-center gap-1 p-1 rounded-lg border border-border/80 bg-card/60 backdrop-blur-sm self-start">
      <a
        href="/inbox?filter=review"
        class:list={[
          "inline-flex items-center gap-2 px-3 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors",
          filter === "review"
            ? "bg-secondary text-foreground font-semibold shadow-sm"
            : "text-muted-foreground hover:text-foreground hover:bg-muted/60",
        ]}
      >
        <Eye className="h-3.5 w-3.5" />
        <span>Needs Review</span>
        {counts.review > 0 && (
          <span class="rounded-full bg-primary/10 text-primary border border-primary/20 px-1.5 py-0.2 text-[10px] font-bold">
            {counts.review}
          </span>
        )}
      </a>
      <a
        href="/inbox?filter=authored"
        class:list={[
          "inline-flex items-center gap-2 px-3 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors",
          filter === "authored"
            ? "bg-secondary text-foreground font-semibold shadow-sm"
            : "text-muted-foreground hover:text-foreground hover:bg-muted/60",
        ]}
      >
        <Clock className="h-3.5 w-3.5" />
        <span>Waiting on Others</span>
        {counts.authored > 0 && (
          <span class="rounded-full bg-muted px-1.5 py-0.2 text-[10px] font-semibold text-muted-foreground">
            {counts.authored}
          </span>
        )}
      </a>
      <a
        href="/inbox?filter=approved"
        class:list={[
          "inline-flex items-center gap-2 px-3 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors",
          filter === "approved"
            ? "bg-secondary text-foreground font-semibold shadow-sm"
            : "text-muted-foreground hover:text-foreground hover:bg-muted/60",
        ]}
      >
        <CheckCircle2 className="h-3.5 w-3.5" />
        <span>Ready to Merge</span>
      </a>
      <a
        href="/inbox?filter=all"
        class:list={[
          "inline-flex items-center gap-2 px-3 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors",
          filter === "all"
            ? "bg-secondary text-foreground font-semibold shadow-sm"
            : "text-muted-foreground hover:text-foreground hover:bg-muted/60",
        ]}
      >
        <span>All</span>
      </a>
    </div>

    <!-- PR List Card -->
    <div class="rounded-xl border border-border/80 bg-card/60 backdrop-blur-sm overflow-hidden shadow-sm">
      {prsWithStacks.length === 0 ? (
        <div class="text-center py-16 px-4">
          <div class="w-12 h-12 rounded-full bg-secondary/80 border border-border flex items-center justify-center mx-auto mb-3 text-muted-foreground">
            <InboxIcon className="h-6 w-6" />
          </div>
          <h3 class="text-base font-semibold text-foreground mb-1">No pull requests</h3>
          <p class="text-sm text-muted-foreground max-w-sm mx-auto">
            {filter === "review"
              ? "You have no pull requests waiting for your review. Great job!"
              : filter === "authored"
                ? "You have no open pull requests."
                : "No pull requests to display in this view."}
          </p>
        </div>
      ) : (
        <div class="divide-y divide-border/60">
          {prsWithStacks.map((pr) => {
            const ownerName = pr.repository?.owner?.username || "repo";
            const repoName = pr.repository?.name || "";
            return (
              <a
                data-pr-item
                href={`/${ownerName}/${repoName}/pulls/${pr.number}`}
                class="group flex items-start gap-3.5 p-4 hover:bg-accent/40 transition-colors"
              >
                <!-- PR Icon -->
                <div class="mt-0.5 flex-shrink-0">
                  <div
                    class:list={[
                      "h-6 w-6 rounded-full flex items-center justify-center border",
                      pr.isDraft
                        ? "bg-muted/40 text-muted-foreground border-border"
                        : "bg-emerald-500/10 text-emerald-500 border-emerald-500/20",
                    ]}
                  >
                    <GitPullRequest className="h-3.5 w-3.5" />
                  </div>
                </div>

                <!-- Content -->
                <div class="flex-1 min-w-0">
                  <div class="flex items-baseline gap-2 flex-wrap mb-1">
                    <span class="text-xs font-semibold text-muted-foreground">
                      {ownerName}/{repoName}
                    </span>
                    <span class="text-xs text-muted-foreground/80 font-mono">#{pr.number}</span>
                    {pr.isDraft && (
                      <span class="text-[10px] bg-secondary text-muted-foreground px-1.5 py-0.2 rounded border border-border/50">
                        Draft
                      </span>
                    )}
                    {pr.stackInfo && (
                      <span class="inline-flex items-center gap-1 text-[10px] bg-purple-500/10 text-purple-400 border border-purple-500/20 px-1.5 py-0.2 rounded font-semibold">
                        <Layers className="h-2.5 w-2.5" />
                        Stack {pr.stackInfo.position}/{pr.stackInfo.count}
                      </span>
                    )}
                  </div>

                  <h3 class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors leading-snug break-words">
                    {pr.title}
                  </h3>

                  <div class="flex items-center gap-3 mt-2 flex-wrap text-xs text-muted-foreground">
                    <span>opened by @{pr.author?.username || "unknown"}</span>
                    <span>·</span>
                    <span>updated {timeAgo(pr.updatedAt)}</span>
                    {pr.reviewCount > 0 && (
                      <>
                        <span>·</span>
                        <span>{pr.reviewCount} reviews</span>
                      </>
                    )}
                  </div>
                </div>

                <!-- Author Avatar -->
                <div class="hidden sm:block flex-shrink-0">
                  {pr.author?.avatarUrl ? (
                    <img
                      src={pr.author.avatarUrl}
                      alt={pr.author.username}
                      class="h-7 w-7 rounded-full border border-border/80 object-cover"
                    />
                  ) : (
                    <div class="h-7 w-7 rounded-full bg-secondary border border-border/80 flex items-center justify-center text-xs font-medium text-foreground">
                      {pr.author?.username?.[0]?.toUpperCase() || "?"}
                    </div>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </div>

  <!-- Keyboard Shortcuts Modal -->
  <div
    id="keyboard-shortcuts-modal"
    class="hidden fixed inset-0 bg-black/60 backdrop-blur-xs flex items-center justify-center z-50 p-4"
  >
    <div class="bg-card border border-border rounded-xl shadow-xl p-6 max-w-sm w-full space-y-4">
      <h3 class="text-base font-bold text-foreground">Keyboard Shortcuts</h3>
      <div class="space-y-2 text-xs text-muted-foreground divide-y divide-border/40">
        <div class="flex justify-between py-1.5">
          <kbd class="px-2 py-0.5 bg-secondary rounded text-[11px] font-mono text-foreground">j</kbd>
          <span>Next PR</span>
        </div>
        <div class="flex justify-between py-1.5">
          <kbd class="px-2 py-0.5 bg-secondary rounded text-[11px] font-mono text-foreground">k</kbd>
          <span>Previous PR</span>
        </div>
        <div class="flex justify-between py-1.5">
          <kbd class="px-2 py-0.5 bg-secondary rounded text-[11px] font-mono text-foreground">o / Enter</kbd>
          <span>Open PR</span>
        </div>
        <div class="flex justify-between py-1.5">
          <kbd class="px-2 py-0.5 bg-secondary rounded text-[11px] font-mono text-foreground">r</kbd>
          <span>Refresh</span>
        </div>
        <div class="flex justify-between py-1.5">
          <kbd class="px-2 py-0.5 bg-secondary rounded text-[11px] font-mono text-foreground">Esc</kbd>
          <span>Close</span>
        </div>
      </div>
      <button
        onclick="document.getElementById('keyboard-shortcuts-modal').classList.add('hidden')"
        class="w-full py-2 bg-foreground text-background text-xs font-semibold rounded-md hover:bg-foreground/90 transition-colors"
      >
        Close
      </button>
    </div>
  </div>
</BaseLayout>

<script>
  function initInboxKeyboardShortcuts() {
    let selectedIndex = 0;
    const prItems = document.querySelectorAll("[data-pr-item]");

    if (prItems.length === 0) return;

    const highlightPR = (index: number) => {
      prItems.forEach((item, i) => {
        if (i === index) {
          item.classList.add("bg-accent/70");
          item.scrollIntoView({ block: "nearest", behavior: "smooth" });
        } else {
          item.classList.remove("bg-accent/70");
        }
      });
    };

    highlightPR(0);

    document.addEventListener("keydown", (e) => {
      const target = e.target as HTMLElement;
      if (target.tagName === "INPUT" || target.tagName === "TEXTAREA") return;

      switch (e.key.toLowerCase()) {
        case "j":
          e.preventDefault();
          selectedIndex = Math.min(selectedIndex + 1, prItems.length - 1);
          highlightPR(selectedIndex);
          break;
        case "k":
          e.preventDefault();
          selectedIndex = Math.max(selectedIndex - 1, 0);
          highlightPR(selectedIndex);
          break;
        case "o":
        case "enter":
          e.preventDefault();
          (prItems[selectedIndex] as HTMLElement)?.click();
          break;
        case "r":
          e.preventDefault();
          window.location.reload();
          break;
        case "?":
          e.preventDefault();
          document.getElementById("keyboard-shortcuts-modal")?.classList.toggle("hidden");
          break;
        case "escape":
          e.preventDefault();
          document.getElementById("keyboard-shortcuts-modal")?.classList.add("hidden");
          break;
      }
    });
  }

  initInboxKeyboardShortcuts();
</script>

---
import { resolveOrgOwners } from "@/lib/repo-owner";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDatabase, schema } from "@/db";
import { eq, desc, and, asc } from "drizzle-orm";
import {
    GitMerge,
    Clock,
    CheckCircle2,
    XCircle,
    Loader2,
    Pause,
    Play,
    Layers,
    AlertCircle,
    Trash2,
    ArrowUp,
    ArrowDown,
    RefreshCw,
    ArrowRight
} from "lucide-react";

const user = Astro.locals.user;
if (!user) {
    return Astro.redirect("/login");
}

const db = getDatabase();
const repoFilter = Astro.url.searchParams.get("repo") || "";

// Get all repositories user has access to
let userRepos: { id: string; name: string; fullName?: string }[] = [];
try {
    const repos = await db.query.repositories.findMany({
        where: eq(schema.repositories.ownerId, user.id),
        columns: { id: true, name: true },
        with: { owner: { columns: { username: true } } },
    });
    userRepos = repos.map((r) => ({
        id: r.id,
        name: r.name,
        fullName: `${r.owner.username}/${r.name}`,
    }));
} catch (e) {}

// Get merge queue items
interface QueueItemWithDetails {
    id: string;
    position: number;
    status: string;
    priority: number;
    mergeMethod: string;
    addedAt: string;
    pr: {
        number: number;
        title: string;
        headBranch: string;
        baseBranch: string;
        additions?: number;
        deletions?: number;
        author?: { username: string; avatarUrl?: string };
    } | null;
    stackInfo?: {
        id: string;
        name: string | null;
        position: number;
        total: number;
    };
    ciStatus?: string;
    estimatedMerge?: Date;
}

let queueItems: QueueItemWithDetails[] = [];
let isPaused = false;

try {
    const query = repoFilter
        ? and(
              eq(schema.mergeQueue.repositoryId, repoFilter),
              eq(schema.mergeQueue.status, "pending"),
          )
        : eq(schema.mergeQueue.status, "pending");

    const items = await db.query.mergeQueue.findMany({
        where: query,
        orderBy: [
            desc(schema.mergeQueue.priority),
            asc(schema.mergeQueue.position),
        ],
        with: {
            pullRequest: {
                with: {
                    author: true,
                },
            },
        },
    });
    const mqItems = await resolveOrgOwners(items);

    let currentPosition = 1;
    for (const item of mqItems) {
        let stackInfo;
        if (item.pullRequest?.id) {
            try {
                const stackEntry = await db.query.prStackEntries.findFirst({
                    where: eq(schema.prStackEntries.pullRequestId, item.pullRequest.id),
                    with: {
                        stack: {
                            with: {
                                entries: true,
                            },
                        },
                    },
                });
                if (stackEntry?.stack) {
                    stackInfo = {
                        id: stackEntry.stack.id,
                        name: stackEntry.stack.name,
                        position: stackEntry.stackOrder + 1,
                        total: stackEntry.stack.entries.length,
                    };
                }
            } catch (e) {}
        }

        const estimatedMinutes = currentPosition * 5;
        const estimatedMerge = new Date(Date.now() + estimatedMinutes * 60 * 1000);

        queueItems.push({
            id: item.id,
            position: currentPosition,
            status: item.status,
            priority: item.priority ?? 0,
            mergeMethod: item.mergeMethod || "merge",
            addedAt: item.addedAt ? new Date(item.addedAt).toISOString() : new Date().toISOString(),
            pr: item.pullRequest
                ? {
                      number: item.pullRequest.number,
                      title: item.pullRequest.title,
                      headBranch: item.pullRequest.headBranch,
                      baseBranch: item.pullRequest.baseBranch,
                      additions: item.pullRequest.additions || 0,
                      deletions: item.pullRequest.deletions || 0,
                      author: item.pullRequest.author
                          ? {
                                username: item.pullRequest.author.username,
                                avatarUrl:
                                    item.pullRequest.author.avatarUrl ||
                                    undefined,
                            }
                          : undefined,
                  }
                : null,
            stackInfo,
            ciStatus: "pending",
            estimatedMerge,
        });

        currentPosition++;
    }
} catch (e) {
    console.error("Failed to fetch merge queue:", e);
}

function formatTime(date: Date | string) {
    const d = date instanceof Date ? date : new Date(date);
    return d.toLocaleTimeString("en-US", {
        hour: "2-digit",
        minute: "2-digit",
    });
}
---

<BaseLayout title="Merge Queue · OpenCodeHub">
    <div class="container max-w-[1280px] mx-auto py-8 px-4 sm:px-6">
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-border mb-6">
            <div>
                <h1 class="text-2xl font-bold text-foreground tracking-tight flex items-center gap-2.5">
                    <GitMerge className="h-6 w-6 text-foreground" />
                    <span>Merge Queue</span>
                    <span class="rounded-full bg-secondary px-2.5 py-0.5 text-xs font-semibold text-muted-foreground border border-border/60">
                        {queueItems.length}
                    </span>
                </h1>
                <p class="text-sm text-muted-foreground mt-1">
                    Automated serial merge queue with speculative CI execution
                </p>
            </div>

            <div class="flex items-center gap-2.5 flex-wrap self-start sm:self-auto">
                {userRepos.length > 1 && (
                    <select
                        id="repo-filter"
                        class="h-8 bg-card border border-border/70 rounded-md px-2.5 py-1 text-xs text-foreground focus:outline-none focus:ring-2 focus:ring-primary/20 transition-colors"
                    >
                        <option value="">All Repositories</option>
                        {userRepos.map((repo) => (
                            <option
                                value={repo.id}
                                selected={repoFilter === repo.id}
                            >
                                {repo.fullName || repo.name}
                            </option>
                        ))}
                    </select>
                )}

                <button
                    onclick="window.location.reload()"
                    class="p-1.5 rounded-md border border-border bg-card text-muted-foreground hover:text-foreground hover:bg-accent transition-colors shadow-sm"
                    title="Refresh queue"
                >
                    <RefreshCw className="h-4 w-4" />
                </button>
            </div>
        </div>

        <!-- Queue Status Banner (if paused) -->
        {isPaused && (
            <div class="flex items-center gap-3 p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/20 mb-6 text-amber-300">
                <AlertCircle className="h-4 w-4 text-amber-400 flex-shrink-0" />
                <span class="text-xs font-medium">
                    Merge queue is paused. No pull requests will merge until resumed.
                </span>
            </div>
        )}

        <!-- Queue Items Card -->
        <div class="rounded-xl border border-border/80 bg-card/60 backdrop-blur-sm overflow-hidden shadow-sm mb-6">
            {queueItems.length === 0 ? (
                <div class="text-center py-16 px-4">
                    <div class="w-12 h-12 rounded-full bg-secondary/80 border border-border flex items-center justify-center mx-auto mb-3 text-muted-foreground">
                        <GitMerge className="h-6 w-6" />
                    </div>
                    <h3 class="text-base font-semibold text-foreground mb-1">Queue is empty</h3>
                    <p class="text-sm text-muted-foreground max-w-sm mx-auto mb-3">
                        No pull requests are currently waiting to be merged.
                    </p>
                    <p class="text-xs text-muted-foreground font-mono">
                        Add PRs via CLI with <code class="px-1.5 py-0.5 bg-secondary rounded text-foreground font-mono">och queue add &lt;pr&gt;</code>
                    </p>
                </div>
            ) : (
                <div class="divide-y divide-border/60">
                    {queueItems.map((item) => (
                        <div
                            class="group flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 hover:bg-accent/40 transition-colors"
                            data-queue-item={item.id}
                        >
                            <div class="flex items-start sm:items-center gap-3.5 min-w-0">
                                <!-- Position Badge -->
                                <div class="w-6 h-6 rounded-full bg-secondary border border-border flex items-center justify-center text-xs font-bold text-foreground flex-shrink-0">
                                    {item.position}
                                </div>

                                <!-- Status Icon -->
                                <div class="flex-shrink-0">
                                    {item.status === "ready" ? (
                                        <div class="h-6 w-6 rounded-full bg-emerald-500/10 text-emerald-500 flex items-center justify-center border border-emerald-500/20" title="Ready to merge">
                                            <CheckCircle2 className="h-3.5 w-3.5" />
                                        </div>
                                    ) : item.status === "running_ci" ? (
                                        <div class="h-6 w-6 rounded-full bg-blue-500/10 text-blue-400 flex items-center justify-center border border-blue-500/20" title="Running speculative CI">
                                            <Loader2 className="h-3.5 w-3.5 animate-spin" />
                                        </div>
                                    ) : item.status === "failed" ? (
                                        <div class="h-6 w-6 rounded-full bg-red-500/10 text-red-400 flex items-center justify-center border border-red-500/20" title="Merge build failed">
                                            <XCircle className="h-3.5 w-3.5" />
                                        </div>
                                    ) : (
                                        <div class="h-6 w-6 rounded-full bg-amber-500/10 text-amber-400 flex items-center justify-center border border-amber-500/20" title="Pending in queue">
                                            <Clock className="h-3.5 w-3.5" />
                                        </div>
                                    )}
                                </div>

                                <!-- PR Info -->
                                <div class="min-w-0">
                                    <div class="flex items-baseline gap-2 flex-wrap mb-1">
                                        <span class="text-xs text-muted-foreground font-mono">#{item.pr?.number}</span>
                                        <h3 class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors truncate">
                                            {item.pr?.title || "PR"}
                                        </h3>
                                        {item.stackInfo && (
                                            <span class="inline-flex items-center gap-1 px-1.5 py-0.2 rounded text-[11px] bg-purple-500/10 text-purple-400 border border-purple-500/20">
                                                <Layers className="h-3 w-3" />
                                                Stack {item.stackInfo.position}/{item.stackInfo.total}
                                            </span>
                                        )}
                                        <span class="px-1.5 py-0.2 rounded text-[10px] bg-secondary font-mono text-muted-foreground">
                                            {item.mergeMethod}
                                        </span>
                                    </div>

                                    <div class="flex items-center gap-2.5 flex-wrap text-xs text-muted-foreground">
                                        <div class="flex items-center gap-1 font-mono text-[11px] bg-secondary/80 text-foreground px-2 py-0.5 rounded border border-border/50">
                                            <span>{item.pr?.headBranch}</span>
                                            <ArrowRight className="h-2.5 w-2.5 text-muted-foreground" />
                                            <span>{item.pr?.baseBranch}</span>
                                        </div>

                                        {item.pr?.author && (
                                            <>
                                                <span>·</span>
                                                <span>@{item.pr.author.username}</span>
                                            </>
                                        )}

                                        {item.pr?.additions !== undefined && (
                                            <>
                                                <span>·</span>
                                                <span class="text-emerald-500 font-mono">+{item.pr.additions}</span>
                                                <span class="text-red-500 font-mono">-{item.pr.deletions}</span>
                                            </>
                                        )}
                                    </div>
                                </div>
                            </div>

                            <!-- ETA & Action Controls -->
                            <div class="flex items-center gap-4 self-end sm:self-center flex-shrink-0">
                                <div class="text-right">
                                    <div class="text-[10px] uppercase font-bold text-muted-foreground">ETA</div>
                                    <div class="text-xs font-semibold text-foreground font-mono">
                                        {item.estimatedMerge ? formatTime(item.estimatedMerge) : "—"}
                                    </div>
                                </div>

                                <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                                    {item.priority < 10 && (
                                        <button
                                            class="p-1 rounded hover:bg-secondary text-muted-foreground hover:text-foreground transition-colors"
                                            title="Increase priority"
                                            data-action="priority-up"
                                        >
                                            <ArrowUp className="h-3.5 w-3.5" />
                                        </button>
                                    )}
                                    {item.priority > 0 && (
                                        <button
                                            class="p-1 rounded hover:bg-secondary text-muted-foreground hover:text-foreground transition-colors"
                                            title="Decrease priority"
                                            data-action="priority-down"
                                        >
                                            <ArrowDown className="h-3.5 w-3.5" />
                                        </button>
                                    )}
                                    <button
                                        class="p-1 rounded hover:bg-red-500/10 text-muted-foreground hover:text-red-400 transition-colors"
                                        title="Remove from queue"
                                        data-action="remove"
                                    >
                                        <Trash2 className="h-3.5 w-3.5" />
                                    </button>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            )}
        </div>

        <!-- Legend Footer -->
        <div class="flex items-center justify-center gap-6 text-xs text-muted-foreground flex-wrap">
            <div class="flex items-center gap-1.5">
                <Clock className="h-3.5 w-3.5 text-amber-400" />
                <span>Pending</span>
            </div>
            <div class="flex items-center gap-1.5">
                <Loader2 className="h-3.5 w-3.5 text-blue-400" />
                <span>Running CI</span>
            </div>
            <div class="flex items-center gap-1.5">
                <CheckCircle2 className="h-3.5 w-3.5 text-emerald-400" />
                <span>Ready</span>
            </div>
            <div class="flex items-center gap-1.5">
                <GitMerge className="h-3.5 w-3.5 text-purple-400" />
                <span>Merging</span>
            </div>
            <div class="flex items-center gap-1.5">
                <XCircle className="h-3.5 w-3.5 text-red-400" />
                <span>Failed</span>
            </div>
        </div>
    </div>
</BaseLayout>

<script>
    const repoFilter = document.getElementById("repo-filter") as HTMLSelectElement;
    repoFilter?.addEventListener("change", (e) => {
        const repo = (e.target as HTMLSelectElement).value;
        const url = new URL(window.location.href);
        if (repo) {
            url.searchParams.set("repo", repo);
        } else {
            url.searchParams.delete("repo");
        }
        window.location.href = url.toString();
    });

    document.querySelectorAll("[data-queue-item]").forEach((item) => {
        const itemId = item.getAttribute("data-queue-item");

        item.querySelector('[data-action="remove"]')?.addEventListener("click", async (e) => {
            e.stopPropagation();
            if (confirm("Remove this pull request from the merge queue?")) {
                try {
                    const res = await fetch(`/api/merge-queue/${itemId}`, {
                        method: "DELETE",
                    });
                    if (res.ok) window.location.reload();
                } catch (e) {
                    console.error("Failed to remove from queue");
                }
            }
        });

        item.querySelector('[data-action="priority-up"]')?.addEventListener("click", async (e) => {
            e.stopPropagation();
            try {
                const res = await fetch(`/api/merge-queue/${itemId}/priority`, {
                    method: "PATCH",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ direction: "up" }),
                });
                if (res.ok) window.location.reload();
            } catch (e) {
                console.error("Failed to update priority");
            }
        });

        item.querySelector('[data-action="priority-down"]')?.addEventListener("click", async (e) => {
            e.stopPropagation();
            try {
                const res = await fetch(`/api/merge-queue/${itemId}/priority`, {
                    method: "PATCH",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ direction: "down" }),
                });
                if (res.ok) window.location.reload();
            } catch (e) {
                console.error("Failed to update priority");
            }
        });
    });

    setInterval(() => {
        window.location.reload();
    }, 30000);
</script>

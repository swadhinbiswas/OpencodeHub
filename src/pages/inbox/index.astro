---
import Layout from "../../layouts/Layout.astro";
import { KeyboardReviewInbox } from "../../components/inbox/KeyboardReviewInbox";

// Typically we'd fetch the first PR needing review from the DB here
const mockInitialPr = {
  prId: 101,
  title: "Feature: Smart Graph Rebasing",
  diffs: [
    { file: "stack-manager.ts", addition: "+ export function sync() {}", deletion: "- function sync()" },
    { file: "db.ts", addition: "+ table.add('stacks')", deletion: "" }
  ]
};
---

<Layout title="Inbox - OpenCodeHub">
  <main class="h-screen w-full bg-slate-950 overflow-hidden pt-16">
    <!-- React Island loaded instantly for client interaction -->
    <KeyboardReviewInbox client:only="react" initialPr={mockInitialPr} />
  </main>
</Layout>

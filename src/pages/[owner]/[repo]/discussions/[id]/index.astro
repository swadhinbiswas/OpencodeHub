---
import RepoHeader from "@/components/repo/RepoHeader.astro";
import { getDatabase } from "@/db";
import { discussionComments, discussions } from "@/db/schema/discussions";
import { repositories } from "@/db/schema/repositories";
import { users } from "@/db/schema/users";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { renderMarkdown } from "@/lib/markdown";
import { canReadRepo, canWriteRepo } from "@/lib/permissions";
import { and, eq } from "drizzle-orm";
import type { NodePgDatabase } from "drizzle-orm/node-postgres";

const { owner: ownerName, repo: repoName, id } = Astro.params;
const db = getDatabase() as unknown as NodePgDatabase;

// 1. Fetch Repo & Owner
const [ownerUser] = await db
  .select({ id: users.id, username: users.username })
  .from(users)
  .where(eq(users.username, ownerName!))
  .limit(1);

if (!ownerUser) return Astro.redirect("/404");

const [repoData] = await db
  .select()
  .from(repositories)
  .where(
    and(
      eq(repositories.ownerId, ownerUser.id),
      eq(repositories.name, repoName!),
    ),
  )
  .limit(1);

if (!repoData) return Astro.redirect("/404");

const currentUser = Astro.locals.user;
const hasAccess = await canReadRepo(currentUser?.id, repoData);
if (!hasAccess) {
  return Astro.redirect("/404");
}

// 2. Fetch Discussion + author
const [discussion] = await db
  .select()
  .from(discussions)
  .where(
    and(
      eq(discussions.id, id!),
      eq(discussions.repositoryId, repoData.id),
    ),
  )
  .limit(1);

if (!discussion) return Astro.redirect("/404");

const [author] = await db
  .select({ username: users.username, avatarUrl: users.avatarUrl })
  .from(users)
  .where(eq(users.id, discussion.authorId))
  .limit(1);

// 3. Fetch Comments + authors (flat in v1; parentId stored for future threading)
const commentRows = await db
  .select({
    id: discussionComments.id,
    parentId: discussionComments.parentId,
    body: discussionComments.body,
    createdAt: discussionComments.createdAt,
    authorUsername: users.username,
    authorAvatarUrl: users.avatarUrl,
  })
  .from(discussionComments)
  .innerJoin(users, eq(discussionComments.authorId, users.id))
  .where(eq(discussionComments.discussionId, discussion.id))
  .orderBy(discussionComments.createdAt);

const bodyHtml = await renderMarkdown(discussion.body);
const commentsHtml = await Promise.all(
  commentRows.map(async (comment) => ({
    ...comment,
    html: await renderMarkdown(comment.body),
  })),
);

const canModerate = currentUser
  ? discussion.authorId === currentUser.id ||
    (await canWriteRepo(currentUser.id, repoData))
  : false;

function timeAgo(date: Date | null | undefined) {
  if (!date) return "";
  const seconds = Math.floor((Date.now() - new Date(date).getTime()) / 1000);
  const intervals: [number, string][] = [
    [31536000, "y"],
    [2592000, "mo"],
    [86400, "d"],
    [3600, "h"],
    [60, "m"],
  ];
  for (const [secs, unit] of intervals) {
    if (seconds >= secs) return `${Math.floor(seconds / secs)}${unit} ago`;
  }
  return `${seconds}s ago`;
}

const repoForHeader = {
  ...repoData,
  owner: ownerUser.username,
  topics: repoData.topics ? JSON.parse(repoData.topics) : [],
};
---

<BaseLayout title={`${discussion.title} · Discussions · ${ownerName}/${repoName}`}>
  <RepoHeader repo={repoForHeader as any} activeTab="discussions" />

  <div class="container max-w-4xl py-8 space-y-6">
    <!-- Discussion header -->
    <div>
      <h1 class="text-2xl font-semibold">{discussion.title}</h1>
      <div class="flex items-center gap-2 mt-2 flex-wrap text-sm text-muted-foreground">
        <span
          class:list={[
            "px-2 py-0.5 rounded-full text-xs font-semibold",
            "bg-secondary text-secondary-foreground",
          ]}
        >
          {discussion.category}
        </span>
        <span
          class:list={[
            "px-2 py-0.5 rounded-full text-xs font-medium border",
            discussion.closed
              ? "border-red-500/40 text-red-400"
              : "border-green-500/40 text-green-500",
          ]}
        >
          {discussion.closed ? "Closed" : "Open"}
        </span>
        <span>
          <a href={`/${ownerName}`} class="hover:text-foreground hover:underline">{author?.username ?? "unknown"}</a>
          started this discussion {timeAgo(discussion.createdAt)}
        </span>
      </div>

      {
        canModerate && (
          <div class="flex items-center gap-2 mt-4" data-discussion-id={discussion.id}>
            <button
              type="button"
              data-action="toggle-closed"
              data-next={discussion.closed ? "false" : "true"}
              class="px-3 py-1.5 rounded-md border border-border bg-card text-xs font-medium text-foreground hover:bg-accent transition-colors shadow-sm"
            >
              {discussion.closed ? "Reopen discussion" : "Close discussion"}
            </button>
            <button
              type="button"
              data-action="toggle-pinned"
              data-next={discussion.pinned ? "false" : "true"}
              class="px-3 py-1.5 rounded-md border border-border bg-card text-xs font-medium text-foreground hover:bg-accent transition-colors shadow-sm"
            >
              {discussion.pinned ? "Unpin" : "Pin"}
            </button>
          </div>
        )
      }
    </div>

    <!-- Original post -->
    <article class="rounded-md border border-border bg-card overflow-hidden">
      <header class="flex items-center gap-2 px-4 py-2.5 border-b border-border bg-card/60">
        <span class="text-sm font-medium text-foreground">{author?.username ?? "unknown"}</span>
        <span class="text-xs text-muted-foreground">{timeAgo(discussion.createdAt)}</span>
      </header>
      <div class="markdown-body px-4 py-4 text-sm" set:html={bodyHtml} />
    </article>

    <!-- Comments -->
    <section class="space-y-3">
      <h2 class="text-sm font-semibold text-muted-foreground">
        {commentRows.length} {commentRows.length === 1 ? "comment" : "comments"}
      </h2>
      {
        commentsHtml.map((comment) => (
          <article id={`discussion-comment-${comment.id}`} class="rounded-md border border-border bg-card overflow-hidden">
            <header class="flex items-center gap-2 px-4 py-2.5 border-b border-border bg-card/60">
              <span class="text-sm font-medium text-foreground">{comment.authorUsername}</span>
              <span class="text-xs text-muted-foreground">{timeAgo(comment.createdAt)}</span>
            </header>
            <div class="markdown-body px-4 py-4 text-sm" set:html={comment.html} />
          </article>
        ))
      }
    </section>

    <!-- Reply box -->
    {
      currentUser ? (
        <form id="reply-form" class="rounded-md border border-border bg-card p-4 space-y-3">
          <label class="text-sm font-medium">Add a comment</label>
          <textarea
            name="body"
            required
            placeholder="Write a reply…"
            class="min-h-[120px] w-full rounded-md border border-input bg-background px-3 py-2 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-ring"
          />
          <p class="text-xs text-muted-foreground">Markdown is supported.</p>
          <div class="flex justify-end">
            <button
              type="submit"
              id="reply-btn"
              class="px-3.5 py-1.5 rounded-md bg-[#238636] hover:bg-[#2ea043] text-white text-xs sm:text-sm font-medium transition-colors shadow-sm"
            >
              Comment
            </button>
          </div>
        </form>
      ) : (
        <a href={`/login?redirect=${Astro.url.pathname}`} class="block text-center text-sm text-[#58a6ff] hover:underline">
          Sign in to join the conversation
        </a>
      )
    }
  </div>

  <script>
    const pathParts = window.location.pathname.split("/");
    const owner = pathParts[1];
    const repo = pathParts[2];
    const discussionId = pathParts[4];

    const replyForm = document.getElementById("reply-form") as HTMLFormElement | null;
    replyForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById("reply-btn") as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending…";
      }
      try {
        const formData = new FormData(replyForm!);
        const response = await fetch(
          `/api/repos/${owner}/${repo}/discussions/${discussionId}/comments`,
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ body: formData.get("body") }),
          },
        );
        if (!response.ok) {
          const result = await response.json().catch(() => ({}));
          throw new Error(result?.error?.message || result?.message || "Failed to add comment");
        }
        window.location.reload();
      } catch (error) {
        console.error("Error adding comment:", error);
        alert(error instanceof Error ? error.message : "An error occurred");
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Comment";
        }
      }
    });

    document.querySelectorAll<HTMLButtonElement>("[data-action]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        btn.disabled = true;
        const action = btn.dataset.action;
        const nextValue = btn.dataset.next === "true";
        const body =
          action === "toggle-closed" ? { closed: nextValue } : { pinned: nextValue };
        try {
          const response = await fetch(
            `/api/repos/${owner}/${repo}/discussions/${discussionId}`,
            {
              method: "PATCH",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(body),
            },
          );
          if (!response.ok) {
            const result = await response.json().catch(() => ({}));
            throw new Error(result?.error?.message || result?.message || "Failed to update discussion");
          }
          window.location.reload();
        } catch (error) {
          console.error("Error updating discussion:", error);
          alert(error instanceof Error ? error.message : "An error occurred");
          btn.disabled = false;
        }
      });
    });
  </script>
</BaseLayout>

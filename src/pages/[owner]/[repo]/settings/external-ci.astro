---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { getDatabase, schema } from "@/db";
import { eq, and } from "drizzle-orm";
import { canAdminRepo } from "@/lib/permissions";
import RepoHeader from "@/components/repo/RepoHeader.astro";
import { Plug, ShieldCheck } from "lucide-react";

const { owner: ownerName, repo: repoName } = Astro.params;
const db = getDatabase();

const user = await db.query.users.findFirst({
  where: eq(schema.users.username, ownerName!),
});

if (!user) return Astro.redirect("/404");

const repoData = await db.query.repositories.findFirst({
  where: and(
    eq(schema.repositories.ownerId, user.id),
    eq(schema.repositories.name, repoName!),
  ),
  with: { owner: true },
});

if (!repoData) return Astro.redirect("/404");

const currentUser = Astro.locals.user;
const hasAccess = await canAdminRepo(currentUser?.id, repoData, {
  isAdmin: currentUser?.isAdmin ?? undefined,
});

if (!hasAccess) {
  return Astro.redirect(`/${ownerName}/${repoName}`);
}

const integration = await db.query.externalCiIntegrations.findFirst({
  where: eq(schema.externalCiIntegrations.repositoryId, repoData.id),
});
const qualityConfigs = await db.query.codeQualityConfigs.findMany({
  where: eq(schema.codeQualityConfigs.repositoryId, repoData.id),
});
const codecovConfig = qualityConfigs.find((config) => config.provider === "codecov");
const coverallsConfig = qualityConfigs.find((config) => config.provider === "coveralls");
const sonarqubeConfig = qualityConfigs.find((config) => config.provider === "sonarqube");
const snykConfig = qualityConfigs.find((config) => config.provider === "snyk");

const siteUrl = process.env.SITE_URL || "http://localhost:4321";
const endpointUrl = `${siteUrl}/api/repos/${repoData.owner.username}/${repoData.name}/external-ci/checks`;
const codecovWebhookUrl = `${siteUrl}/api/repos/${repoData.owner.username}/${repoData.name}/integrations/code-quality/webhooks/codecov`;
const coverallsWebhookUrl = `${siteUrl}/api/repos/${repoData.owner.username}/${repoData.name}/integrations/code-quality/webhooks/coveralls`;
const sonarqubeWebhookUrl = `${siteUrl}/api/repos/${repoData.owner.username}/${repoData.name}/integrations/code-quality/webhooks/sonarqube`;
const snykWebhookUrl = `${siteUrl}/api/repos/${repoData.owner.username}/${repoData.name}/integrations/code-quality/webhooks/snyk`;

const repo = {
  owner: repoData.owner.username,
  name: repoData.name,
  description: repoData.description,
  visibility: repoData.visibility,
  defaultBranch: repoData.defaultBranch,
  stars: repoData.starCount,
  forks: repoData.forkCount,
  watchers: repoData.watchCount,
  language: repoData.language || "Unknown",
  openIssueCount: repoData.openIssueCount,
  openPrCount: repoData.openPrCount,
  hasIssues: repoData.hasIssues,
  hasWiki: repoData.hasWiki,
  hasActions: repoData.hasActions,
};
---

<BaseLayout title={`External CI · ${repo.owner}/${repo.name}`}>
  <div class="container py-6">
    <RepoHeader repo={repo} activeTab="settings" />

    <div class="grid gap-6 md:grid-cols-[240px_1fr]">
      <nav class="space-y-1">
        <a
          href={`/${repo.owner}/${repo.name}/settings`}
          class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
        >
          General
        </a>
        <a
          href={`/${repo.owner}/${repo.name}/settings/collaborators`}
          class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
        >
          Collaborators
        </a>
        <a
          href={`/${repo.owner}/${repo.name}/settings/webhooks`}
          class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
        >
          Webhooks
        </a>
        <a
          href={`/${repo.owner}/${repo.name}/settings/external-ci`}
          class="flex items-center gap-2 rounded-md bg-muted px-3 py-2 text-sm font-medium text-foreground"
        >
          External CI
        </a>
        <a
          href={`/${repo.owner}/${repo.name}/settings/reviews`}
          class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
        >
          Reviews
        </a>
        <a
          href={`/${repo.owner}/${repo.name}/settings/actions`}
          class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
        >
          Actions
        </a>
        <a
          href={`/${repo.owner}/${repo.name}/settings/deploy-keys`}
          class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
        >
          Deploy keys
        </a>
        <a
          href={`/${repo.owner}/${repo.name}/settings/workflow`}
          class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
        >
          Workflow
        </a>
      </nav>

      <div class="space-y-6">
        <Card>
          <CardHeader>
            <CardTitle className="flex items-center gap-2">
              <Plug className="h-5 w-5" />
              External CI Integration
            </CardTitle>
            <CardDescription>
              Connect third-party CI systems to report status checks on pull requests.
            </CardDescription>
          </CardHeader>
          <CardContent className="space-y-4">
            <div class="rounded-md border border-dashed border-white/10 bg-white/5 p-3 text-sm text-muted-foreground">
              <div class="text-xs uppercase tracking-wide text-muted-foreground">Endpoint</div>
              <div class="mt-1 font-mono text-xs break-all">{endpointUrl}</div>
            </div>

            <div class="rounded-md border border-white/10 bg-white/5 p-3 text-sm text-muted-foreground">
              <div class="flex items-center gap-2 text-sm text-white">
                <ShieldCheck className="h-4 w-4" />
                {integration ? "Token configured" : "No token generated"}
              </div>
              {integration?.lastUsedAt && (
                <div class="text-xs mt-1">Last used: {new Date(integration.lastUsedAt).toLocaleString()}</div>
              )}
            </div>

            <Button id="generate-token" variant="outline">
              {integration ? "Regenerate Token" : "Generate Token"}
            </Button>
            <p id="token-output" class="text-xs text-muted-foreground"></p>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>Payload Format</CardTitle>
            <CardDescription>
              Use the token as a Bearer token or X-OpenCodeHub-Token header. Choose a provider preset to copy a setup-ready payload.
            </CardDescription>
          </CardHeader>
          <CardContent className="space-y-3">
            <div class="flex items-center gap-2">
              <label for="provider-template" class="text-xs text-muted-foreground">Provider preset</label>
              <select id="provider-template" class="h-8 rounded-md border bg-background px-2 text-xs">
                <option value="normalized">Normalized payload</option>
                <option value="github_actions">GitHub Actions (check_run)</option>
                <option value="gitlab">GitLab CI (pipeline/build webhook)</option>
                <option value="circleci">CircleCI (workflow webhook)</option>
                <option value="buildkite">Buildkite (build webhook)</option>
                <option value="jenkins">Jenkins</option>
              </select>
            </div>
            <pre id="payload-template" class="text-xs bg-muted/10 rounded-md p-3 overflow-auto">{`{
  "pullRequestNumber": 42,
  "name": "ci/build",
  "headSha": "abc123...",
  "status": "completed",
  "conclusion": "success",
  "detailsUrl": "https://ci.example.com/build/42"
}`}</pre>
            <div class="text-xs text-muted-foreground">
              Supported ingestion payloads: normalized, github_actions, gitlab, circleci, buildkite, jenkins.
            </div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>Codecov Coverage Automation</CardTitle>
            <CardDescription>
              Configure coverage gating, webhook ingestion, and PR reporting for Codecov.
            </CardDescription>
          </CardHeader>
          <CardContent className="space-y-4">
            <div class="rounded-md border border-dashed border-white/10 bg-white/5 p-3 text-sm text-muted-foreground">
              <div class="text-xs uppercase tracking-wide text-muted-foreground">Codecov Webhook Endpoint</div>
              <div class="mt-1 font-mono text-xs break-all">{codecovWebhookUrl}</div>
            </div>

            <div class="grid gap-3 md:grid-cols-2">
              <div>
                <label for="codecov-project-key" class="block text-xs text-muted-foreground mb-1">Project key</label>
                <input
                  id="codecov-project-key"
                  class="h-8 w-full rounded-md border bg-background px-2 text-xs"
                  placeholder="owner/repo"
                  value={codecovConfig?.projectKey || ""}
                />
              </div>
              <div>
                <label for="codecov-api-token" class="block text-xs text-muted-foreground mb-1">API token</label>
                <input
                  id="codecov-api-token"
                  type="password"
                  class="h-8 w-full rounded-md border bg-background px-2 text-xs"
                  placeholder={codecovConfig ? "•••••••• (leave empty to keep)" : "Codecov token"}
                />
              </div>
            </div>

            <div class="grid gap-3 md:grid-cols-4">
              <div>
                <label for="codecov-min-coverage" class="block text-xs text-muted-foreground mb-1">Min coverage %</label>
                <input
                  id="codecov-min-coverage"
                  type="number"
                  min="0"
                  max="100"
                  step="0.1"
                  class="h-8 w-full rounded-md border bg-background px-2 text-xs"
                  value={codecovConfig?.minCoverage ?? 80}
                />
              </div>
              <label class="flex items-center gap-2 text-xs text-muted-foreground mt-5">
                <input id="codecov-block-on-fail" type="checkbox" checked={!!codecovConfig?.blockOnFail} />
                Block on fail
              </label>
              <label class="flex items-center gap-2 text-xs text-muted-foreground mt-5">
                <input id="codecov-report-on-pr" type="checkbox" checked={codecovConfig?.reportOnPR ?? true} />
                Report on PR
              </label>
              <label class="flex items-center gap-2 text-xs text-muted-foreground mt-5">
                <input id="codecov-enabled" type="checkbox" checked={codecovConfig?.isEnabled ?? true} />
                Enabled
              </label>
            </div>

            <div class="text-xs text-muted-foreground">
              Webhook secret:
              <span id="codecov-webhook-secret" class="font-mono">{codecovConfig?.webhookSecret || "Not configured yet"}</span>
            </div>

            <div class="flex items-center gap-2">
              <Button id="save-codecov" variant="outline">Save Codecov Config</Button>
              <span id="codecov-save-msg" class="text-xs text-muted-foreground"></span>
            </div>

            <div class="pt-2 border-t border-white/10">
              <div class="text-xs font-medium text-muted-foreground mb-2">Recent Codecov Reports</div>
              <div id="codecov-reports" class="space-y-1 text-xs text-muted-foreground">
                Loading coverage reports...
              </div>
            </div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>Coveralls Coverage Automation</CardTitle>
            <CardDescription>
              Configure Coveralls webhook ingestion, PR reporting, and coverage gating.
            </CardDescription>
          </CardHeader>
          <CardContent className="space-y-4">
            <div class="rounded-md border border-dashed border-white/10 bg-white/5 p-3 text-sm text-muted-foreground">
              <div class="text-xs uppercase tracking-wide text-muted-foreground">Coveralls Webhook Endpoint</div>
              <div class="mt-1 font-mono text-xs break-all">{coverallsWebhookUrl}</div>
            </div>
            <div class="grid gap-3 md:grid-cols-2">
              <div>
                <label for="coveralls-project-key" class="block text-xs text-muted-foreground mb-1">Project key</label>
                <input id="coveralls-project-key" class="h-8 w-full rounded-md border bg-background px-2 text-xs" value={coverallsConfig?.projectKey || ""} />
              </div>
              <div>
                <label for="coveralls-api-token" class="block text-xs text-muted-foreground mb-1">API token</label>
                <input id="coveralls-api-token" type="password" class="h-8 w-full rounded-md border bg-background px-2 text-xs" />
              </div>
            </div>
            <div class="grid gap-3 md:grid-cols-4">
              <div>
                <label for="coveralls-min-coverage" class="block text-xs text-muted-foreground mb-1">Min coverage %</label>
                <input id="coveralls-min-coverage" type="number" min="0" max="100" step="0.1" class="h-8 w-full rounded-md border bg-background px-2 text-xs" value={coverallsConfig?.minCoverage ?? 80} />
              </div>
              <label class="flex items-center gap-2 text-xs text-muted-foreground mt-5"><input id="coveralls-block-on-fail" type="checkbox" checked={!!coverallsConfig?.blockOnFail} />Block on fail</label>
              <label class="flex items-center gap-2 text-xs text-muted-foreground mt-5"><input id="coveralls-report-on-pr" type="checkbox" checked={coverallsConfig?.reportOnPR ?? true} />Report on PR</label>
              <label class="flex items-center gap-2 text-xs text-muted-foreground mt-5"><input id="coveralls-enabled" type="checkbox" checked={coverallsConfig?.isEnabled ?? true} />Enabled</label>
            </div>
            <div class="text-xs text-muted-foreground">Webhook secret: <span id="coveralls-webhook-secret" class="font-mono">{coverallsConfig?.webhookSecret || "Not configured yet"}</span></div>
            <div class="flex items-center gap-2">
              <Button id="save-coveralls" variant="outline">Save Coveralls Config</Button>
              <span id="coveralls-save-msg" class="text-xs text-muted-foreground"></span>
            </div>
            <div class="pt-2 border-t border-white/10">
              <div class="text-xs font-medium text-muted-foreground mb-2">Recent Coveralls Reports</div>
              <div id="coveralls-reports" class="space-y-1 text-xs text-muted-foreground">Loading coverage reports...</div>
            </div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>SonarQube Quality Gate Automation</CardTitle>
            <CardDescription>
              Configure SonarQube quality-gate ingestion and issue visibility.
            </CardDescription>
          </CardHeader>
          <CardContent className="space-y-4">
            <div class="rounded-md border border-dashed border-white/10 bg-white/5 p-3 text-sm text-muted-foreground">
              <div class="text-xs uppercase tracking-wide text-muted-foreground">SonarQube Webhook Endpoint</div>
              <div class="mt-1 font-mono text-xs break-all">{sonarqubeWebhookUrl}</div>
            </div>
            <div class="grid gap-3 md:grid-cols-3">
              <div>
                <label for="sonar-project-key" class="block text-xs text-muted-foreground mb-1">Project key</label>
                <input id="sonar-project-key" class="h-8 w-full rounded-md border bg-background px-2 text-xs" value={sonarqubeConfig?.projectKey || ""} />
              </div>
              <div>
                <label for="sonar-server-url" class="block text-xs text-muted-foreground mb-1">Server URL</label>
                <input id="sonar-server-url" class="h-8 w-full rounded-md border bg-background px-2 text-xs" value={sonarqubeConfig?.serverUrl || ""} placeholder="https://sonar.example.com" />
              </div>
              <div>
                <label for="sonar-api-token" class="block text-xs text-muted-foreground mb-1">API token</label>
                <input id="sonar-api-token" type="password" class="h-8 w-full rounded-md border bg-background px-2 text-xs" />
              </div>
            </div>
            <div class="grid gap-3 md:grid-cols-3">
              <label class="flex items-center gap-2 text-xs text-muted-foreground mt-2"><input id="sonar-block-on-fail" type="checkbox" checked={!!sonarqubeConfig?.blockOnFail} />Block on fail</label>
              <label class="flex items-center gap-2 text-xs text-muted-foreground mt-2"><input id="sonar-report-on-pr" type="checkbox" checked={sonarqubeConfig?.reportOnPR ?? true} />Report on PR</label>
              <label class="flex items-center gap-2 text-xs text-muted-foreground mt-2"><input id="sonar-enabled" type="checkbox" checked={sonarqubeConfig?.isEnabled ?? true} />Enabled</label>
            </div>
            <div class="text-xs text-muted-foreground">Webhook secret: <span id="sonar-webhook-secret" class="font-mono">{sonarqubeConfig?.webhookSecret || "Not configured yet"}</span></div>
            <div class="flex items-center gap-2">
              <Button id="save-sonar" variant="outline">Save SonarQube Config</Button>
              <span id="sonar-save-msg" class="text-xs text-muted-foreground"></span>
            </div>
            <div class="pt-2 border-t border-white/10">
              <div class="text-xs font-medium text-muted-foreground mb-2">Recent SonarQube Issues</div>
              <div id="sonar-issues" class="space-y-1 text-xs text-muted-foreground">Loading quality issues...</div>
            </div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>Snyk Security Automation</CardTitle>
            <CardDescription>
              Configure Snyk issue ingestion and PR/security reporting controls.
            </CardDescription>
          </CardHeader>
          <CardContent className="space-y-4">
            <div class="rounded-md border border-dashed border-white/10 bg-white/5 p-3 text-sm text-muted-foreground">
              <div class="text-xs uppercase tracking-wide text-muted-foreground">Snyk Webhook Endpoint</div>
              <div class="mt-1 font-mono text-xs break-all">{snykWebhookUrl}</div>
            </div>
            <div class="grid gap-3 md:grid-cols-2">
              <div>
                <label for="snyk-project-key" class="block text-xs text-muted-foreground mb-1">Project key</label>
                <input id="snyk-project-key" class="h-8 w-full rounded-md border bg-background px-2 text-xs" value={snykConfig?.projectKey || ""} />
              </div>
              <div>
                <label for="snyk-api-token" class="block text-xs text-muted-foreground mb-1">API token</label>
                <input id="snyk-api-token" type="password" class="h-8 w-full rounded-md border bg-background px-2 text-xs" />
              </div>
            </div>
            <div class="grid gap-3 md:grid-cols-3">
              <label class="flex items-center gap-2 text-xs text-muted-foreground mt-2"><input id="snyk-block-on-fail" type="checkbox" checked={!!snykConfig?.blockOnFail} />Block on fail</label>
              <label class="flex items-center gap-2 text-xs text-muted-foreground mt-2"><input id="snyk-report-on-pr" type="checkbox" checked={snykConfig?.reportOnPR ?? true} />Report on PR</label>
              <label class="flex items-center gap-2 text-xs text-muted-foreground mt-2"><input id="snyk-enabled" type="checkbox" checked={snykConfig?.isEnabled ?? true} />Enabled</label>
            </div>
            <div class="text-xs text-muted-foreground">Webhook secret: <span id="snyk-webhook-secret" class="font-mono">{snykConfig?.webhookSecret || "Not configured yet"}</span></div>
            <div class="flex items-center gap-2">
              <Button id="save-snyk" variant="outline">Save Snyk Config</Button>
              <span id="snyk-save-msg" class="text-xs text-muted-foreground"></span>
            </div>
            <div class="pt-2 border-t border-white/10">
              <div class="text-xs font-medium text-muted-foreground mb-2">Recent Snyk Issues</div>
              <div id="snyk-issues" class="space-y-1 text-xs text-muted-foreground">Loading security issues...</div>
            </div>
          </CardContent>
        </Card>
      </div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ repoOwner: repo.owner, repoName: repo.name, initialCodecovConfigId: codecovConfig?.id || null, initialCoverallsConfigId: coverallsConfig?.id || null, initialSonarConfigId: sonarqubeConfig?.id || null, initialSnykConfigId: snykConfig?.id || null }}>
  const btn = document.getElementById("generate-token");
  const output = document.getElementById("token-output");
  const providerTemplate = document.getElementById("provider-template");
  const payloadTemplate = document.getElementById("payload-template");
  const saveCodecovBtn = document.getElementById("save-codecov");
  const codecovSaveMsg = document.getElementById("codecov-save-msg");
  const codecovProjectKey = document.getElementById("codecov-project-key");
  const codecovApiToken = document.getElementById("codecov-api-token");
  const codecovMinCoverage = document.getElementById("codecov-min-coverage");
  const codecovBlockOnFail = document.getElementById("codecov-block-on-fail");
  const codecovReportOnPr = document.getElementById("codecov-report-on-pr");
  const codecovEnabled = document.getElementById("codecov-enabled");
  const codecovWebhookSecret = document.getElementById("codecov-webhook-secret");
  const codecovReports = document.getElementById("codecov-reports");
  let codecovConfigId = initialCodecovConfigId;
  const saveCoverallsBtn = document.getElementById("save-coveralls");
  const coverallsSaveMsg = document.getElementById("coveralls-save-msg");
  const coverallsProjectKey = document.getElementById("coveralls-project-key");
  const coverallsApiToken = document.getElementById("coveralls-api-token");
  const coverallsMinCoverage = document.getElementById("coveralls-min-coverage");
  const coverallsBlockOnFail = document.getElementById("coveralls-block-on-fail");
  const coverallsReportOnPr = document.getElementById("coveralls-report-on-pr");
  const coverallsEnabled = document.getElementById("coveralls-enabled");
  const coverallsWebhookSecret = document.getElementById("coveralls-webhook-secret");
  const coverallsReports = document.getElementById("coveralls-reports");
  let coverallsConfigId = initialCoverallsConfigId;

  const saveSonarBtn = document.getElementById("save-sonar");
  const sonarSaveMsg = document.getElementById("sonar-save-msg");
  const sonarProjectKey = document.getElementById("sonar-project-key");
  const sonarServerUrl = document.getElementById("sonar-server-url");
  const sonarApiToken = document.getElementById("sonar-api-token");
  const sonarBlockOnFail = document.getElementById("sonar-block-on-fail");
  const sonarReportOnPr = document.getElementById("sonar-report-on-pr");
  const sonarEnabled = document.getElementById("sonar-enabled");
  const sonarWebhookSecret = document.getElementById("sonar-webhook-secret");
  const sonarIssues = document.getElementById("sonar-issues");
  let sonarConfigId = initialSonarConfigId;

  const saveSnykBtn = document.getElementById("save-snyk");
  const snykSaveMsg = document.getElementById("snyk-save-msg");
  const snykProjectKey = document.getElementById("snyk-project-key");
  const snykApiToken = document.getElementById("snyk-api-token");
  const snykBlockOnFail = document.getElementById("snyk-block-on-fail");
  const snykReportOnPr = document.getElementById("snyk-report-on-pr");
  const snykEnabled = document.getElementById("snyk-enabled");
  const snykWebhookSecret = document.getElementById("snyk-webhook-secret");
  const snykIssues = document.getElementById("snyk-issues");
  let snykConfigId = initialSnykConfigId;

  const payloadTemplates = {
    normalized: `{
  "pullRequestNumber": 42,
  "name": "ci/build",
  "headSha": "abc123...",
  "status": "completed",
  "conclusion": "success",
  "detailsUrl": "https://ci.example.com/build/42"
}`,
    github_actions: `{
  "check_run": {
    "id": 991,
    "name": "build",
    "head_sha": "abc123...",
    "status": "completed",
    "conclusion": "success",
    "details_url": "https://github.com/acme/app/actions/runs/991",
    "pull_requests": [{ "number": 42 }]
  }
}`,
    gitlab: `{
  "object_kind": "pipeline",
  "object_attributes": {
    "id": 1234,
    "status": "success",
    "sha": "abc123...",
    "url": "https://gitlab.com/acme/app/-/pipelines/1234"
  },
  "merge_request": { "iid": 42 }
}`,
    circleci: `{
  "workflow": {
    "id": "wf-123",
    "name": "build-and-test",
    "status": "success",
    "url": "https://app.circleci.com/pipelines/github/acme/app/123"
  },
  "vcs": {
    "revision": "abc123...",
    "pull_requests": ["https://github.com/acme/app/pull/42"]
  }
}`,
    buildkite: `{
  "build": {
    "id": "bk-123",
    "number": 56,
    "state": "passed",
    "commit": "abc123...",
    "web_url": "https://buildkite.com/acme/app/builds/56",
    "pipeline": { "slug": "app" },
    "pull_request": { "id": 42 }
  }
}`,
    jenkins: `{
  "name": "jenkins/build",
  "status": "SUCCESS",
  "head_sha": "abc123...",
  "details_url": "https://jenkins.example.com/job/app/56/",
  "pull_request": { "number": 42 }
}`,
  };

  function refreshPayloadTemplate() {
    if (!providerTemplate || !payloadTemplate) return;
    const key = providerTemplate.value || "normalized";
    payloadTemplate.textContent = payloadTemplates[key] || payloadTemplates.normalized;
  }

  providerTemplate?.addEventListener("change", refreshPayloadTemplate);
  refreshPayloadTemplate();

  btn?.addEventListener("click", async () => {
    output.textContent = "";
    btn.setAttribute("disabled", "true");
    try {
      const res = await fetch(`/api/repos/${repoOwner}/${repoName}/external-ci`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name: "External CI" }),
      });

      if (!res.ok) {
        output.textContent = "Failed to generate token";
        btn.removeAttribute("disabled");
        return;
      }

      const data = await res.json();
      output.textContent = `Token: ${data?.data?.token || ""}`;
    } catch (e) {
      output.textContent = "Failed to generate token";
    } finally {
      btn.removeAttribute("disabled");
    }
  });

  async function loadQualitySummary() {
    try {
      const res = await fetch(`/api/repos/${repoOwner}/${repoName}/integrations/code-quality?summary=1`);
      const payload = await res.json();
      if (!res.ok) {
        throw new Error(payload?.error?.message || payload?.message || "Failed to load coverage summary");
      }
      const data = payload?.data || payload;
      const codecov = (data?.configs || []).find((cfg) => cfg.provider === "codecov");
      const coveralls = (data?.configs || []).find((cfg) => cfg.provider === "coveralls");
      const sonar = (data?.configs || []).find((cfg) => cfg.provider === "sonarqube");
      const snyk = (data?.configs || []).find((cfg) => cfg.provider === "snyk");
      if (codecov) {
        codecovConfigId = codecov.id;
        if (codecovWebhookSecret) codecovWebhookSecret.textContent = codecov.webhookSecret || "Not configured";
      }
      if (coveralls) {
        coverallsConfigId = coveralls.id;
        if (coverallsWebhookSecret) coverallsWebhookSecret.textContent = coveralls.webhookSecret || "Not configured";
      }
      if (sonar) {
        sonarConfigId = sonar.id;
        if (sonarWebhookSecret) sonarWebhookSecret.textContent = sonar.webhookSecret || "Not configured";
      }
      if (snyk) {
        snykConfigId = snyk.id;
        if (snykWebhookSecret) snykWebhookSecret.textContent = snyk.webhookSecret || "Not configured";
      }

      if (codecovReports) {
        const reports = (data?.coverage || []).filter((report) => report.provider === "codecov").slice(0, 5);
        codecovReports.innerHTML = reports.length === 0
          ? "No Codecov reports received yet."
          : reports.map((report) => `
          <div class="rounded border border-white/10 bg-white/5 px-2 py-1.5 flex items-center justify-between gap-2">
            <span>Coverage ${Number(report.coverage || 0).toFixed(1)}%</span>
            <span class="text-[11px] text-muted-foreground font-mono">${(report.commitSha || "").slice(0, 7)}</span>
          </div>
        `).join("");
      }
      if (coverallsReports) {
        const reports = (data?.coverage || []).filter((report) => report.provider === "coveralls").slice(0, 5);
        coverallsReports.innerHTML = reports.length === 0
          ? "No Coveralls reports received yet."
          : reports.map((report) => `
          <div class="rounded border border-white/10 bg-white/5 px-2 py-1.5 flex items-center justify-between gap-2">
            <span>Coverage ${Number(report.coverage || 0).toFixed(1)}%</span>
            <span class="text-[11px] text-muted-foreground font-mono">${(report.commitSha || "").slice(0, 7)}</span>
          </div>
        `).join("");
      }
      if (sonarIssues) {
        const issues = (data?.issues || []).filter((issue) => issue.provider === "sonarqube").slice(0, 5);
        sonarIssues.innerHTML = issues.length === 0
          ? "No SonarQube issues reported yet."
          : issues.map((issue) => `<div class="rounded border border-white/10 bg-white/5 px-2 py-1.5">${issue.severity || "unknown"} • ${issue.message}</div>`).join("");
      }
      if (snykIssues) {
        const issues = (data?.issues || []).filter((issue) => issue.provider === "snyk").slice(0, 5);
        snykIssues.innerHTML = issues.length === 0
          ? "No Snyk issues reported yet."
          : issues.map((issue) => `<div class="rounded border border-white/10 bg-white/5 px-2 py-1.5">${issue.severity || "unknown"} • ${issue.message}</div>`).join("");
      }
    } catch (error) {
      if (codecovReports) codecovReports.textContent = error.message || "Failed to load coverage summary";
      if (coverallsReports) coverallsReports.textContent = error.message || "Failed to load coverage summary";
      if (sonarIssues) sonarIssues.textContent = error.message || "Failed to load quality issues";
      if (snykIssues) snykIssues.textContent = error.message || "Failed to load security issues";
    }
  }

  saveCodecovBtn?.addEventListener("click", async () => {
    if (!codecovSaveMsg) return;
    saveCodecovBtn.setAttribute("disabled", "true");
    codecovSaveMsg.textContent = "Saving Codecov config...";

    const projectKey = codecovProjectKey?.value?.trim();
    const apiToken = codecovApiToken?.value?.trim();
    const minCoverageNumber = Number.parseFloat(codecovMinCoverage?.value || "0");
    const payload = {
      provider: "codecov",
      ...(projectKey ? { projectKey } : {}),
      ...(apiToken ? { apiToken } : {}),
      minCoverage: Number.isFinite(minCoverageNumber) ? minCoverageNumber : 0,
      blockOnFail: !!codecovBlockOnFail?.checked,
      reportOnPR: !!codecovReportOnPr?.checked,
      isEnabled: !!codecovEnabled?.checked,
    };

    try {
      const res = await fetch(
        codecovConfigId
          ? `/api/repos/${repoOwner}/${repoName}/integrations/code-quality/${codecovConfigId}`
          : `/api/repos/${repoOwner}/${repoName}/integrations/code-quality`,
        {
          method: codecovConfigId ? "PATCH" : "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        },
      );
      const body = await res.json();
      if (!res.ok) {
        throw new Error(body?.error?.message || body?.message || "Failed to save Codecov config");
      }

      const data = body?.data || body;
      if (data?.id) {
        codecovConfigId = data.id;
      }
      if (codecovWebhookSecret && data?.webhookSecret) {
        codecovWebhookSecret.textContent = data.webhookSecret;
      }
      codecovSaveMsg.textContent = "Codecov configuration saved.";
      if (codecovApiToken) codecovApiToken.value = "";
      loadQualitySummary();
    } catch (error) {
      codecovSaveMsg.textContent = error.message || "Failed to save Codecov config";
    } finally {
      saveCodecovBtn.removeAttribute("disabled");
    }
  });
  async function saveProviderConfig(options) {
    const res = await fetch(
      options.configId
        ? `/api/repos/${repoOwner}/${repoName}/integrations/code-quality/${options.configId}`
        : `/api/repos/${repoOwner}/${repoName}/integrations/code-quality`,
      {
        method: options.configId ? "PATCH" : "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(options.payload),
      },
    );
    const body = await res.json();
    if (!res.ok) {
      throw new Error(body?.error?.message || body?.message || "Failed to save provider config");
    }
    return body?.data || body;
  }

  saveCoverallsBtn?.addEventListener("click", async () => {
    if (!coverallsSaveMsg) return;
    coverallsSaveMsg.textContent = "Saving Coveralls config...";
    try {
      const saved = await saveProviderConfig({
        configId: coverallsConfigId,
        payload: {
          provider: "coveralls",
          projectKey: coverallsProjectKey?.value?.trim() || undefined,
          apiToken: coverallsApiToken?.value?.trim() || undefined,
          minCoverage: Number.parseFloat(coverallsMinCoverage?.value || "0") || 0,
          blockOnFail: !!coverallsBlockOnFail?.checked,
          reportOnPR: !!coverallsReportOnPr?.checked,
          isEnabled: !!coverallsEnabled?.checked,
        },
      });
      if (saved?.id) coverallsConfigId = saved.id;
      if (coverallsApiToken) coverallsApiToken.value = "";
      coverallsSaveMsg.textContent = "Coveralls configuration saved.";
      loadQualitySummary();
    } catch (error) {
      coverallsSaveMsg.textContent = error.message || "Failed to save Coveralls config";
    }
  });

  saveSonarBtn?.addEventListener("click", async () => {
    if (!sonarSaveMsg) return;
    sonarSaveMsg.textContent = "Saving SonarQube config...";
    try {
      const saved = await saveProviderConfig({
        configId: sonarConfigId,
        payload: {
          provider: "sonarqube",
          projectKey: sonarProjectKey?.value?.trim() || undefined,
          apiToken: sonarApiToken?.value?.trim() || undefined,
          serverUrl: sonarServerUrl?.value?.trim() || undefined,
          blockOnFail: !!sonarBlockOnFail?.checked,
          reportOnPR: !!sonarReportOnPr?.checked,
          isEnabled: !!sonarEnabled?.checked,
        },
      });
      if (saved?.id) sonarConfigId = saved.id;
      if (sonarApiToken) sonarApiToken.value = "";
      sonarSaveMsg.textContent = "SonarQube configuration saved.";
      loadQualitySummary();
    } catch (error) {
      sonarSaveMsg.textContent = error.message || "Failed to save SonarQube config";
    }
  });

  saveSnykBtn?.addEventListener("click", async () => {
    if (!snykSaveMsg) return;
    snykSaveMsg.textContent = "Saving Snyk config...";
    try {
      const saved = await saveProviderConfig({
        configId: snykConfigId,
        payload: {
          provider: "snyk",
          projectKey: snykProjectKey?.value?.trim() || undefined,
          apiToken: snykApiToken?.value?.trim() || undefined,
          blockOnFail: !!snykBlockOnFail?.checked,
          reportOnPR: !!snykReportOnPr?.checked,
          isEnabled: !!snykEnabled?.checked,
        },
      });
      if (saved?.id) snykConfigId = saved.id;
      if (snykApiToken) snykApiToken.value = "";
      snykSaveMsg.textContent = "Snyk configuration saved.";
      loadQualitySummary();
    } catch (error) {
      snykSaveMsg.textContent = error.message || "Failed to save Snyk config";
    }
  });

  loadQualitySummary();
</script>

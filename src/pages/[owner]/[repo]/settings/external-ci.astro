---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { getDatabase, schema } from "@/db";
import { eq, and } from "drizzle-orm";
import { canAdminRepo } from "@/lib/permissions";
import RepoHeader from "@/components/repo/RepoHeader.astro";
import { Plug, ShieldCheck } from "lucide-react";

const { owner: ownerName, repo: repoName } = Astro.params;
const db = getDatabase();

const user = await db.query.users.findFirst({
  where: eq(schema.users.username, ownerName!),
});

if (!user) return Astro.redirect("/404");

const repoData = await db.query.repositories.findFirst({
  where: and(
    eq(schema.repositories.ownerId, user.id),
    eq(schema.repositories.name, repoName!),
  ),
  with: { owner: true },
});

if (!repoData) return Astro.redirect("/404");

const currentUser = Astro.locals.user;
const hasAccess = await canAdminRepo(currentUser?.id, repoData, {
  isAdmin: currentUser?.isAdmin ?? undefined,
});

if (!hasAccess) {
  return Astro.redirect(`/${ownerName}/${repoName}`);
}

const integration = await db.query.externalCiIntegrations.findFirst({
  where: eq(schema.externalCiIntegrations.repositoryId, repoData.id),
});
const codecovConfig = await db.query.codeQualityConfigs.findFirst({
  where: and(
    eq(schema.codeQualityConfigs.repositoryId, repoData.id),
    eq(schema.codeQualityConfigs.provider, "codecov")
  ),
});

const siteUrl = process.env.SITE_URL || "http://localhost:4321";
const endpointUrl = `${siteUrl}/api/repos/${repoData.owner.username}/${repoData.name}/external-ci/checks`;
const codecovWebhookUrl = `${siteUrl}/api/repos/${repoData.owner.username}/${repoData.name}/integrations/code-quality/webhooks/codecov`;

const repo = {
  owner: repoData.owner.username,
  name: repoData.name,
  description: repoData.description,
  visibility: repoData.visibility,
  defaultBranch: repoData.defaultBranch,
  stars: repoData.starCount,
  forks: repoData.forkCount,
  watchers: repoData.watchCount,
  language: repoData.language || "Unknown",
  openIssueCount: repoData.openIssueCount,
  openPrCount: repoData.openPrCount,
  hasIssues: repoData.hasIssues,
  hasWiki: repoData.hasWiki,
  hasActions: repoData.hasActions,
};
---

<BaseLayout title={`External CI · ${repo.owner}/${repo.name}`}>
  <div class="container py-6">
    <RepoHeader repo={repo} activeTab="settings" />

    <div class="grid gap-6 md:grid-cols-[240px_1fr]">
      <nav class="space-y-1">
        <a
          href={`/${repo.owner}/${repo.name}/settings`}
          class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
        >
          General
        </a>
        <a
          href={`/${repo.owner}/${repo.name}/settings/collaborators`}
          class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
        >
          Collaborators
        </a>
        <a
          href={`/${repo.owner}/${repo.name}/settings/webhooks`}
          class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
        >
          Webhooks
        </a>
        <a
          href={`/${repo.owner}/${repo.name}/settings/external-ci`}
          class="flex items-center gap-2 rounded-md bg-muted px-3 py-2 text-sm font-medium text-foreground"
        >
          External CI
        </a>
        <a
          href={`/${repo.owner}/${repo.name}/settings/reviews`}
          class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
        >
          Reviews
        </a>
        <a
          href={`/${repo.owner}/${repo.name}/settings/actions`}
          class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
        >
          Actions
        </a>
        <a
          href={`/${repo.owner}/${repo.name}/settings/deploy-keys`}
          class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
        >
          Deploy keys
        </a>
        <a
          href={`/${repo.owner}/${repo.name}/settings/workflow`}
          class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
        >
          Workflow
        </a>
      </nav>

      <div class="space-y-6">
        <Card>
          <CardHeader>
            <CardTitle className="flex items-center gap-2">
              <Plug className="h-5 w-5" />
              External CI Integration
            </CardTitle>
            <CardDescription>
              Connect third-party CI systems to report status checks on pull requests.
            </CardDescription>
          </CardHeader>
          <CardContent className="space-y-4">
            <div class="rounded-md border border-dashed border-white/10 bg-white/5 p-3 text-sm text-muted-foreground">
              <div class="text-xs uppercase tracking-wide text-muted-foreground">Endpoint</div>
              <div class="mt-1 font-mono text-xs break-all">{endpointUrl}</div>
            </div>

            <div class="rounded-md border border-white/10 bg-white/5 p-3 text-sm text-muted-foreground">
              <div class="flex items-center gap-2 text-sm text-white">
                <ShieldCheck className="h-4 w-4" />
                {integration ? "Token configured" : "No token generated"}
              </div>
              {integration?.lastUsedAt && (
                <div class="text-xs mt-1">Last used: {new Date(integration.lastUsedAt).toLocaleString()}</div>
              )}
            </div>

            <Button id="generate-token" variant="outline">
              {integration ? "Regenerate Token" : "Generate Token"}
            </Button>
            <p id="token-output" class="text-xs text-muted-foreground"></p>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>Payload Format</CardTitle>
            <CardDescription>
              Use the token as a Bearer token or X-OpenCodeHub-Token header. Choose a provider preset to copy a setup-ready payload.
            </CardDescription>
          </CardHeader>
          <CardContent className="space-y-3">
            <div class="flex items-center gap-2">
              <label for="provider-template" class="text-xs text-muted-foreground">Provider preset</label>
              <select id="provider-template" class="h-8 rounded-md border bg-background px-2 text-xs">
                <option value="normalized">Normalized payload</option>
                <option value="github_actions">GitHub Actions (check_run)</option>
                <option value="gitlab">GitLab CI (pipeline/build webhook)</option>
                <option value="circleci">CircleCI (workflow webhook)</option>
                <option value="buildkite">Buildkite (build webhook)</option>
                <option value="jenkins">Jenkins</option>
              </select>
            </div>
            <pre id="payload-template" class="text-xs bg-muted/10 rounded-md p-3 overflow-auto">{`{
  "pullRequestNumber": 42,
  "name": "ci/build",
  "headSha": "abc123...",
  "status": "completed",
  "conclusion": "success",
  "detailsUrl": "https://ci.example.com/build/42"
}`}</pre>
            <div class="text-xs text-muted-foreground">
              Supported ingestion payloads: normalized, github_actions, gitlab, circleci, buildkite, jenkins.
            </div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>Codecov Coverage Automation</CardTitle>
            <CardDescription>
              Configure coverage gating, webhook ingestion, and PR reporting for Codecov.
            </CardDescription>
          </CardHeader>
          <CardContent className="space-y-4">
            <div class="rounded-md border border-dashed border-white/10 bg-white/5 p-3 text-sm text-muted-foreground">
              <div class="text-xs uppercase tracking-wide text-muted-foreground">Codecov Webhook Endpoint</div>
              <div class="mt-1 font-mono text-xs break-all">{codecovWebhookUrl}</div>
            </div>

            <div class="grid gap-3 md:grid-cols-2">
              <div>
                <label for="codecov-project-key" class="block text-xs text-muted-foreground mb-1">Project key</label>
                <input
                  id="codecov-project-key"
                  class="h-8 w-full rounded-md border bg-background px-2 text-xs"
                  placeholder="owner/repo"
                  value={codecovConfig?.projectKey || ""}
                />
              </div>
              <div>
                <label for="codecov-api-token" class="block text-xs text-muted-foreground mb-1">API token</label>
                <input
                  id="codecov-api-token"
                  type="password"
                  class="h-8 w-full rounded-md border bg-background px-2 text-xs"
                  placeholder={codecovConfig ? "•••••••• (leave empty to keep)" : "Codecov token"}
                />
              </div>
            </div>

            <div class="grid gap-3 md:grid-cols-4">
              <div>
                <label for="codecov-min-coverage" class="block text-xs text-muted-foreground mb-1">Min coverage %</label>
                <input
                  id="codecov-min-coverage"
                  type="number"
                  min="0"
                  max="100"
                  step="0.1"
                  class="h-8 w-full rounded-md border bg-background px-2 text-xs"
                  value={codecovConfig?.minCoverage ?? 80}
                />
              </div>
              <label class="flex items-center gap-2 text-xs text-muted-foreground mt-5">
                <input id="codecov-block-on-fail" type="checkbox" checked={!!codecovConfig?.blockOnFail} />
                Block on fail
              </label>
              <label class="flex items-center gap-2 text-xs text-muted-foreground mt-5">
                <input id="codecov-report-on-pr" type="checkbox" checked={codecovConfig?.reportOnPR ?? true} />
                Report on PR
              </label>
              <label class="flex items-center gap-2 text-xs text-muted-foreground mt-5">
                <input id="codecov-enabled" type="checkbox" checked={codecovConfig?.isEnabled ?? true} />
                Enabled
              </label>
            </div>

            <div class="text-xs text-muted-foreground">
              Webhook secret:
              <span id="codecov-webhook-secret" class="font-mono">{codecovConfig?.webhookSecret || "Not configured yet"}</span>
            </div>

            <div class="flex items-center gap-2">
              <Button id="save-codecov" variant="outline">Save Codecov Config</Button>
              <span id="codecov-save-msg" class="text-xs text-muted-foreground"></span>
            </div>

            <div class="pt-2 border-t border-white/10">
              <div class="text-xs font-medium text-muted-foreground mb-2">Recent Codecov Reports</div>
              <div id="codecov-reports" class="space-y-1 text-xs text-muted-foreground">
                Loading coverage reports...
              </div>
            </div>
          </CardContent>
        </Card>
      </div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ repoOwner: repo.owner, repoName: repo.name, initialCodecovConfigId: codecovConfig?.id || null }}>
  const btn = document.getElementById("generate-token");
  const output = document.getElementById("token-output");
  const providerTemplate = document.getElementById("provider-template");
  const payloadTemplate = document.getElementById("payload-template");
  const saveCodecovBtn = document.getElementById("save-codecov");
  const codecovSaveMsg = document.getElementById("codecov-save-msg");
  const codecovProjectKey = document.getElementById("codecov-project-key");
  const codecovApiToken = document.getElementById("codecov-api-token");
  const codecovMinCoverage = document.getElementById("codecov-min-coverage");
  const codecovBlockOnFail = document.getElementById("codecov-block-on-fail");
  const codecovReportOnPr = document.getElementById("codecov-report-on-pr");
  const codecovEnabled = document.getElementById("codecov-enabled");
  const codecovWebhookSecret = document.getElementById("codecov-webhook-secret");
  const codecovReports = document.getElementById("codecov-reports");
  let codecovConfigId = initialCodecovConfigId;

  const payloadTemplates = {
    normalized: `{
  "pullRequestNumber": 42,
  "name": "ci/build",
  "headSha": "abc123...",
  "status": "completed",
  "conclusion": "success",
  "detailsUrl": "https://ci.example.com/build/42"
}`,
    github_actions: `{
  "check_run": {
    "id": 991,
    "name": "build",
    "head_sha": "abc123...",
    "status": "completed",
    "conclusion": "success",
    "details_url": "https://github.com/acme/app/actions/runs/991",
    "pull_requests": [{ "number": 42 }]
  }
}`,
    gitlab: `{
  "object_kind": "pipeline",
  "object_attributes": {
    "id": 1234,
    "status": "success",
    "sha": "abc123...",
    "url": "https://gitlab.com/acme/app/-/pipelines/1234"
  },
  "merge_request": { "iid": 42 }
}`,
    circleci: `{
  "workflow": {
    "id": "wf-123",
    "name": "build-and-test",
    "status": "success",
    "url": "https://app.circleci.com/pipelines/github/acme/app/123"
  },
  "vcs": {
    "revision": "abc123...",
    "pull_requests": ["https://github.com/acme/app/pull/42"]
  }
}`,
    buildkite: `{
  "build": {
    "id": "bk-123",
    "number": 56,
    "state": "passed",
    "commit": "abc123...",
    "web_url": "https://buildkite.com/acme/app/builds/56",
    "pipeline": { "slug": "app" },
    "pull_request": { "id": 42 }
  }
}`,
    jenkins: `{
  "name": "jenkins/build",
  "status": "SUCCESS",
  "head_sha": "abc123...",
  "details_url": "https://jenkins.example.com/job/app/56/",
  "pull_request": { "number": 42 }
}`,
  };

  function refreshPayloadTemplate() {
    if (!providerTemplate || !payloadTemplate) return;
    const key = providerTemplate.value || "normalized";
    payloadTemplate.textContent = payloadTemplates[key] || payloadTemplates.normalized;
  }

  providerTemplate?.addEventListener("change", refreshPayloadTemplate);
  refreshPayloadTemplate();

  btn?.addEventListener("click", async () => {
    output.textContent = "";
    btn.setAttribute("disabled", "true");
    try {
      const res = await fetch(`/api/repos/${repoOwner}/${repoName}/external-ci`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name: "External CI" }),
      });

      if (!res.ok) {
        output.textContent = "Failed to generate token";
        btn.removeAttribute("disabled");
        return;
      }

      const data = await res.json();
      output.textContent = `Token: ${data?.data?.token || ""}`;
    } catch (e) {
      output.textContent = "Failed to generate token";
    } finally {
      btn.removeAttribute("disabled");
    }
  });

  async function loadCodecovSummary() {
    if (!codecovReports) return;
    try {
      const res = await fetch(`/api/repos/${repoOwner}/${repoName}/integrations/code-quality?summary=1`);
      const payload = await res.json();
      if (!res.ok) {
        throw new Error(payload?.error?.message || payload?.message || "Failed to load coverage summary");
      }
      const data = payload?.data || payload;
      const codecov = (data?.configs || []).find((cfg) => cfg.provider === "codecov");
      if (codecov) {
        codecovConfigId = codecov.id;
        if (codecovWebhookSecret) codecovWebhookSecret.textContent = codecov.webhookSecret || "Not configured";
      }

      const reports = (data?.coverage || []).filter((report) => report.provider === "codecov").slice(0, 5);
      if (reports.length === 0) {
        codecovReports.textContent = "No Codecov reports received yet.";
        return;
      }

      codecovReports.innerHTML = reports.map((report) => `
        <div class="rounded border border-white/10 bg-white/5 px-2 py-1.5 flex items-center justify-between gap-2">
          <span>Coverage ${Number(report.coverage || 0).toFixed(1)}%</span>
          <span class="text-[11px] text-muted-foreground font-mono">${(report.commitSha || "").slice(0, 7)}</span>
        </div>
      `).join("");
    } catch (error) {
      codecovReports.textContent = error.message || "Failed to load coverage summary";
    }
  }

  saveCodecovBtn?.addEventListener("click", async () => {
    if (!codecovSaveMsg) return;
    saveCodecovBtn.setAttribute("disabled", "true");
    codecovSaveMsg.textContent = "Saving Codecov config...";

    const projectKey = codecovProjectKey?.value?.trim();
    const apiToken = codecovApiToken?.value?.trim();
    const minCoverageNumber = Number.parseFloat(codecovMinCoverage?.value || "0");
    const payload = {
      provider: "codecov",
      ...(projectKey ? { projectKey } : {}),
      ...(apiToken ? { apiToken } : {}),
      minCoverage: Number.isFinite(minCoverageNumber) ? minCoverageNumber : 0,
      blockOnFail: !!codecovBlockOnFail?.checked,
      reportOnPR: !!codecovReportOnPr?.checked,
      isEnabled: !!codecovEnabled?.checked,
    };

    try {
      const res = await fetch(
        codecovConfigId
          ? `/api/repos/${repoOwner}/${repoName}/integrations/code-quality/${codecovConfigId}`
          : `/api/repos/${repoOwner}/${repoName}/integrations/code-quality`,
        {
          method: codecovConfigId ? "PATCH" : "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        },
      );
      const body = await res.json();
      if (!res.ok) {
        throw new Error(body?.error?.message || body?.message || "Failed to save Codecov config");
      }

      const data = body?.data || body;
      if (data?.id) {
        codecovConfigId = data.id;
      }
      if (codecovWebhookSecret && data?.webhookSecret) {
        codecovWebhookSecret.textContent = data.webhookSecret;
      }
      codecovSaveMsg.textContent = "Codecov configuration saved.";
      if (codecovApiToken) codecovApiToken.value = "";
      loadCodecovSummary();
    } catch (error) {
      codecovSaveMsg.textContent = error.message || "Failed to save Codecov config";
    } finally {
      saveCodecovBtn.removeAttribute("disabled");
    }
  });

  loadCodecovSummary();
</script>

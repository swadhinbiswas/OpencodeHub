---
import BaseLayout from "@/layouts/BaseLayout.astro";

import { Button } from "@/components/ui/button";
import {
    Card,
    CardContent,
    CardDescription,
    CardHeader,
    CardTitle,
} from "@/components/ui/card";
import { getDatabase, schema } from "@/db";
import { eq, and } from "drizzle-orm";
import { canWriteRepo } from "@/lib/permissions";
import RepoHeader from "@/components/repo/RepoHeader.astro";
import { Server, Terminal, Copy } from "lucide-react";

const { owner: ownerName, repo: repoName } = Astro.params;
const db = getDatabase();

// Fetch Repo & Owner
const user = await db.query.users.findFirst({
    where: eq(schema.users.username, ownerName!),
});

if (!user) return Astro.redirect("/404");

const repoData = await db.query.repositories.findFirst({
    where: and(
        eq(schema.repositories.ownerId, user.id),
        eq(schema.repositories.name, repoName!),
    ),
    with: {
        owner: true,
    },
});

if (!repoData) return Astro.redirect("/404");

// Check permissions
const currentUser = Astro.locals.user;
const hasAccess = await canWriteRepo(currentUser?.id, repoData);

if (!hasAccess) {
    return Astro.redirect(`/${ownerName}/${repoName}`);
}

// Fetch Runners
const runners = await db.query.pipelineRunners.findMany({
    where: eq(schema.pipelineRunners.repositoryId, repoData.id),
});

const serverUrl = Astro.url.origin;

const repo = {
    owner: repoData.owner.username,
    name: repoData.name,
    description: repoData.description,
    visibility: repoData.visibility,
    defaultBranch: repoData.defaultBranch,
    stars: repoData.starCount,
    forks: repoData.forkCount,
    watchers: repoData.watchCount,
    language: repoData.language || "Unknown",
    license: repoData.licenseType || "None",
    topics: repoData.topics ? JSON.parse(repoData.topics) : [],
    updatedAt: repoData.updatedAt,
    openPrCount: repoData.openPrCount,
    openIssueCount: 0, // Placeholder
};
---

<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
></script>

<BaseLayout title={`Runners · ${repo.owner}/${repo.name}`}>
    <div class="container py-6">
        <RepoHeader repo={repo} activeTab="settings" />

        <div class="grid gap-6 md:grid-cols-[240px_1fr]">
            <!-- Settings Sidebar -->
            <nav class="space-y-1">
                <a
                    href={`/${repo.owner}/${repo.name}/settings`}
                    class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
                >
                    General
                </a>
                <a
                    href="#"
                    class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
                >
                    Collaborators
                </a>
                <a
                    href="#"
                    class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground"
                >
                    Webhooks
                </a>
                <a
                    href={`/${repo.owner}/${repo.name}/settings/actions/runners`}
                    class="flex items-center gap-2 rounded-md bg-muted px-3 py-2 text-sm font-medium text-foreground"
                >
                    Actions
                </a>
                <div class="ml-4 border-l pl-4 flex flex-col space-y-1">
                    <a href="#" class="text-sm font-medium text-primary"
                        >Runners</a
                    >
                </div>
            </nav>

            <!-- Content -->
            <div class="space-y-6">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-2xl font-bold tracking-tight">
                            Runners
                        </h2>
                        <p class="text-muted-foreground">
                            Manage self-hosted runners.
                        </p>
                    </div>
                    <Button className="gap-2"> New runner </Button>
                </div>

                <div class="flex justify-end">
                    <Button variant="outline" id="trigger-test-btn">
                        Trigger Test Job
                    </Button>
                </div>

                <Card>
                    <CardHeader>
                        <CardTitle>Self-hosted runners</CardTitle>
                        <CardDescription>
                            Runners currently registered to this repository.
                        </CardDescription>
                    </CardHeader>
                    <CardContent>
                        {
                            runners.length > 0 ? (
                                <div class="space-y-4">
                                    {runners.map((runner) => (
                                        <div class="flex items-center justify-between p-4 border rounded-lg bg-card text-card-foreground shadow-sm">
                                            <div class="flex items-center gap-4">
                                                <div class="relative">
                                                    <div
                                                        class={`p-2.5 rounded-full ${runner.status === "online" ? "bg-green-500/10 text-green-500" : "bg-white/5 text-gray-500"}`}
                                                    >
                                                        <Server className="h-5 w-5" />
                                                    </div>
                                                    {runner.status ===
                                                        "online" && (
                                                        <span class="absolute -top-0.5 -right-0.5 flex h-3 w-3">
                                                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75" />
                                                            <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500 border-2 border-[#0d1117]" />
                                                        </span>
                                                    )}
                                                </div>
                                                <div>
                                                    <div class="font-medium text-white flex items-center gap-2">
                                                        {runner.name}
                                                        <span
                                                            class={`text-[10px] px-2 py-0.5 rounded-full font-medium border ${runner.status === "online" ? "border-green-500/20 bg-green-500/5 text-green-400" : "border-white/10 bg-white/5 text-gray-500"}`}
                                                        >
                                                            {runner.status}
                                                        </span>
                                                    </div>
                                                    <div class="text-xs text-gray-400 mt-1 flex items-center gap-2">
                                                        <span class="px-1.5 py-0.5 rounded bg-white/5 border border-white/5 font-mono text-[10px]">
                                                            {runner.os}
                                                        </span>
                                                        <span class="px-1.5 py-0.5 rounded bg-white/5 border border-white/5 font-mono text-[10px]">
                                                            {runner.arch}
                                                        </span>
                                                        <span>·</span>
                                                        <span>
                                                            Last seen:{" "}
                                                            {runner.lastSeenAt
                                                                ? new Date(
                                                                      runner.lastSeenAt,
                                                                  ).toLocaleString()
                                                                : "Never"}
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div>
                                                <Button
                                                    variant="ghost"
                                                    size="sm"
                                                    className="text-red-500 hover:text-red-600"
                                                >
                                                    Remove
                                                </Button>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            ) : (
                                <div class="text-center py-6 text-muted-foreground">
                                    No runners configured. Add one to run
                                    workflows.
                                </div>
                            )
                        }
                    </CardContent>
                </Card>

                <Card>
                    <CardHeader>
                        <CardTitle>Runner token audit trail</CardTitle>
                        <CardDescription>
                            Recent token issuance, revocation, and consumption events.
                        </CardDescription>
                    </CardHeader>
                    <CardContent>
                        <div id="runner-token-audit-list" class="space-y-2 text-sm text-muted-foreground">
                            Loading audit history...
                        </div>
                    </CardContent>
                </Card>

                {/* Setup Instructions */}

                <div class="space-y-6">
                    <div>
                        <h3 class="text-lg font-medium text-white mb-1">
                            Add a new runner
                        </h3>
                        <p class="text-sm text-gray-400">
                            Configure a self-hosted runner to execute your
                            workflows.
                        </p>
                    </div>

                    <div class="border rounded-xl bg-card overflow-hidden">
                        <div
                            class="flex border-b border-white/5 bg-white/[0.02] p-4"
                        >
                            <h4
                                class="text-sm font-medium text-white flex items-center gap-2"
                            >
                                <Terminal className="h-4 w-4" />
                                CLI Setup
                            </h4>
                        </div>
                        <div
                            class="p-6 bg-slate-950 text-slate-50 font-mono text-sm space-y-4"
                        >
                            <p class="text-gray-400 font-sans">
                                Generate a one-time registration token, then run:
                            </p>
                            <div
                                class="flex flex-wrap gap-2 mb-3"
                            >
                                <Button variant="outline" size="sm" id="generate-token-btn">
                                    Generate One-Time Token
                                </Button>
                                <Button variant="outline" size="sm" id="revoke-token-btn">
                                    Revoke Current Token
                                </Button>
                            </div>
                            <div
                                id="registration-command"
                                class="p-4 rounded-lg bg-white/5 border border-white/10 select-all font-mono text-sm break-all text-gray-400"
                            >
                                Generate a token to see command...
                            </div>
                            <p id="token-expiry" class="text-xs text-gray-500 font-sans"></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>

<script is:inline define:vars={{ repoId: repoData.id, serverUrl }}>
    const triggerBtn = document.getElementById("trigger-test-btn");
    const generateTokenBtn = document.getElementById("generate-token-btn");
    const revokeTokenBtn = document.getElementById("revoke-token-btn");
    const commandEl = document.getElementById("registration-command");
    const tokenExpiryEl = document.getElementById("token-expiry");
    const auditListEl = document.getElementById("runner-token-audit-list");
    let currentTokenId = null;

    function renderAuditEvents(events = []) {
        if (!auditListEl) return;
        if (!events.length) {
            auditListEl.innerHTML = '<div class="text-muted-foreground">No token audit events yet.</div>';
            return;
        }

        auditListEl.innerHTML = events.map((event) => {
            const when = event.createdAt ? new Date(event.createdAt).toLocaleString() : "Unknown time";
            const tokenId = event.tokenId || "unknown";
            const actor = event.actorType === "runner"
                ? `runner ${event.actorId || ""}`.trim()
                : `user ${event.actorId || ""}`.trim();
            const action = event.action?.replace("runner_token_", "") || "event";
            return `
                <div class="rounded border border-white/10 bg-white/5 p-2">
                    <div class="font-medium text-white">${action} • token ${tokenId}</div>
                    <div class="text-xs text-gray-400 mt-1">${when} • ${actor}${event.actorIp ? ` • ${event.actorIp}` : ""}</div>
                </div>
            `;
        }).join("");
    }

    async function loadAuditEvents() {
        if (!auditListEl) return;
        try {
            const res = await fetch(`/api/actions/runners/registration-tokens?repositoryId=${encodeURIComponent(repoId)}`);
            const payload = await res.json();
            if (!res.ok || !payload?.success) {
                throw new Error(payload?.error?.message || "Failed to load audit trail");
            }
            renderAuditEvents(payload.data?.events || []);
        } catch (e) {
            auditListEl.innerHTML = '<div class="text-red-400">Failed to load audit trail.</div>';
        }
    }

    async function generateRegistrationToken() {
        if (!generateTokenBtn || !commandEl) return;
        try {
            generateTokenBtn.disabled = true;
            generateTokenBtn.textContent = "Generating...";

            const res = await fetch("/api/actions/runners/registration-tokens", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ repositoryId: repoId }),
            });
            const payload = await res.json();
            if (!res.ok || !payload?.success) {
                throw new Error(payload?.error?.message || "Failed to generate token");
            }

            const data = payload.data;
            currentTokenId = data.tokenId;
            commandEl.textContent = `och runner config --token ${data.token} --url ${serverUrl}`;
            commandEl.classList.remove("text-gray-400");
            if (tokenExpiryEl) {
                tokenExpiryEl.textContent = `Expires: ${new Date(data.expiresAt).toLocaleString()} (one-time use)`;
            }
            await loadAuditEvents();
        } catch (e) {
            alert("Error: " + e.message);
        } finally {
            generateTokenBtn.disabled = false;
            generateTokenBtn.textContent = "Generate One-Time Token";
        }
    }

    async function revokeRegistrationToken() {
        if (!revokeTokenBtn) return;
        try {
            revokeTokenBtn.disabled = true;
            revokeTokenBtn.textContent = "Revoking...";
            const body = { repositoryId: repoId, ...(currentTokenId ? { tokenId: currentTokenId } : {}) };
            const res = await fetch("/api/actions/runners/registration-tokens", {
                method: "DELETE",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(body),
            });
            if (!res.ok) {
                const err = await res.text();
                throw new Error(err || "Failed to revoke token");
            }
            currentTokenId = null;
            if (commandEl) {
                commandEl.textContent = "Generate a token to see command...";
                commandEl.classList.add("text-gray-400");
            }
            if (tokenExpiryEl) tokenExpiryEl.textContent = "";
            await loadAuditEvents();
        } catch (e) {
            alert("Error: " + e.message);
        } finally {
            revokeTokenBtn.disabled = false;
            revokeTokenBtn.textContent = "Revoke Current Token";
        }
    }

    generateTokenBtn?.addEventListener("click", generateRegistrationToken);
    revokeTokenBtn?.addEventListener("click", revokeRegistrationToken);
    loadAuditEvents();

    triggerBtn?.addEventListener("click", async () => {
        try {
            triggerBtn.disabled = true;
            triggerBtn.textContent = "Triggering...";

            const res = await fetch("/api/actions/trigger-test", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ repositoryId: repoId }),
            });

            if (res.ok) {
                alert("Test job triggered! Check your runner logs.");
            } else {
                const err = await res.text();
                alert("Failed: " + err);
            }
        } catch (e) {
            alert("Error: " + e.message);
        } finally {
            triggerBtn.disabled = false;
            triggerBtn.textContent = "Trigger Test Job";
        }
    });
</script>

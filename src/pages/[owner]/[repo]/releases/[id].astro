---
import BaseLayout from "@/layouts/BaseLayout.astro";
import RepoHeader from "@/components/repo/RepoHeader.astro";
import { getDatabase, schema } from "@/db";
import { eq, and } from "drizzle-orm";
import type { NodePgDatabase } from "drizzle-orm/node-postgres";
import { canReadRepo, canWriteRepo } from "@/lib/permissions";
import { renderMarkdown } from "@/lib/markdown";
import { Tag, Clock, Download, Edit, Trash2, ArrowLeft } from "lucide-react";

const { owner: ownerName, repo: repoName, id: releaseId } = Astro.params;
const db = getDatabase() as NodePgDatabase<typeof schema>;

const user = await db.query.users.findFirst({
  where: eq(schema.users.username, ownerName!),
});
if (!user) return Astro.redirect("/404");

const repoData = await db.query.repositories.findFirst({
  where: and(
    eq(schema.repositories.ownerId, user.id),
    eq(schema.repositories.name, repoName!),
  ),
  with: { owner: true },
});
if (!repoData) return Astro.redirect("/404");

const currentUser = Astro.locals.user;
const hasAccess = await canReadRepo(currentUser?.id, repoData);
if (!hasAccess) return Astro.redirect("/404");

const canWrite = currentUser?.id
  ? await canWriteRepo(currentUser.id, repoData, { isAdmin: currentUser.isAdmin ?? undefined })
  : false;
const canEdit = canWrite;

const release = await db.query.releases?.findFirst?.({
  where: and(
    eq(schema.releases.id, releaseId!),
    eq(schema.releases.repositoryId, repoData.id),
  ),
});

if (!release) return Astro.redirect("/404");
if (release.isDraft && !canWrite) return Astro.redirect("/404");

// Get author
let author: any = null;
if (release.authorId) {
  author = await db.query.users.findFirst({
    where: eq(schema.users.id, release.authorId),
  });
}

// Parse assets
let assets: any[] = [];
try {
  if (release.assets) {
    assets = JSON.parse(release.assets);
  }
} catch {}

// Render body as markdown
let renderedBody = "";
if (release.body) {
  try {
    renderedBody = await renderMarkdown(release.body);
  } catch {
    renderedBody = `<pre>${release.body}</pre>`;
  }
}

function formatDate(date: Date | string | number | null): string {
  if (!date) return "";
  return new Date(date).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

const repo = {
  owner: repoData.owner.username,
  name: repoData.name,
  description: repoData.description,
  visibility: repoData.visibility,
  defaultBranch: repoData.defaultBranch,
  stars: repoData.starCount,
  forks: repoData.forkCount,
  watchers: repoData.watchCount,
  updatedAt: repoData.updatedAt,
  openPrCount: repoData.openPrCount,
  openIssueCount: repoData.openIssueCount,
};
---

<BaseLayout title={`${release.name} · ${repo.owner}/${repo.name}`}>
  <div class="container py-6">
    <RepoHeader repo={repo} activeTab="code" />

    <div class="space-y-6">
      {/* Back link */}
      <a
        href={`/${repo.owner}/${repo.name}/releases`}
        class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground transition-colors"
      >
        <ArrowLeft className="h-4 w-4" />
        Back to releases
      </a>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        {/* Sidebar */}
        <div class="lg:col-span-1 space-y-4 order-2 lg:order-1">
          <div class="space-y-3 text-sm">
            <div class="flex items-center gap-2 text-muted-foreground">
              <Tag className="h-4 w-4" />
              <span class="font-mono">{release.tagId || "untagged"}</span>
            </div>
            {author && (
              <div class="flex items-center gap-2">
                <div class="h-6 w-6 rounded-full bg-muted flex items-center justify-center">
                  <span class="text-xs font-medium">{author.username?.[0]?.toUpperCase()}</span>
                </div>
                <a href={`/${author.username}`} class="hover:text-primary hover:underline">
                  {author.username}
                </a>
              </div>
            )}
            <div class="flex items-center gap-2 text-muted-foreground">
              <Clock className="h-4 w-4" />
              {formatDate(release.publishedAt || release.createdAt)}
            </div>
            {release.downloadCount != null && release.downloadCount > 0 && (
              <div class="flex items-center gap-2 text-muted-foreground">
                <Download className="h-4 w-4" />
                {release.downloadCount} downloads
              </div>
            )}
          </div>

          {canWrite && (
            <div class="flex flex-col gap-2 pt-4 border-t">
              <a
                href={`/${repo.owner}/${repo.name}/releases/${releaseId}/edit`}
                class="inline-flex items-center gap-2 rounded-md border px-3 py-1.5 text-sm hover:bg-accent transition-colors"
              >
                <Edit className="h-3.5 w-3.5" />
                Edit release
              </a>
              <button
                class="inline-flex items-center gap-2 rounded-md border border-red-500/30 px-3 py-1.5 text-sm text-red-500 hover:bg-red-500/10 transition-colors"
                id="delete-release-btn"
              >
                <Trash2 className="h-3.5 w-3.5" />
                Delete release
              </button>
            </div>
          )}
        </div>

        {/* Main content */}
        <div class="lg:col-span-3 order-1 lg:order-2">
          <div class="rounded-lg border bg-card overflow-hidden">
            {/* Release header */}
            <div class="px-6 py-5 border-b">
              <div class="flex items-center gap-3 flex-wrap mb-2">
                <h1 class="text-2xl font-bold">{release.name}</h1>
                {release.isDraft && (
                  <span class="rounded-full bg-yellow-500/10 px-2.5 py-0.5 text-xs font-medium text-yellow-500 border border-yellow-500/30">
                    Draft
                  </span>
                )}
                {release.isPrerelease && (
                  <span class="rounded-full bg-orange-500/10 px-2.5 py-0.5 text-xs font-medium text-orange-500 border border-orange-500/30">
                    Pre-release
                  </span>
                )}
              </div>
            </div>

            {/* Release body */}
            {renderedBody ? (
              <div class="px-6 py-6">
                <article class="prose prose-invert max-w-none" set:html={renderedBody} />
              </div>
            ) : (
              <div class="px-6 py-8 text-center text-muted-foreground text-sm">
                No release notes provided.
              </div>
            )}

            {/* Assets */}
            <div class="border-t px-6 py-4">
              <h3 class="text-sm font-semibold mb-3">Assets</h3>
              {assets.length > 0 ? (
                <div class="space-y-2 mb-4">
                  {assets.map((asset: any) => (
                    <div class="flex items-center justify-between rounded-md border px-4 py-2.5 hover:bg-muted/50 transition-colors">
                      <a
                        href={`/api/repos/${repo.owner}/${repo.name}/releases/${release.id}/assets/${asset.id}`}
                        class="flex items-center gap-2 flex-1 min-w-0"
                      >
                        <Download className="h-4 w-4 text-muted-foreground shrink-0" />
                        <span class="text-sm font-medium truncate">{asset.name}</span>
                      </a>
                      <div class="flex items-center gap-3 shrink-0">
                        <span class="text-xs text-muted-foreground">
                          {(asset.size || 0) > 1024 * 1024
                            ? `${(asset.size / 1024 / 1024).toFixed(1)} MB`
                            : `${Math.max(1, Math.round((asset.size || 0) / 1024))} KB`}
                          {" · "}
                          {(asset.downloadCount || 0)} downloads
                        </span>
                        {canEdit && (
                          <button
                            class="asset-delete text-xs text-red-400 hover:underline"
                            data-asset-id={asset.id}
                            data-asset-name={asset.name}
                          >
                            Delete
                          </button>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <p class="text-sm text-muted-foreground mb-4">No assets attached.</p>
              )}
              {canEdit && (
                <div class="flex items-center gap-2">
                  <input
                    id="asset-file"
                    type="file"
                    class="flex h-9 flex-1 rounded-md border border-input bg-background px-2 py-1 text-sm file:mr-3 file:rounded-md file:border-0 file:bg-secondary file:px-3 file:py-1.5 file:text-sm"
                  />
                  <button
                    id="asset-upload"
                    class="rounded-md bg-cyan-500/90 hover:bg-cyan-500 text-foreground px-4 py-2 text-sm font-medium"
                  >
                    Upload
                  </button>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ releaseId, repoOwner: repo.owner, repoName: repo.name }}>
  const deleteBtn = document.getElementById("delete-release-btn");
  deleteBtn?.addEventListener("click", async () => {
    if (!confirm("Are you sure you want to delete this release?")) return;
    try {
      const res = await fetch(`/api/repos/${repoOwner}/${repoName}/releases/${releaseId}`, {
        method: "DELETE",
      });
      if (res.ok) {
        window.location.href = `/${repoOwner}/${repoName}/releases`;
      } else {
        alert("Failed to delete release");
      }
    } catch (e) {
      alert("Failed to delete release");
    }
  });

  // Asset upload (WS2-15)
  const uploadBtn = document.getElementById("asset-upload");
  uploadBtn?.addEventListener("click", async () => {
    const fileInput = document.getElementById("asset-file");
    const file = fileInput?.files?.[0];
    if (!file) {
      alert("Choose a file first");
      return;
    }
    uploadBtn.disabled = true;
    uploadBtn.textContent = "Uploading...";
    try {
      const formData = new FormData();
      formData.append("file", file);
      const res = await fetch(`/api/repos/${repoOwner}/${repoName}/releases/${releaseId}/assets`, {
        method: "POST",
        body: formData,
      });
      if (!res.ok) throw new Error("Upload failed");
      window.location.reload();
    } catch (e) {
      alert("Failed to upload asset: " + (e instanceof Error ? e.message : String(e)));
      uploadBtn.disabled = false;
      uploadBtn.textContent = "Upload";
    }
  });

  // Asset delete
  document.querySelectorAll(".asset-delete").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const assetId = btn.dataset.assetId;
      const assetName = btn.dataset.assetName;
      if (!confirm(`Delete asset "${assetName}"?`)) return;
      const res = await fetch(
        `/api/repos/${repoOwner}/${repoName}/releases/${releaseId}/assets/${assetId}`,
        { method: "DELETE" },
      );
      if (res.ok) window.location.reload();
      else alert("Failed to delete asset");
    });
  });
</script>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import RepoHeader from "@/components/repo/RepoHeader.astro";
import { getDatabase, schema } from "@/db";
import { eq, and, desc } from "drizzle-orm";
import { canReadRepo, canWriteRepo } from "@/lib/permissions";
import { getTags } from "@/lib/git";
import { resolveRepoPath } from "@/lib/git-storage";
import { Tag, Plus, Package, Clock, Download } from "lucide-react";

const { owner: ownerName, repo: repoName } = Astro.params;
const db = getDatabase();

const user = await db.query.users.findFirst({
  where: eq(schema.users.username, ownerName!),
});
if (!user) return Astro.redirect("/404");

const repoData = await db.query.repositories.findFirst({
  where: and(
    eq(schema.repositories.ownerId, user.id),
    eq(schema.repositories.name, repoName!),
  ),
  with: { owner: true },
});
if (!repoData) return Astro.redirect("/404");

const currentUser = Astro.locals.user;
const hasAccess = await canReadRepo(currentUser?.id, repoData);
if (!hasAccess) return Astro.redirect("/404");

const canWrite = currentUser?.id ? await canWriteRepo(currentUser.id, repoData) : false;

// Get releases from DB
const releases = await (db as any)
  .select()
  .from(schema.releases)
  .where(eq(schema.releases.repositoryId, repoData.id))
  .orderBy(desc(schema.releases.createdAt));

// Filter drafts for non-writers
const visibleReleases = canWrite
  ? releases
  : releases.filter((r: any) => !r.isDraft);

// Get tags from git for display
const resolvedLocalPath = await resolveRepoPath(repoData.diskPath);
const tags = await getTags(resolvedLocalPath);

// Map author IDs to usernames
const authorIds = [...new Set(visibleReleases.map((r: any) => r.authorId).filter(Boolean))];
const authors: Record<string, any> = {};
for (const authorId of authorIds) {
  const u = await db.query.users.findFirst({
    where: eq(schema.users.id, authorId as string),
  });
  if (u) authors[authorId as string] = u;
}

function timeAgo(date: Date | string | number): string {
  if (!date) return "";
  const seconds = Math.floor((new Date().getTime() - new Date(date).getTime()) / 1000);
  if (seconds < 60) return "just now";
  const minutes = Math.floor(seconds / 60);
  if (minutes < 60) return `${minutes} minutes ago`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `${hours} hours ago`;
  const days = Math.floor(hours / 24);
  if (days < 30) return `${days} days ago`;
  const months = Math.floor(days / 30);
  if (months < 12) return `${months} months ago`;
  return `${Math.floor(months / 12)} years ago`;
}

const repo = {
  owner: repoData.owner.username,
  name: repoData.name,
  description: repoData.description,
  visibility: repoData.visibility,
  defaultBranch: repoData.defaultBranch,
  stars: repoData.starCount,
  forks: repoData.forkCount,
  watchers: repoData.watchCount,
  updatedAt: repoData.updatedAt,
  openPrCount: repoData.openPrCount,
  openIssueCount: repoData.openIssueCount,
};
---

<BaseLayout title={`Releases · ${repo.owner}/${repo.name}`}>
  <div class="container py-6">
    <RepoHeader repo={repo} activeTab="code" />

    <div class="space-y-6">
      <!-- Header -->
      <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold flex items-center gap-2">
          <Tag className="h-6 w-6" />
          Releases
        </h1>
        {canWrite && (
          <a
            href={`/${repo.owner}/${repo.name}/releases/new`}
            class="inline-flex items-center gap-2 rounded-md bg-green-600 px-4 py-2 text-sm font-medium text-foreground shadow-sm hover:bg-green-700 transition-colors"
          >
            <Plus className="h-4 w-4" />
            Draft a new release
          </a>
        )}
      </div>

      {visibleReleases.length === 0 ? (
        <div class="rounded-lg border bg-card p-12 text-center">
          <Package className="h-12 w-12 mx-auto text-muted-foreground mb-4" />
          <h2 class="text-lg font-semibold mb-2">No releases yet</h2>
          <p class="text-muted-foreground mb-4">
            Releases are deployable software iterations you can package and provide to users.
          </p>
          {canWrite && (
            <a
              href={`/${repo.owner}/${repo.name}/releases/new`}
              class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90 transition-colors"
            >
              Create a new release
            </a>
          )}
        </div>
      ) : (
        <div class="space-y-0 border-l-2 border-muted ml-4">
          {visibleReleases.map((release: any, idx: number) => {
            const author = authors[release.authorId];
            const isLatest = idx === 0 && !release.isDraft && !release.isPrerelease;
            return (
              <div class="relative pl-8 pb-8">
                {/* Timeline dot */}
                <div class="absolute -left-[9px] top-1 h-4 w-4 rounded-full border-2 border-background bg-primary" />

                <div class="rounded-lg border bg-card overflow-hidden">
                  {/* Release header */}
                  <div class="px-6 py-4 border-b bg-muted/20">
                    <div class="flex items-start justify-between gap-4">
                      <div>
                        <div class="flex items-center gap-3 flex-wrap">
                          <a
                            href={`/${repo.owner}/${repo.name}/releases/${release.id}`}
                            class="text-xl font-bold text-primary hover:underline"
                          >
                            {release.name}
                          </a>
                          {isLatest && (
                            <span class="rounded-full bg-green-500/10 px-2.5 py-0.5 text-xs font-medium text-green-500 border border-green-500/30">
                              Latest
                            </span>
                          )}
                          {release.isDraft && (
                            <span class="rounded-full bg-yellow-500/10 px-2.5 py-0.5 text-xs font-medium text-yellow-500 border border-yellow-500/30">
                              Draft
                            </span>
                          )}
                          {release.isPrerelease && (
                            <span class="rounded-full bg-orange-500/10 px-2.5 py-0.5 text-xs font-medium text-orange-500 border border-orange-500/30">
                              Pre-release
                            </span>
                          )}
                        </div>
                        <div class="flex items-center gap-3 mt-2 text-sm text-muted-foreground">
                          <Tag className="h-3.5 w-3.5" />
                          <span class="font-mono">{release.tagId || "untagged"}</span>
                          {author && (
                            <>
                              <span>·</span>
                              <a href={`/${author.username}`} class="hover:text-primary hover:underline">
                                {author.username}
                              </a>
                            </>
                          )}
                          <span>·</span>
                          <span class="flex items-center gap-1">
                            <Clock className="h-3.5 w-3.5" />
                            {timeAgo(release.publishedAt || release.createdAt)}
                          </span>
                        </div>
                      </div>
                      {release.downloadCount > 0 && (
                        <div class="flex items-center gap-1 text-sm text-muted-foreground shrink-0">
                          <Download className="h-4 w-4" />
                          {release.downloadCount}
                        </div>
                      )}
                    </div>
                  </div>

                  {/* Release body preview */}
                  {release.body && (
                    <div class="px-6 py-4 text-sm text-foreground/80 line-clamp-4 whitespace-pre-wrap">
                      {release.body}
                    </div>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      )}

      {/* Tags section */}
      {tags.length > 0 && (
        <div class="mt-8">
          <h2 class="text-lg font-semibold mb-4 flex items-center gap-2">
            <Tag className="h-5 w-5" />
            Tags ({tags.length})
          </h2>
          <div class="rounded-lg border bg-card divide-y">
            {tags.slice(0, 20).map((tag) => (
              <div class="flex items-center justify-between px-4 py-3 hover:bg-muted/20 transition-colors">
                <div class="flex items-center gap-3">
                  <Tag className="h-4 w-4 text-muted-foreground" />
                  <span class="font-mono text-sm font-medium">{tag.name}</span>
                  {tag.message && (
                    <span class="text-sm text-muted-foreground truncate max-w-[300px]">{tag.message}</span>
                  )}
                </div>
                <span class="text-xs font-mono text-blue-400">{tag.sha.substring(0, 7)}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

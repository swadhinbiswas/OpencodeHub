---
import RepoHeader from "@/components/repo/RepoHeader.astro";
import { Button } from "@/components/ui/button";
import { getDatabase, schema } from "@/db";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { canWriteRepo } from "@/lib/permissions";
import {
  getRepoPath,
  compareBranches,
  getComparePatchDiff,
  type CommitInfo,
  type DiffInfo,
} from "@/lib/git";
import { and, eq, sql, asc, desc, count } from "drizzle-orm";
import {
  GitPullRequest,
  CheckCircle2,
  XCircle,
  GitMerge,
  MessageSquare,
  GitCommit as GitCommitIcon,
  FileText,
  AlertCircle,
  Layers,
  ChevronRight,
  ListOrdered,
  Sparkles,
  RefreshCw,
  Edit2,
} from "lucide-react";
import { InteractiveRebase } from "@/components/git/InteractiveRebase";
import { AIReviewSummary } from "@/components/pulls/AIReviewSummary";
import PRConversation from "@/components/pulls/PRConversation";
import { DiffView } from "@/components/diff/DiffView";
import { InlineDiffReview } from "@/components/pulls/InlineDiffReview";
import { PipelineVisualizer } from "@/components/actions/PipelineVisualizer";
import { CustomPRState } from "@/components/pulls/CustomPRState";
import { CodeOwnersEnforcement } from "@/components/pulls/CodeOwnersEnforcement";

import type { NodePgDatabase } from "drizzle-orm/node-postgres";

const { owner: ownerName, repo: repoName, number } = Astro.params;
const db = getDatabase() as NodePgDatabase<typeof schema>;

const user = Astro.locals.user;

// Fetch Repo & Owner
const repoOwnerUser = await db.query.users.findFirst({
  where: eq(schema.users.username, ownerName!),
});

if (!repoOwnerUser) return Astro.redirect("/404");

const repoData = await db.query.repositories.findFirst({
  where: and(
    eq(schema.repositories.ownerId, repoOwnerUser.id),
    eq(schema.repositories.name, repoName!),
  ),
  with: {
    owner: true,
  },
});

if (!repoData) return Astro.redirect("/404");

// Check permissions
const canWrite = await canWriteRepo(user?.id, repoData);

// Fetch PR
const pr = await db.query.pullRequests.findFirst({
  where: and(
    eq(schema.pullRequests.repositoryId, repoData.id),
    eq(schema.pullRequests.number, parseInt(number!)),
  ),
  with: {
    author: true,
  },
});

if (!pr) return Astro.redirect("/404");

const customStates = await db.query.prStateDefinitions.findMany({
  where: eq(schema.prStateDefinitions.repositoryId, repoData.id),
  orderBy: (states, { asc }) => [asc(states.order)],
});

const currentCustomState = pr.stateId
  ? customStates.find((state) => state.id === pr.stateId) || null
  : null;

// Check Queue Status
const queueItem = await db.query.mergeQueueItems.findFirst({
  where: eq(schema.mergeQueueItems.pullRequestId, pr.id),
});

// Fetch Stack Info
let stackInfo: { baseBranch: string; stackId: string; entries: { order: number; pr: any }[] } | null = null;
try {
  const stackEntry = await db.query.prStackEntries.findFirst({
    where: eq(schema.prStackEntries.pullRequestId, pr.id),
    with: {
      stack: true,
    },
  });

  if (stackEntry) {
    const entries = await db.query.prStackEntries.findMany({
      where: eq(schema.prStackEntries.stackId, stackEntry.stackId),
      orderBy: asc(schema.prStackEntries.stackOrder),
      with: {
        pullRequest: true,
      },
    });

    stackInfo = {
      baseBranch: stackEntry.stack.baseBranch,
      stackId: stackEntry.stackId,
      entries: entries.map((e) => ({
        order: e.stackOrder,
        pr: e.pullRequest,
      })),
    };
  }
} catch (e) {
  console.error("Error fetching stack info:", e);
}

// Fetch open issue count (for header)
const issueCountResult = await db
  .select({ count: count() })
  .from(schema.issues)
  .where(
    and(
      eq(schema.issues.repositoryId, repoData.id),
      eq(schema.issues.state, "open"),
    ),
  );

const openIssueCount = issueCountResult[0]?.count || 0;

const repo = {
  owner: repoData.owner.username,
  name: repoData.name,
  description: repoData.description,
  visibility: repoData.visibility,
  defaultBranch: repoData.defaultBranch,
  stars: repoData.starCount,
  forks: repoData.forkCount,
  watchers: repoData.watchCount,
  language: repoData.language || "Unknown",
  license: repoData.licenseType || "None",
  topics: repoData.topics ? JSON.parse(repoData.topics) : [],
  updatedAt: repoData.updatedAt,
  httpCloneUrl: repoData.httpCloneUrl,
  sshCloneUrl: repoData.sshCloneUrl,
  openIssueCount: openIssueCount,
  openPrCount: repoData.openPrCount,
};

// Fetch Diff Data
let diffData: { commits: CommitInfo[]; diffs: DiffInfo[] } = {
  commits: [],
  diffs: [],
};
let patchDiff = "";

// Fetch Workflow Run for Visualizer
const latestRun = await db.query.workflowRuns.findFirst({
  where: eq(schema.workflowRuns.headSha, pr.headSha),
  orderBy: [desc(schema.workflowRuns.createdAt)],
  with: {
    jobs: true
  }
});

let visualizerJobs: any[] = [];
if (latestRun) {
  visualizerJobs = latestRun.jobs.map(job => ({
    id: job.id,
    name: job.name,
    status: job.status,
    conclusion: job.conclusion,
    needs: job.needs ? JSON.parse(job.needs) : []
  }));
}

let codeOwnersSummary: { path: string; owners: string[] }[] = [];
let uniqueRequiredOwners: string[] = [];

import { resolveRepoPath } from "@/lib/git-storage";
try {
  const repoPath = await resolveRepoPath(
    getRepoPath(repoData.owner.username, repoData.name),
  );
  diffData = await compareBranches(repoPath, pr.baseBranch, pr.headBranch);
  patchDiff = await getComparePatchDiff(repoPath, pr.baseBranch, pr.headBranch);

  const changedFiles = diffData.diffs.map(d => d.file || d.oldPath).filter(Boolean) as string[];
  const { getCodeOwnersSummary } = await import("@/lib/codeowners-enforcement");
  codeOwnersSummary = await getCodeOwnersSummary(repoData.id, changedFiles);
  
  const ownersSet = new Set<string>();
  for (const summary of codeOwnersSummary) {
    for (const owner of summary.owners) {
      ownersSet.add(owner);
    }
  }
  uniqueRequiredOwners = Array.from(ownersSet);
} catch (error) {
  console.error("Error fetching comparison:", error);
}
---

<BaseLayout
  title={`PR #${pr.number}: ${pr.title} · ${repo.owner}/${repo.name}`}
>
  <div class="container py-6">
    <RepoHeader repo={repo} activeTab="pulls" />

    <div class="mb-6">
      <div class="flex items-start justify-between">
        <div>
          <h1 class="text-2xl font-semibold mb-1">
            {pr.title}
            <span class="text-muted-foreground font-light">#{pr.number}</span>
          </h1>
          <div
            class="flex items-center gap-2 text-sm text-muted-foreground mb-4"
          >
            {
              pr.state === "open" && (
                <span class="inline-flex items-center gap-1 rounded-full bg-green-500/10 px-2 py-0.5 text-xs font-medium text-green-500 border border-green-500/20">
                  <GitPullRequest className="h-3 w-3" />
                  Open
                </span>
              )
            }
            {
              currentCustomState && (
                <span
                  class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium border"
                  style={`background-color: ${currentCustomState.color}20; color: ${currentCustomState.color}; border-color: ${currentCustomState.color}55;`}
                >
                  {currentCustomState.displayName}
                </span>
              )
            }
            {
              pr.state === "merged" && (
                <span class="inline-flex items-center gap-1 rounded-full bg-purple-500/10 px-2 py-0.5 text-xs font-medium text-purple-500 border border-purple-500/20">
                  <GitMerge className="h-3 w-3" />
                  Merged
                </span>
              )
            }
            {
              pr.state === "closed" && (
                <span class="inline-flex items-center gap-1 rounded-full bg-red-500/10 px-2 py-0.5 text-xs font-medium text-red-500 border border-red-500/20">
                  <XCircle className="h-3 w-3" />
                  Closed
                </span>
              )
            }

            <span class="font-medium text-foreground">{pr.author.username}</span
            >
            <span
              >wants to merge {diffData.commits.length} commits from <code
                class="bg-muted px-1 rounded">{pr.headBranch}</code
              > into <code class="bg-muted px-1 rounded">{pr.baseBranch}</code
              ></span
            >
          </div>
        </div>
        {canWrite && pr.state !== "merged" && (
          <CustomPRState 
            client:load 
            initialStateId={pr.stateId} 
            customStates={customStates.map(state => ({
              ...state,
              allowMerge: state.allowMerge ?? false,
              requireCodeOwner: state.requireCodeOwner ?? false
            }))} 
            repoOwner={repo.owner} 
            repoName={repo.name} 
            prNumber={pr.number} 
          />
        )}
      </div>

      <div class="grid gap-6 lg:grid-cols-4">
        <div class="lg:col-span-3 space-y-6">
          <AIReviewSummary
            client:load
            owner={repo.owner}
            repo={repo.name}
            prNumber={pr.number}
          />
          {/* Tabs (Simple implementation for MVP) */}
          <div class="border-b">
            <nav class="flex -mb-px space-x-6" aria-label="Tabs">
              <a
                href="#"
                class="border-primary text-primary whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm flex items-center gap-2"
              >
                <MessageSquare className="h-4 w-4" />
                Conversation
              </a>
              <a
                href="#commits"
                class="border-transparent text-muted-foreground hover:text-foreground hover:border-border whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm flex items-center gap-2"
              >
                <GitCommitIcon className="h-4 w-4" />
                Commits
                <span
                  class="bg-muted text-muted-foreground text-xs rounded-full px-2"
                  >{diffData.commits.length}</span
                >
              </a>
              <a
                href="#files"
                class="border-transparent text-muted-foreground hover:text-foreground hover:border-border whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm flex items-center gap-2"
              >
                <FileText className="h-4 w-4" />
                Files changed
                <span
                  class="bg-muted text-muted-foreground text-xs rounded-full px-2"
                  >{diffData.diffs.length}</span
                >
              </a>
            </nav>
          </div>

          {/* Description */}
          {
            pr.body && (
              <div class="border rounded-lg p-4 prose dark:prose-invert max-w-none text-sm">
                {pr.body}
              </div>
            )
          }

          {/* Merge Box */}
          {
            pr.state === "open" && (
              <div class="border rounded-lg bg-muted/10 p-4">
                <div class="flex items-start gap-4">
                  <div class="mt-1">
                    {queueItem ? (
                      <div class="h-8 w-8 rounded-full bg-blue-500 flex items-center justify-center text-white">
                        <ListOrdered className="h-4 w-4 animate-pulse" />
                      </div>
                    ) : (
                      <div class="h-8 w-8 rounded-full bg-green-500 flex items-center justify-center text-white">
                        <GitMerge className="h-4 w-4" />
                      </div>
                    )}
                  </div>
                  <div class="flex-1">
                    <h4 class="font-medium mb-1">
                      {queueItem
                        ? "This PR is in the merge queue"
                        : "This branch has no conflicts with the base branch"}
                    </h4>
                    <p class="text-sm text-muted-foreground mb-4">
                      {queueItem
                        ? `Position: ${queueItem.position || "Pending"} • Status: ${queueItem.status}`
                        : "Merging can be performed automatically."}
                    </p>

                    {canWrite && !queueItem && (
                      <div class="flex items-center gap-2">
                        <Button
                          id="merge-btn"
                          className="bg-green-600 hover:bg-green-700 text-white"
                        >
                          Merge pull request
                        </Button>
                        <Button
                          id="queue-btn"
                          variant="secondary"
                          className="border-primary/20 hover:bg-primary/10 text-primary"
                        >
                          <ListOrdered className="mr-2 h-4 w-4" />
                          Add to merge queue
                        </Button>
                        <Button
                          id="ai-review-btn"
                          variant="outline"
                          className="border-purple-500/20 hover:bg-purple-500/10 text-purple-400"
                        >
                          <Sparkles className="mr-2 h-4 w-4" />
                          Review with AI
                        </Button>
                        <div
                          id="merge-error"
                          class="text-sm text-red-500 hidden font-medium flex items-center gap-1"
                        >
                          <AlertCircle className="h-4 w-4" />
                          <span>Merge failed</span>
                        </div>
                      </div>
                    )}
                    {queueItem && (
                      <div class="flex items-center gap-2">
                        <Button variant="outline" disabled>
                          In Queue
                        </Button>
                        <a
                          href={`/${repo.owner}/${repo.name}/merge-queue`}
                          class="text-sm text-blue-500 hover:underline"
                        >
                          View Queue
                        </a>
                      </div>
                    )}

                    {canWrite && (
                      <div class="mt-4 rounded-md border p-4 space-y-4 bg-background shadow-sm">
                        <div class="flex items-center justify-between">
                          <div class="text-sm font-semibold flex items-center gap-2">
                            <Layers className="h-4 w-4 text-primary" />
                            Auto-merge
                          </div>
                          <div class="flex items-center gap-2">
                            <select
                              id="auto-merge-method"
                              class="h-8 rounded-md border bg-muted/50 px-2 text-xs focus:ring-1 focus:ring-primary"
                            >
                              <option value="merge">Create a merge commit</option>
                              <option value="squash">Squash and merge</option>
                              <option value="rebase">Rebase and merge</option>
                            </select>
                            <button
                              id="auto-merge-toggle"
                              class="h-8 rounded-md bg-primary/10 hover:bg-primary/20 px-3 text-xs font-medium text-primary transition-colors"
                            >
                              Enable auto-merge
                            </button>
                            <button
                              id="auto-merge-refresh"
                              class="h-8 rounded-md hover:bg-muted p-2 text-muted-foreground transition-colors"
                              title="Refresh auto-merge status"
                            >
                              <RefreshCw className="h-3.5 w-3.5" />
                            </button>
                          </div>
                        </div>
                        <div class="text-sm text-muted-foreground">
                          <div id="auto-merge-status" class="flex items-center gap-2">
                            <span class="animate-pulse">Loading auto-merge status...</span>
                          </div>
                          <div id="auto-merge-summary" class="mt-1 text-xs"></div>
                        </div>
                        <div id="auto-merge-blockers" class="space-y-1 text-sm text-amber-600 font-medium"></div>
                        <div id="auto-merge-rules" class="space-y-1 text-xs text-muted-foreground mt-2 border-t pt-2"></div>
                      </div>
                    )}

                    <div class="mt-4 border rounded-md overflow-hidden bg-background shadow-sm">
                      <div class="bg-muted/30 p-3 border-b flex items-center justify-between">
                        <div class="text-sm font-semibold flex items-center gap-2">
                          <CheckCircle2 className="h-4 w-4 text-muted-foreground" id="checks-overall-icon" />
                          Checks
                        </div>
                        <button
                          id="pr-checks-refresh"
                          class="h-6 rounded hover:bg-muted p-1.5 text-muted-foreground transition-colors"
                          title="Refresh checks"
                        >
                          <RefreshCw className="h-3.5 w-3.5" />
                        </button>
                      </div>
                      <div class="p-3 bg-background">
                        {visualizerJobs.length > 0 && (
                          <div class="mb-6">
                            <h3 class="text-sm font-semibold mb-3 flex items-center gap-2">
                              <Sparkles className="h-4 w-4 text-violet-400" />
                              CI/CD Pipeline Execution
                            </h3>
                            <div class="rounded-xl overflow-hidden border border-white/10">
                              <PipelineVisualizer client:idle jobs={visualizerJobs} />
                            </div>
                          </div>
                        )}
                        <div id="pr-checks-summary" class="text-sm text-muted-foreground mb-2">Loading checks...</div>
                        <div id="pr-checks-list" class="space-y-2 text-sm divide-y"></div>
                      </div>
                    </div>

                    <CodeOwnersEnforcement 
                      client:load 
                      repoOwner={repo.owner} 
                      repoName={repo.name} 
                      prNumber={pr.number} 
                    />

                    <div class="mt-4 border rounded-md overflow-hidden bg-background shadow-sm">
                      <div class="bg-muted/30 p-3 border-b flex items-center justify-between">
                        <div class="text-sm font-semibold flex items-center gap-2">
                          <ListOrdered className="h-4 w-4 text-muted-foreground" id="merge-gate-overall-icon" />
                          Merge Gates
                        </div>
                        <button
                          id="merge-readiness-refresh"
                          class="h-6 rounded hover:bg-muted p-1.5 text-muted-foreground transition-colors"
                          title="Refresh merge gates"
                        >
                          <RefreshCw className="h-3.5 w-3.5" />
                        </button>
                      </div>
                      <div class="p-3 bg-background space-y-3">
                        <div id="merge-readiness-summary" class="text-sm font-medium">Loading merge readiness...</div>
                        <div id="merge-readiness-breakdown" class="text-xs text-muted-foreground flex gap-2"></div>
                        <div id="merge-readiness-blockers" class="space-y-1 text-sm text-amber-600 font-medium bg-amber-500/5 p-2 rounded"></div>
                        <div id="merge-readiness-recommendations" class="space-y-1 text-xs text-muted-foreground"></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            )
          }

          {/* Conversation Timeline */}
          <div id="conversation" class="py-4">
            <PRConversation
              client:load
              owner={repo.owner}
              repo={repo.name}
              pullNumber={pr.number}
              currentUser={user
                ? {
                    username: user.username,
                    displayName: user.displayName,
                    avatarUrl: user.avatarUrl,
                  }
                : null}
            />
          </div>

          {/* Commits List (Visible for MVP, ideally tabbed) */}
          <div id="commits" class="space-y-4 pt-4">
            <div class="flex items-center justify-between">
              <h3 class="font-semibold text-lg">Commits</h3>
              {
                canWrite && diffData.commits.length > 0 && (
                  <InteractiveRebase
                    client:load
                    owner={repo.owner}
                    repo={repo.name}
                    prNumber={pr.number}
                    headBranch={pr.headBranch}
                    baseBranch={pr.baseBranch}
                    commits={diffData.commits.map((c) => ({
                      hash: c.sha,
                      message: c.message,
                      author: c.authorName,
                    }))}
                  />
                )
              }
            </div>
            <div class="border rounded-lg divide-y">
              {
                diffData.commits.map((commit) => (
                  <div class="flex items-center gap-3 p-3 text-sm hover:bg-muted/10">
                    <div class="font-mono text-muted-foreground text-xs">
                      {commit.sha.substring(0, 7)}
                    </div>
                    <div class="font-medium flex-1 truncate">
                      {commit.message}
                    </div>
                    <div class="text-muted-foreground text-xs">
                      {commit.authorName}
                    </div>
                    <div class="text-muted-foreground text-xs text-right w-24">
                      {new Date(commit.authorDate).toLocaleDateString()}
                    </div>
                  </div>
                ))
              }
            </div>
          </div>

          {/* File Changes (Visible for MVP, ideally tabbed) */}
          <div id="files" class="space-y-4 pt-4">
            <h3 class="font-semibold text-lg">Files changed</h3>
            {patchDiff ? (
              <InlineDiffReview
                client:load
                rawDiff={patchDiff}
                owner={repo.owner}
                repo={repo.name}
                pullNumber={pr.number}
                repoUrl={`/${repo.owner}/${repo.name}`}
                currentUser={user}
                headSha={diffData.commits.length > 0 ? diffData.commits[diffData.commits.length - 1]?.sha : undefined}
              />
            ) : (
              diffData.diffs.map((diff) => (
                <div class="diff-file-card border rounded-lg overflow-hidden scroll-mt-20">
                  <div class="bg-muted/30 px-4 py-2 border-b text-sm font-mono flex items-center justify-between">
                    <span>{diff.file}</span>
                    <div
                      class="file-approval flex items-center gap-2 text-xs text-muted-foreground"
                      data-file-path={diff.file}
                    >
                      <span>Loading approvals...</span>
                    </div>
                    <span class="text-xs text-muted-foreground">
                      <span class="text-green-600">+{diff.additions}</span>
                      <span class="mx-1">/</span>
                      <span class="text-red-600">-{diff.deletions}</span>
                    </span>
                  </div>
                  <div class="p-4 text-sm text-muted-foreground text-center italic bg-muted/5">
                    {diff.status === "added"
                      ? "New file created"
                      : diff.status === "deleted"
                        ? "File deleted"
                        : "File modified"}
                  </div>
                </div>
              ))
            )}
          </div>
        </div>

        <div class="space-y-6">
          {/* Stack Navigation */}
          {
            stackInfo && stackInfo.entries.length > 1 && (
              <div class="border rounded-lg p-4">
                <div class="flex items-center gap-2 text-sm font-medium text-muted-foreground mb-3">
                  <Layers className="h-4 w-4" />
                  <span>Stacked Changes</span>
                  <span class="text-xs bg-primary/10 text-primary px-1.5 py-0.5 rounded">
                    {stackInfo.entries.length} PRs
                  </span>
                </div>
                <div class="space-y-2">
                  <div class="text-xs text-muted-foreground mb-2 flex items-center gap-1">
                    <GitCommitIcon className="h-4 w-4 text-muted-foreground mt-0.5" />
                    Base:{" "}
                    <code class="bg-muted px-1 py-0.5 rounded">
                      {stackInfo.baseBranch}
                    </code>
                  </div>
                  <div class="relative pl-3 space-y-0 mt-3">
                    {stackInfo.entries.map((entry, index) => {
                      const isCurrent = entry.pr.id === pr.id;
                      const isLast = index === stackInfo.entries.length - 1;

                      return (
                        <div class="relative flex items-start gap-3 pb-3 last:pb-0 group">
                          {/* Connecting Line */}
                          {!isLast && (
                            <div class="absolute left-[5px] top-2.5 bottom-0 w-0.5 bg-border group-hover:bg-primary/20 transition-colors" />
                          )}

                          {/* Dot */}
                          <div
                            class:list={[
                              "relative z-10 w-3 h-3 rounded-full mt-1.5 border-2 transition-colors",
                              isCurrent
                                ? "bg-primary border-primary ring-2 ring-primary/20"
                                : entry.pr.isMerged
                                  ? "bg-green-500 border-green-500"
                                  : entry.pr.state === "closed"
                                    ? "bg-red-500 border-red-500"
                                    : "bg-background border-muted-foreground",
                            ]}
                          />

                          {/* Content */}
                          <div class="flex-1 min-w-0 -mt-0.5">
                            <a
                              href={`/${repo.owner}/${repo.name}/pulls/${entry.pr.number}`}
                              class:list={[
                                "block text-sm transition-colors truncate",
                                isCurrent
                                  ? "font-semibold text-foreground"
                                  : "text-muted-foreground hover:text-foreground",
                              ]}
                            >
                              {entry.pr.title}
                            </a>
                            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                              <span class="font-mono">#{entry.pr.number}</span>
                              {isCurrent && (
                                <span class="text-primary font-medium">
                                  • Current
                                </span>
                              )}
                            </div>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
                {canWrite && (
                  <div class="mt-4 flex flex-wrap items-center gap-2">
                    <Button id="queue-stack-btn" variant="outline" className="text-sm">
                      Add stack to merge queue
                    </Button>
                    <Button id="auto-update-stack-btn" variant="outline" className="text-sm">
                      Auto-update stack
                    </Button>
                    <Button id="rebase-stack-btn" variant="outline" className="text-sm">
                      Rebase stack
                    </Button>
                    <select
                      id="stack-merge-method"
                      class="h-8 rounded-md border bg-background px-2 text-xs"
                    >
                      <option value="merge">Merge</option>
                      <option value="squash">Squash</option>
                      <option value="rebase">Rebase</option>
                    </select>
                    <Button id="merge-stack-btn" variant="outline" className="text-sm">
                      Merge stack
                    </Button>
                    <div id="queue-stack-error" class="text-xs text-red-500 hidden"></div>
                    <div id="rebase-stack-msg" class="text-xs text-muted-foreground hidden"></div>
                  </div>
                )}
                <div id="stack-merge-readiness" class="mt-2 text-xs text-muted-foreground"></div>
                <div id="stack-merge-blockers" class="mt-2 space-y-1 text-xs text-amber-500"></div>
                <div class="mt-4 rounded-md border border-dashed px-3 py-2 text-xs">
                  <div class="flex items-center justify-between">
                    <div class="text-muted-foreground">Stack approvals</div>
                    <button id="stack-approvals-refresh" class="text-xs text-primary hover:underline">
                      Refresh
                    </button>
                  </div>
                  <div id="stack-approvals-status" class="mt-2 text-muted-foreground"></div>
                  <div id="stack-approvals-blockers" class="mt-2 space-y-1 text-xs text-amber-500"></div>
                  <div id="stack-approvals-recommended" class="mt-2 text-xs text-muted-foreground"></div>
                  <div id="stack-approvals-list" class="mt-2 space-y-1"></div>
                  {canWrite && (
                    <div class="mt-3 flex flex-wrap items-center gap-2">
                      <input
                        id="stack-approvals-reviewers"
                        class="h-8 w-48 rounded-md border bg-background px-2 text-xs"
                        placeholder="reviewer usernames"
                      />
                      <button
                        id="stack-approvals-request"
                        class="h-8 rounded-md border border-primary/30 px-3 text-xs text-primary"
                      >
                        Request approvals
                      </button>
                      <button
                        id="stack-approvals-request-recommended"
                        class="h-8 rounded-md border border-emerald-500/40 px-3 text-xs text-emerald-600"
                      >
                        Request recommended
                      </button>
                      <button
                        id="stack-approvals-preview"
                        class="h-8 rounded-md border px-3 text-xs text-muted-foreground"
                      >
                        Preview eligibility
                      </button>
                      <div id="stack-approvals-msg" class="text-xs text-muted-foreground"></div>
                    </div>
                  )}
                </div>
              </div>
            )
          }

          <div class="border-t pt-4 lg:border-t-0 lg:pt-0">
            <div class="text-sm font-medium mb-2 text-muted-foreground">
              Reviewers
            </div>
            {uniqueRequiredOwners.length > 0 ? (
              <div class="flex flex-col gap-2">
                <div class="text-xs text-muted-foreground flex items-center gap-1 mb-1">
                  <AlertCircle className="h-3 w-3" />
                  Required by CODEOWNERS
                </div>
                {uniqueRequiredOwners.map((owner) => (
                  <div class="flex items-center gap-2 text-sm">
                    <div class="h-5 w-5 rounded-full bg-muted flex items-center justify-center text-[10px] font-semibold border">
                      {owner.replace('@', '')[0]?.toUpperCase()}
                    </div>
                    <span class="font-medium text-primary">{owner}</span>
                  </div>
                ))}
              </div>
            ) : (
              <div class="text-sm">No reviewers</div>
            )}
          </div>
          <div>
            <div class="text-sm font-medium mb-2 text-muted-foreground">
              Assignees
            </div>
            <div class="text-sm">No one assigned</div>
          </div>
          <div class="border-t pt-4">
            <div class="text-sm font-medium mb-2 text-muted-foreground">
              Linked Issues
            </div>
            <div id="linked-issues" class="text-sm space-y-2"></div>
            {canWrite && (
              <div class="mt-3 space-y-2">
                <div class="flex items-center gap-2">
                  <input
                    id="link-issue-number"
                    class="h-8 w-24 rounded-md border bg-background px-2 text-sm"
                    placeholder="#123"
                  />
                  <select
                    id="link-issue-type"
                    class="h-8 rounded-md border bg-background px-2 text-sm"
                  >
                    <option value="relates">Relates</option>
                    <option value="closes">Closes</option>
                    <option value="fixes">Fixes</option>
                    <option value="blocks">Blocks</option>
                    <option value="duplicates">Duplicates</option>
                  </select>
                </div>
                <Button id="link-issue-btn" variant="outline" className="w-full">
                  Link Issue
                </Button>
                <div id="link-issue-error" class="text-xs text-red-500 hidden"></div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script
  define:vars={{
    repoOwner: repo.owner,
    repoName: repo.name,
    prNumber: pr.number,
    prId: pr.id,
    canApproveFiles: !!user,
    stackEntries: stackInfo ? stackInfo.entries.map((entry) => ({
      id: entry.pr.id,
      number: entry.pr.number,
      state: entry.pr.state,
      isMerged: entry.pr.isMerged,
      order: entry.order,
    })) : [],
    stackId: stackInfo ? stackInfo.stackId : null,
    currentBuiltinState: pr.state,
    currentCustomStateId: pr.stateId || null,
  }}
>
  const mergeBtn = document.getElementById("merge-btn");
  const queueBtn = document.getElementById("queue-btn");
  const aiReviewBtn = document.getElementById("ai-review-btn");
  const errorDiv = document.getElementById("merge-error");
  const linkedIssuesContainer = document.getElementById("linked-issues");
  const linkIssueBtn = document.getElementById("link-issue-btn");
  const linkIssueNumber = document.getElementById("link-issue-number");
  const linkIssueType = document.getElementById("link-issue-type");
  const linkIssueError = document.getElementById("link-issue-error");
  const queueStackBtn = document.getElementById("queue-stack-btn");
  const queueStackError = document.getElementById("queue-stack-error");
  const autoUpdateStackBtn = document.getElementById("auto-update-stack-btn");
  const rebaseStackBtn = document.getElementById("rebase-stack-btn");
  const mergeStackBtn = document.getElementById("merge-stack-btn");
  const stackMergeMethod = document.getElementById("stack-merge-method");
  const stackMergeReadiness = document.getElementById("stack-merge-readiness");
  const stackMergeBlockers = document.getElementById("stack-merge-blockers");
  const rebaseStackMsg = document.getElementById("rebase-stack-msg");
  const stackApprovalsRefresh = document.getElementById("stack-approvals-refresh");
  const stackApprovalsStatus = document.getElementById("stack-approvals-status");
  const stackApprovalsBlockers = document.getElementById("stack-approvals-blockers");
  const stackApprovalsRecommended = document.getElementById("stack-approvals-recommended");
  const stackApprovalsList = document.getElementById("stack-approvals-list");
  const stackApprovalsReviewers = document.getElementById("stack-approvals-reviewers");
  const stackApprovalsRequest = document.getElementById("stack-approvals-request");
  const stackApprovalsRequestRecommended = document.getElementById("stack-approvals-request-recommended");
  const stackApprovalsPreview = document.getElementById("stack-approvals-preview");
  const stackApprovalsMsg = document.getElementById("stack-approvals-msg");
  const prStateSelect = document.getElementById("pr-state-select");
  const prStateApply = document.getElementById("pr-state-apply");
  const prStateHint = document.getElementById("pr-state-hint");
  const prStateReviewers = document.getElementById("pr-state-reviewers");
  const prStateMsg = document.getElementById("pr-state-msg");
  const autoMergeMethod = document.getElementById("auto-merge-method");
  const autoMergeToggle = document.getElementById("auto-merge-toggle");
  const autoMergeRefresh = document.getElementById("auto-merge-refresh");
  const autoMergeStatus = document.getElementById("auto-merge-status");
  const autoMergeSummary = document.getElementById("auto-merge-summary");
  const autoMergeBlockers = document.getElementById("auto-merge-blockers");
  const autoMergeRules = document.getElementById("auto-merge-rules");
  const prChecksRefresh = document.getElementById("pr-checks-refresh");
  const prChecksSummary = document.getElementById("pr-checks-summary");
  const prChecksList = document.getElementById("pr-checks-list");
  const mergeReadinessRefresh = document.getElementById("merge-readiness-refresh");
  const mergeReadinessSummary = document.getElementById("merge-readiness-summary");
  const mergeReadinessBreakdown = document.getElementById("merge-readiness-breakdown");
  const mergeReadinessBlockers = document.getElementById("merge-readiness-blockers");
  const mergeReadinessRecommendations = document.getElementById("merge-readiness-recommendations");
  let stackApprovalRecommendations = [];

  // Keyboard Shortcuts
  let currentFileIndex = -1;
  const files = document.getElementsByClassName("diff-file-card");

  document.addEventListener("keydown", (e) => {
    // Ignore input fields
    if (
      ["INPUT", "TEXTAREA"].includes(document.activeElement?.tagName) ||
      document.activeElement?.isContentEditable
    ) {
      return;
    }

    if (e.key === "j" || e.key === "k") {
      if (files.length === 0) return;

      if (e.key === "j") {
        currentFileIndex = Math.min(currentFileIndex + 1, files.length - 1);
      } else {
        currentFileIndex = Math.max(currentFileIndex - 1, 0);
      }

      const target = files[currentFileIndex];
      target.scrollIntoView({ behavior: "smooth", block: "start" });

      // Highlight effect
      Array.from(files).forEach((f) =>
        f.classList.remove("ring-2", "ring-primary", "shadow-lg"),
      );
      target.classList.add("ring-2", "ring-primary", "shadow-lg");
    }

    // '[' and ']' to jump specific sections could be added here
  });

  function updatePrStateHint() {
    if (!prStateSelect || !prStateHint) return;
    const value = prStateSelect.value || "";
    if (!value.startsWith("custom:")) {
      prStateHint.textContent = value === "builtin:closed"
        ? "Transition to closed will close this pull request."
        : "Transition to open keeps the pull request active.";
      return;
    }

    const selected = prStateSelect.selectedOptions?.[0];
    const description = selected?.dataset?.description || "";
    const allowMerge = selected?.dataset?.allowMerge === "true";
    const requireCodeOwner = selected?.dataset?.requireCodeowner === "true";
    const flags = [
      allowMerge ? "merge-enabled" : null,
      requireCodeOwner ? "requires code owner approval" : null,
    ].filter(Boolean);

    const parts = [];
    if (description) parts.push(description);
    if (flags.length > 0) parts.push(flags.join(" • "));
    prStateHint.textContent = parts.join(" | ") || "Custom workflow state.";
  }

  async function refreshPrStateReviewerPreview() {
    if (!prStateSelect || !prStateReviewers) return;
    const value = prStateSelect.value || "";
    if (!value.startsWith("custom:")) {
      prStateReviewers.textContent = "Required reviewer policy preview is shown for custom states.";
      return;
    }

    const stateId = value.replace("custom:", "");
    prStateReviewers.textContent = "Loading reviewer policy...";
    try {
      const res = await fetch(
        `/api/repos/${repoOwner}/${repoName}/pulls/${prNumber}/required-reviewers?stateId=${encodeURIComponent(stateId)}`,
      );
      const data = await res.json();
      if (!res.ok) {
        throw new Error(data?.error?.message || data?.message || "Failed to load state reviewer policy");
      }

      const lines = [];
      lines.push(
        `Missing required approvals: ${data?.missingRequired || 0} (${data?.approvedRequired || 0}/${data?.totalRequired || 0})`
      );

      const userMissing = (data?.reviewers || [])
        .filter((reviewer) => !reviewer.approved)
        .map((reviewer) => reviewer.username || reviewer.userId);
      if (userMissing.length > 0) {
        lines.push(`Pending users: ${userMissing.join(", ")}`);
      }

      const teamMissing = (data?.teamRequirements || [])
        .filter((team) => team.missingCount > 0)
        .map((team) => `${team.teamName || team.teamId} (${team.approvedCount}/${team.requiredCount})`);
      if (teamMissing.length > 0) {
        lines.push(`Pending teams: ${teamMissing.join(", ")}`);
      }

      prStateReviewers.textContent = lines.join(" | ") || "No reviewer requirements.";
    } catch (error) {
      prStateReviewers.textContent = error.message || "Failed to load reviewer requirements";
    }
  }

  function getCurrentPrStateSelection() {
    if (currentCustomStateId) return `custom:${currentCustomStateId}`;
    return `builtin:${currentBuiltinState || "open"}`;
  }

  if (prStateSelect) {
    const currentSelection = getCurrentPrStateSelection();
    const hasCurrent = Array.from(prStateSelect.options).some((option) => option.value === currentSelection);
    if (hasCurrent) {
      prStateSelect.value = currentSelection;
    } else {
      prStateSelect.value = currentBuiltinState === "closed" ? "builtin:closed" : "builtin:open";
    }
    updatePrStateHint();
    refreshPrStateReviewerPreview();
    prStateSelect.addEventListener("change", () => {
      updatePrStateHint();
      refreshPrStateReviewerPreview();
    });
  }

  prStateApply?.addEventListener("click", async (event) => {
    event.preventDefault();
    if (!prStateSelect || !prStateMsg) return;

    const targetValue = prStateSelect.value;
    prStateApply.setAttribute("disabled", "true");
    prStateMsg.classList.remove("hidden");
    prStateMsg.textContent = "Applying state transition...";

    try {
      const payload = targetValue.startsWith("custom:")
        ? { stateId: targetValue.replace("custom:", "") }
        : { state: targetValue.replace("builtin:", "") };

      const res = await fetch(
        `/api/repos/${repoOwner}/${repoName}/pulls/${prNumber}/state`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        },
      );
      const data = await res.json();
      if (!res.ok) {
        throw new Error(data?.error?.message || data?.message || "Failed to transition state");
      }

      prStateMsg.textContent = "State transition complete. Reloading...";
      window.location.reload();
    } catch (error) {
      prStateMsg.classList.add("text-red-500");
      prStateMsg.textContent = error.message || "Failed to transition state";
    } finally {
      prStateApply.removeAttribute("disabled");
    }
  });

  function setAutoMergeControlsBusy(busy) {
    if (autoMergeToggle) {
      if (busy) autoMergeToggle.setAttribute("disabled", "true");
      else autoMergeToggle.removeAttribute("disabled");
    }
    if (autoMergeRefresh) {
      if (busy) autoMergeRefresh.setAttribute("disabled", "true");
      else autoMergeRefresh.removeAttribute("disabled");
    }
    if (autoMergeMethod) {
      if (busy) autoMergeMethod.setAttribute("disabled", "true");
      else autoMergeMethod.removeAttribute("disabled");
    }
  }

  function renderAutoMergeStatus(status) {
    if (!autoMergeToggle || !autoMergeStatus || !autoMergeSummary) return;

    const enabled = !!status?.enabled;
    const eligible = !!status?.eligibleToMerge;
    const blockers = status?.blockers || [];
    const summary = status?.policySummary;
    const evaluations = status?.ruleEvaluations || [];

    autoMergeToggle.textContent = enabled ? "Disable auto-merge" : "Enable auto-merge";
    autoMergeToggle.className = enabled 
       ? "h-8 rounded-md bg-muted hover:bg-muted/80 px-3 text-xs font-medium text-foreground transition-colors"
       : "h-8 rounded-md bg-primary/10 hover:bg-primary/20 px-3 text-xs font-medium text-primary transition-colors";

    autoMergeStatus.innerHTML = enabled
      ? eligible
        ? `<span class="text-green-600 flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-green-500"></span> Auto-merge enabled and currently merge-ready</span>`
        : `<span class="text-amber-600 flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-amber-500"></span> Auto-merge enabled but waiting for policy</span>`
      : `<span class="text-muted-foreground flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-muted-foreground/30"></span> Auto-merge is disabled</span>`;

    if (status?.enabledBy || status?.enabledAt) {
      const enabledBy = status?.enabledBy ? `by ${status.enabledBy}` : "by unknown user";
      const enabledAt = status?.enabledAt ? ` at ${new Date(status.enabledAt).toLocaleString()}` : "";
      autoMergeSummary.textContent = `Enabled ${enabledBy}${enabledAt}. `;
    } else {
      autoMergeSummary.textContent = "";
    }

    if (!summary || summary.totalRules === 0) {
      autoMergeSummary.textContent += "No repository auto-merge rules configured.";
    } else {
      autoMergeSummary.textContent += `Rules: ${summary.passedRules}/${summary.totalRules} passing • failed ${summary.failedRules} • unmatched ${summary.unmatchedRules}`;
    }

    if (autoMergeBlockers) {
      autoMergeBlockers.innerHTML = blockers.map((blocker) => `<div class="flex items-start gap-2 bg-amber-50 p-2 rounded text-amber-700 border border-amber-100">
         <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
         <span>${blocker}</span>
      </div>`).join("");
    }

    if (autoMergeRules) {
      if (evaluations.length === 0) {
        autoMergeRules.innerHTML = "";
      } else {
        autoMergeRules.innerHTML = `<div class="font-medium text-foreground mb-1 text-sm">Rule Evaluations</div>` + evaluations.map((rule) => {
          const state = !rule.matched ? "not matched" : rule.passed ? "passing" : "failing";
          const stateColor = !rule.matched ? "text-muted-foreground" : rule.passed ? "text-green-600" : "text-amber-600";
          const reasons = (rule.reasons || []).length > 0
            ? `<div class="text-xs text-muted-foreground mt-0.5 pl-4">${rule.reasons.join(" | ")}</div>`
            : "";
          return `<div class="py-1"><div class="flex items-center justify-between gap-2"><span class="font-medium text-sm">${rule.name}</span> <span class="${stateColor}">${state}</span></div>${reasons}</div>`;
        }).join("");
      }
    }
  }

  async function loadAutoMergeStatus() {
    if (!autoMergeStatus) return;
    autoMergeStatus.textContent = "Loading auto-merge status...";

    try {
      const res = await fetch(
        `/api/repos/${repoOwner}/${repoName}/pulls/${prNumber}/auto-merge`,
      );
      const payload = await res.json();
      if (!res.ok) {
        throw new Error(payload?.error?.message || payload?.message || "Failed to load auto-merge status");
      }

      renderAutoMergeStatus(payload?.data || payload);
    } catch (error) {
      autoMergeStatus.textContent = error.message || "Failed to load auto-merge status";
      if (autoMergeSummary) autoMergeSummary.textContent = "";
      if (autoMergeBlockers) autoMergeBlockers.innerHTML = "";
      if (autoMergeRules) autoMergeRules.innerHTML = "";
    }
  }

  autoMergeRefresh?.addEventListener("click", async (event) => {
    event.preventDefault();
    loadAutoMergeStatus();
  });

  autoMergeToggle?.addEventListener("click", async (event) => {
    event.preventDefault();
    if (!autoMergeToggle) return;

    const disabling = autoMergeToggle.textContent?.toLowerCase().includes("disable");
    setAutoMergeControlsBusy(true);
    if (autoMergeStatus) {
      autoMergeStatus.textContent = disabling
        ? "Disabling auto-merge..."
        : "Enabling auto-merge...";
    }

    try {
      const res = await fetch(
        `/api/repos/${repoOwner}/${repoName}/pulls/${prNumber}/auto-merge`,
        disabling
          ? { method: "DELETE" }
          : {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ mergeMethod: autoMergeMethod?.value || "merge" }),
            },
      );
      const payload = await res.json();
      if (!res.ok) {
        throw new Error(payload?.error?.message || payload?.message || "Failed to update auto-merge");
      }

      renderAutoMergeStatus(payload?.data || payload);
    } catch (error) {
      if (autoMergeStatus) {
        autoMergeStatus.textContent = error.message || "Failed to update auto-merge";
      }
    } finally {
      setAutoMergeControlsBusy(false);
    }
  });

  function formatCheckState(check) {
    if (check.status !== "completed") return "pending";
    if (check.conclusion === "success") return "passed";
    if (check.conclusion === "neutral") return "neutral";
    if (check.conclusion === "cancelled") return "cancelled";
    return "failed";
  }

  function checkStateClass(state) {
    if (state === "passed") return "text-green-500";
    if (state === "pending") return "text-amber-500";
    if (state === "neutral") return "text-muted-foreground";
    if (state === "cancelled") return "text-muted-foreground";
    return "text-red-500";
  }

  async function loadPrChecks() {
    if (!prChecksSummary || !prChecksList) return;
    prChecksSummary.textContent = "Loading checks...";
    prChecksList.innerHTML = "";

    try {
      const res = await fetch(`/api/repos/${repoOwner}/${repoName}/pulls/${prNumber}/checks`);
      const payload = await res.json();
      if (!res.ok) {
        throw new Error(payload?.error?.message || payload?.message || "Failed to load checks");
      }

      const data = payload?.data || payload;
      const summary = data?.summary || {};
      const checks = data?.checks || [];

      if (checks.length > 0 && summary.failed > 0) {
        document.getElementById("checks-overall-icon")?.classList.replace("text-muted-foreground", "text-red-500");
      } else if (checks.length > 0 && summary.pending === 0 && summary.failed === 0) {
        document.getElementById("checks-overall-icon")?.classList.replace("text-muted-foreground", "text-green-500");
      }

      prChecksSummary.innerHTML =
        `<span class="font-medium text-foreground">Passed ${summary.passed || 0}/${summary.total || 0}</span> <span class="mx-2 text-muted">|</span> <span class="text-red-500">Failed ${summary.failed || 0}</span> <span class="mx-2 text-muted">|</span> <span class="text-amber-500">Pending ${summary.pending || 0}</span>`;

      if (checks.length === 0) {
        prChecksList.innerHTML = `<div class="p-4 text-center text-muted-foreground">No checks reported yet.</div>`;
        return;
      }

      prChecksList.innerHTML = checks
        .map((check) => {
          const state = formatCheckState(check);
          const icon = state === "passed" ? "✓" : state === "failed" ? "✕" : "○";
          const label = `<span class="font-medium">${check.name}</span> <span class="text-muted-foreground ml-2">— ${state}</span>`;
          const link = check.detailsUrl
            ? `<a href="${check.detailsUrl}" target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-2">${label}</a>`
            : `<div class="flex items-center gap-2">${label}</div>`;
          return `<div class="flex items-center justify-between py-2.5">
            <div class="flex items-center gap-3">
              <span class="${checkStateClass(state)} font-bold w-4 text-center">${icon}</span>
              ${link}
            </div>
            <span class="text-xs font-mono text-muted-foreground bg-muted/30 px-2 py-0.5 rounded">${check.headSha?.slice(0, 7) || ""}</span>
          </div>`;
        })
        .join("");
    } catch (error) {
      prChecksSummary.textContent = error.message || "Failed to load checks";
      prChecksList.innerHTML = "";
    }
  }

  prChecksRefresh?.addEventListener("click", async (event) => {
    event.preventDefault();
    loadPrChecks();
  });



  async function loadMergeReadiness() {
    if (!mergeReadinessSummary || !mergeReadinessBreakdown) return;
    mergeReadinessSummary.textContent = "Loading merge readiness...";
    mergeReadinessBreakdown.textContent = "";
    if (mergeReadinessBlockers) mergeReadinessBlockers.innerHTML = "";
    if (mergeReadinessRecommendations) mergeReadinessRecommendations.innerHTML = "";

    try {
      const res = await fetch(
        `/api/repos/${repoOwner}/${repoName}/pulls/${prNumber}/merge-readiness`,
      );
      const payload = await res.json();
      if (!res.ok) {
        throw new Error(payload?.error?.message || payload?.message || "Failed to load merge readiness");
      }

      const data = payload?.data || payload;
      const report = data?.policyReport || {};
      const canMerge = !!data?.canMerge;
      const blockers = data?.blockers || [];
      const failedByType = report?.failedByType || {};
      const recommendations = report?.recommendations || [];

      const overallIcon = document.getElementById("merge-gate-overall-icon");
      if (overallIcon) {
         if (canMerge) {
             overallIcon.classList.replace("text-muted-foreground", "text-green-500");
         } else {
             overallIcon.classList.replace("text-muted-foreground", "text-red-500");
         }
      }

      mergeReadinessSummary.innerHTML = canMerge
        ? `<span class="text-green-600 flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-green-500"></span> All merge gates are currently satisfied.</span>`
        : `<span class="text-red-600 flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-red-500"></span> Merge is currently blocked by one or more gates.</span>`;
      
      mergeReadinessBreakdown.innerHTML =
        `<span class="bg-green-100 text-green-700 px-2 py-0.5 rounded border border-green-200">Passed ${report?.passedGates || 0}/${report?.totalGates || 0}</span> 
         <span class="${report?.failedGates > 0 ? "bg-red-100 text-red-700 border-red-200" : "bg-muted text-muted-foreground border-transparent"} px-2 py-0.5 rounded border">Failed ${report?.failedGates || 0}</span>`;

      if (mergeReadinessBlockers && blockers.length > 0) {
        mergeReadinessBlockers.innerHTML = blockers.map((blocker) => `<div class="flex items-start gap-2">
          <span class="text-amber-500 mt-0.5 text-lg leading-none">•</span>
          <span>${blocker}</span>
        </div>`).join("");
      } else if (mergeReadinessBlockers) {
        mergeReadinessBlockers.innerHTML = "";
        mergeReadinessBlockers.classList.remove("bg-amber-500/5", "p-2", "rounded");
      }

      if (mergeReadinessRecommendations) {
        const typeParts = Object.entries(failedByType).map(([key, count]) => `${key}: <span class="font-medium">${count}</span>`);
        const sections = [];
        if (typeParts.length > 0) {
          sections.push(`<div class="mb-2">Failed gate types: ${typeParts.join(", ")}</div>`);
        }
        if (recommendations.length > 0) {
          sections.push(`<div class="space-y-1">` + recommendations.map((item) => `<div class="flex gap-2 items-start"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0 text-primary"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> <span>${item}</span></div>`).join("") + `</div>`);
        }
        mergeReadinessRecommendations.innerHTML = sections.join("");
      }
    } catch (error) {
      mergeReadinessSummary.innerHTML = `<span class="text-red-500 flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-red-500"></span> ${error.message || "Failed to load merge readiness"}</span>`;
      mergeReadinessBreakdown.textContent = "";
      if (mergeReadinessBlockers) mergeReadinessBlockers.innerHTML = "";
      if (mergeReadinessRecommendations) mergeReadinessRecommendations.innerHTML = "";
    }
  }

  mergeReadinessRefresh?.addEventListener("click", async (event) => {
    event.preventDefault();
    loadMergeReadiness();
  });

  aiReviewBtn?.addEventListener("click", async () => {
    aiReviewBtn.setAttribute("disabled", "true");
    const originalText = aiReviewBtn.innerHTML;
    aiReviewBtn.innerHTML =
      '<span class="animate-spin mr-2">⟳</span> Reviewing...';
    errorDiv.classList.add("hidden");

    try {
      const res = await fetch(
        `/api/repos/${repoOwner}/${repoName}/pulls/${prNumber}/ai-review`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
        },
      );

      if (!res.ok) {
        const data = await res.json();
        throw new Error(data.error?.message || "Failed to trigger AI review");
      }

      // Wait a moment then reload to see results (if any UI showed them)
      // Real implementation woudl poll or show toast
      setTimeout(() => window.location.reload(), 2000);
    } catch (e) {
      errorDiv.querySelector("span").textContent = e.message;
      errorDiv.classList.remove("hidden");
      aiReviewBtn.removeAttribute("disabled");
      aiReviewBtn.innerHTML = originalText;
    }
  });

  queueBtn?.addEventListener("click", async () => {
    queueBtn.setAttribute("disabled", "true");
    queueBtn.textContent = "Queueing...";
    errorDiv.classList.add("hidden");

    try {
      const res = await fetch(
        `/api/repos/${repoOwner}/${repoName}/queue/join`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ pullRequestId: prId }),
        },
      );

      if (!res.ok) {
        const data = await res.json();
        throw new Error(data.error?.message || "Failed to enqueue");
      }
      window.location.reload();
    } catch (e) {
      errorDiv.querySelector("span").textContent = e.message;
      errorDiv.classList.remove("hidden");
      queueBtn.removeAttribute("disabled");
      queueBtn.textContent = "Add to merge queue";
    }
  });

  queueStackBtn?.addEventListener("click", async () => {
    if (!stackEntries || stackEntries.length === 0) return;

    queueStackBtn.setAttribute("disabled", "true");
    queueStackBtn.textContent = "Queueing stack...";
    queueStackError.classList.add("hidden");

    const targets = [...stackEntries]
      .filter((entry) => entry.state === "open" && !entry.isMerged)
      .sort((a, b) => a.order - b.order);

    try {
      for (const entry of targets) {
        const res = await fetch(
          `/api/repos/${repoOwner}/${repoName}/queue/join`,
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ pullRequestId: entry.id }),
          },
        );

        if (!res.ok) {
          const data = await res.json();
          throw new Error(data?.message || `Failed to queue PR #${entry.number}`);
        }
      }

      window.location.reload();
    } catch (e) {
      queueStackError.textContent = e.message || "Failed to queue stack";
      queueStackError.classList.remove("hidden");
      queueStackBtn.removeAttribute("disabled");
      queueStackBtn.textContent = "Add stack to merge queue";
    }
  });

  function showStackActionMessage(message, isError = false) {
    if (!rebaseStackMsg) return;
    rebaseStackMsg.textContent = message || "";
    rebaseStackMsg.classList.remove("hidden", "text-muted-foreground", "text-red-500", "text-green-600");
    rebaseStackMsg.classList.add(isError ? "text-red-500" : "text-green-600");
  }

  function resetStackActionButtons() {
    if (autoUpdateStackBtn) {
      autoUpdateStackBtn.removeAttribute("disabled");
      autoUpdateStackBtn.textContent = "Auto-update stack";
    }
    if (rebaseStackBtn) {
      rebaseStackBtn.removeAttribute("disabled");
      rebaseStackBtn.textContent = "Rebase stack";
    }
  }

  async function refreshStackMaintenanceStatus() {
    if (!stackId) return;
    try {
      const res = await fetch(
        `/api/repos/${repoOwner}/${repoName}/stacks/${stackId}/auto-update`,
      );
      const data = await res.json();
      if (!res.ok) return;

      if (data?.needsRebase) {
        if (autoUpdateStackBtn) {
          autoUpdateStackBtn.removeAttribute("disabled");
        }
        if (rebaseStackBtn) {
          rebaseStackBtn.removeAttribute("disabled");
        }
        showStackActionMessage(`Stack is ${data.behindBy} commit(s) behind base branch.`);
      } else {
        if (autoUpdateStackBtn) {
          autoUpdateStackBtn.setAttribute("disabled", "true");
          autoUpdateStackBtn.textContent = "Stack up to date";
        }
        showStackActionMessage("Stack is up to date.");
      }
    } catch {
      // Non-fatal status refresh
    }
  }

  async function refreshStackMergeReadiness() {
    if (!stackId || !stackMergeReadiness) return;

    try {
      const res = await fetch(
        `/api/repos/${repoOwner}/${repoName}/stacks/${stackId}/merge-readiness`,
      );
      const data = await res.json();
      if (!res.ok) return;

      const blockers = data?.blockers || [];
      stackMergeReadiness.textContent = data?.canMerge
        ? "Stack is ready to merge."
        : "Stack is not merge-ready.";

      if (stackMergeBlockers) {
        stackMergeBlockers.innerHTML = blockers
          .map((blocker) => `<div>• ${blocker}</div>`)
          .join("");
      }

      if (mergeStackBtn) {
        if (data?.canMerge) {
          mergeStackBtn.removeAttribute("disabled");
        } else {
          mergeStackBtn.setAttribute("disabled", "true");
        }
      }
    } catch {
      // Non-fatal readiness refresh failure
    }
  }

  rebaseStackBtn?.addEventListener("click", async () => {
    if (!stackId) return;

    if (autoUpdateStackBtn) {
      autoUpdateStackBtn.setAttribute("disabled", "true");
    }
    rebaseStackBtn.setAttribute("disabled", "true");
    rebaseStackBtn.textContent = "Rebasing...";
    showStackActionMessage("Rebasing stack...");

    try {
      const res = await fetch(
        `/api/repos/${repoOwner}/${repoName}/stacks/${stackId}/rebase`,
        { method: "POST" },
      );

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data?.message || "Failed to rebase stack");
      }

      showStackActionMessage(data?.message || "Rebase complete");

      if (data?.result?.success) {
        window.location.reload();
      }
    } catch (e) {
      showStackActionMessage(e.message || "Failed to rebase stack", true);
    } finally {
      resetStackActionButtons();
      refreshStackMaintenanceStatus();
    }
  });

  autoUpdateStackBtn?.addEventListener("click", async () => {
    if (!stackId) return;

    autoUpdateStackBtn.setAttribute("disabled", "true");
    autoUpdateStackBtn.textContent = "Auto-updating...";
    if (rebaseStackBtn) {
      rebaseStackBtn.setAttribute("disabled", "true");
    }
    showStackActionMessage("Running auto-update...");

    try {
      const res = await fetch(
        `/api/repos/${repoOwner}/${repoName}/stacks/${stackId}/auto-update`,
        { method: "POST" },
      );
      const data = await res.json();

      if (!res.ok) {
        throw new Error(data?.message || "Failed to auto-update stack");
      }

      showStackActionMessage(data?.message || "Auto-update completed");
      if (data?.performed && data?.result?.success) {
        window.location.reload();
      }
    } catch (e) {
      showStackActionMessage(e.message || "Failed to auto-update stack", true);
    } finally {
      resetStackActionButtons();
      refreshStackMaintenanceStatus();
    }
  });

  mergeStackBtn?.addEventListener("click", async () => {
    if (!stackId) return;
    const mergeMethod = stackMergeMethod?.value || "merge";

    mergeStackBtn.setAttribute("disabled", "true");
    mergeStackBtn.textContent = "Merging stack...";
    showStackActionMessage("Merging stack...");

    try {
      const res = await fetch(
        `/api/repos/${repoOwner}/${repoName}/stacks/${stackId}/merge`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ mergeMethod }),
        },
      );
      const data = await res.json();
      if (!res.ok) {
        throw new Error(data?.error?.message || data?.message || "Failed to merge stack");
      }

      const mergedCount = data?.merged?.length || 0;
      const failedCount = data?.failed?.length || 0;
      const skippedCount = data?.skipped?.length || 0;
      showStackActionMessage(
        `Stack merge complete: merged ${mergedCount}, failed ${failedCount}, skipped ${skippedCount}.`
      );
      window.location.reload();
    } catch (e) {
      showStackActionMessage(e.message || "Failed to merge stack", true);
    } finally {
      if (mergeStackBtn) {
        mergeStackBtn.textContent = "Merge stack";
      }
      refreshStackMergeReadiness();
    }
  });

  async function loadStackApprovals() {
    if (!stackId || !stackApprovalsStatus || !stackApprovalsList) return;

    stackApprovalsStatus.textContent = "Loading...";
    if (stackApprovalsBlockers) stackApprovalsBlockers.innerHTML = "";
    if (stackApprovalsRecommended) stackApprovalsRecommended.textContent = "";
    stackApprovalsList.innerHTML = "";

    try {
      const res = await fetch(
        `/api/repos/${repoOwner}/${repoName}/stacks/${stackId}/approvals`,
      );
      const data = await res.json();

      if (!res.ok) {
        throw new Error(data?.message || "Failed to load stack approvals");
      }

      const status = data.status;
      const blockers = data.blockers || [];
      stackApprovalRecommendations = data.recommendedReviewers || [];
      stackApprovalsStatus.textContent = status.allApproved
        ? "All PRs approved"
        : "Pending approvals";

      if (stackApprovalsBlockers) {
        if (blockers.length > 0) {
          stackApprovalsBlockers.innerHTML = blockers
            .map((blocker) => `<div>• ${blocker}</div>`)
            .join("");
        } else {
          stackApprovalsBlockers.innerHTML = "";
        }
      }
      if (stackApprovalsRecommended) {
        stackApprovalsRecommended.textContent = stackApprovalRecommendations.length > 0
          ? `Recommended reviewers: ${stackApprovalRecommendations.join(", ")}`
          : "No reviewer recommendations available.";
      }

      status.prs.forEach((pr) => {
        const row = document.createElement("div");
        row.className = "flex items-center justify-between text-xs";
        row.innerHTML = `
          <span>#${pr.prNumber} ${pr.title}</span>
          <span class="${pr.isApproved ? "text-green-500" : "text-amber-500"}">
            ${pr.approvalCount}/${pr.requiredApprovals}${pr.changesRequested ? " • changes requested" : ""}
          </span>
        `;
        stackApprovalsList.appendChild(row);
      });
    } catch (e) {
      stackApprovalsStatus.textContent = e.message || "Failed to load stack approvals";
    }
  }

  function parseReviewerCsv(input) {
    return input
      .split(",")
      .map((name) => name.trim())
      .filter(Boolean);
  }

  async function requestStackApprovals(reviewers, dryRun = false) {
    if (!stackId) {
      throw new Error("Stack not found");
    }
    if (reviewers.length === 0) {
      throw new Error("Enter at least one username");
    }

    const res = await fetch(
      `/api/repos/${repoOwner}/${repoName}/stacks/${stackId}/approvals`,
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ reviewers, dryRun }),
      },
    );
    const data = await res.json();
    if (!res.ok) {
      throw new Error(data?.error?.message || data?.message || "Failed to request approvals");
    }
    return data;
  }

  stackApprovalsRefresh?.addEventListener("click", (event) => {
    event.preventDefault();
    loadStackApprovals();
  });

  stackApprovalsRequest?.addEventListener("click", async (event) => {
    event.preventDefault();
    if (!stackId || !stackApprovalsReviewers) return;

    const reviewers = parseReviewerCsv(stackApprovalsReviewers.value);

    stackApprovalsMsg.textContent = "Requesting...";

    try {
      const data = await requestStackApprovals(reviewers, false);
      stackApprovalsMsg.textContent = `Requested: ${data.requested.join(", ")}`;
      stackApprovalsReviewers.value = "";
      loadStackApprovals();
    } catch (e) {
      stackApprovalsMsg.textContent = e.message || "Failed to request approvals";
    }
  });

  stackApprovalsPreview?.addEventListener("click", async (event) => {
    event.preventDefault();
    if (!stackApprovalsReviewers) return;

    const reviewers = parseReviewerCsv(stackApprovalsReviewers.value);
    stackApprovalsMsg.textContent = "Previewing...";

    try {
      const data = await requestStackApprovals(reviewers, true);
      const parts = [
        data.requested?.length ? `eligible: ${data.requested.join(", ")}` : "eligible: none",
      ];
      if (data.skipped?.length) parts.push(`no-access: ${data.skipped.join(", ")}`);
      if (data.notFound?.length) parts.push(`not-found: ${data.notFound.join(", ")}`);
      if (data.requestedDuplicates) parts.push(`duplicates: ${data.requestedDuplicates}`);
      stackApprovalsMsg.textContent = parts.join(" | ");
    } catch (e) {
      stackApprovalsMsg.textContent = e.message || "Failed to preview reviewers";
    }
  });

  stackApprovalsRequestRecommended?.addEventListener("click", async (event) => {
    event.preventDefault();
    const reviewers = stackApprovalRecommendations || [];
    if (reviewers.length === 0) {
      stackApprovalsMsg.textContent = "No recommended reviewers available";
      return;
    }

    stackApprovalsMsg.textContent = "Requesting recommended reviewers...";
    try {
      const data = await requestStackApprovals(reviewers, false);
      stackApprovalsMsg.textContent = `Requested: ${data.requested.join(", ")}`;
      loadStackApprovals();
    } catch (e) {
      stackApprovalsMsg.textContent = e.message || "Failed to request recommended reviewers";
    }
  });

  if (stackId) {
    loadStackApprovals();
    refreshStackMaintenanceStatus();
    refreshStackMergeReadiness();
  }
  loadAutoMergeStatus();
  loadPrChecks();
  loadCodeOwnerEnforcement();
  loadMergeReadiness();

  mergeBtn?.addEventListener("click", async () => {
    if (!confirm("Are you sure you want to merge this pull request?")) return;

    mergeBtn.setAttribute("disabled", "true");
    mergeBtn.textContent = "Merging...";
    errorDiv.classList.add("hidden");

    try {
      const res = await fetch(
        `/api/repos/${repoOwner}/${repoName}/pulls/${prNumber}/merge`,
        {
          method: "POST",
        },
      );

      if (!res.ok) {
        const data = await res.json();
        throw new Error(data.message || "Failed to merge");
      }

      window.location.reload();
    } catch (e) {
      errorDiv.querySelector("span").textContent = e.message;
      errorDiv.classList.remove("hidden");
      mergeBtn.removeAttribute("disabled");
      mergeBtn.textContent = "Merge pull request";
    }
  });

  async function loadLinkedIssues() {
    if (!linkedIssuesContainer) return;
    linkedIssuesContainer.innerHTML = "<div class=\"text-muted-foreground\">Loading...</div>";

    try {
      const res = await fetch(
        `/api/repos/${repoOwner}/${repoName}/pulls/${prNumber}/issue-links`,
      );
      if (!res.ok) throw new Error("Failed to load issues");

      const data = await res.json();
      const links = data.links || [];
      if (links.length === 0) {
        linkedIssuesContainer.textContent = "No linked issues";
        return;
      }

      linkedIssuesContainer.innerHTML = "";
      links.forEach((link) => {
        const row = document.createElement("div");
        row.className = "flex items-center justify-between gap-2";

        const anchor = document.createElement("a");
        anchor.href = `/${repoOwner}/${repoName}/issues/${link.issue.number}`;
        anchor.className = "text-primary hover:underline";
        anchor.textContent = `#${link.issue.number} ${link.issue.title}`;

        const meta = document.createElement("span");
        meta.className = "text-xs text-muted-foreground";
        meta.textContent = link.linkType;

        row.appendChild(anchor);
        row.appendChild(meta);

        linkedIssuesContainer.appendChild(row);
      });
    } catch (error) {
      linkedIssuesContainer.textContent = "Unable to load linked issues";
    }
  }

  linkIssueBtn?.addEventListener("click", async () => {
    linkIssueError?.classList.add("hidden");

    const rawNumber = linkIssueNumber?.value?.trim();
    const issueNumber = rawNumber?.replace("#", "");
    if (!issueNumber) return;

    linkIssueBtn.setAttribute("disabled", "true");

    try {
      const res = await fetch(
        `/api/repos/${repoOwner}/${repoName}/pulls/${prNumber}/issue-links`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            issueNumber: Number(issueNumber),
            linkType: linkIssueType?.value || "relates",
          }),
        },
      );

      if (!res.ok) {
        const data = await res.json();
        throw new Error(data.error?.message || "Failed to link issue");
      }

      if (linkIssueNumber) linkIssueNumber.value = "";
      await loadLinkedIssues();
    } catch (error) {
      linkIssueError.textContent = error.message || "Failed to link issue";
      linkIssueError.classList.remove("hidden");
    } finally {
      linkIssueBtn.removeAttribute("disabled");
    }
  });

  loadLinkedIssues();

  const fileApprovalContainers = document.querySelectorAll(".file-approval");

  async function loadFileApprovals() {
    if (fileApprovalContainers.length === 0) return;

    try {
      const res = await fetch(
        `/api/repos/${repoOwner}/${repoName}/pulls/${prNumber}/file-approvals`,
      );
      if (!res.ok) {
        throw new Error("Failed to load approvals");
      }
      const data = await res.json();
      const approvals = new Map(
        (data.files || []).map((file) => [file.path, file]),
      );

      fileApprovalContainers.forEach((container) => {
        const path = container.getAttribute("data-file-path");
        if (!path) return;

        const info = approvals.get(path);
        container.innerHTML = "";

        if (info?.approved) {
          const badge = document.createElement("span");
          badge.className = "px-2 py-0.5 rounded-full text-xs bg-green-500/10 text-green-500 border border-green-500/20";
          badge.textContent = `Approved${info.approvers?.length ? ` by ${info.approvers.join(", ")}` : ""}`;
          container.appendChild(badge);
          return;
        }

        if (info?.stale) {
          const stale = document.createElement("span");
          stale.className = "px-2 py-0.5 rounded-full text-xs bg-yellow-500/10 text-yellow-500 border border-yellow-500/20";
          stale.textContent = "Approval stale";
          container.appendChild(stale);
        } else {
          const pending = document.createElement("span");
          pending.className = "px-2 py-0.5 rounded-full text-xs bg-muted text-muted-foreground border border-border";
          pending.textContent = "Needs approval";
          container.appendChild(pending);
        }

        if (canApproveFiles) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "px-2 py-0.5 rounded-md text-xs border border-primary/30 text-primary hover:bg-primary/10";
          button.textContent = "Approve file";
          button.addEventListener("click", async () => {
            button.setAttribute("disabled", "true");
            try {
              const resp = await fetch(
                `/api/repos/${repoOwner}/${repoName}/pulls/${prNumber}/file-approvals`,
                {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ path }),
                },
              );

              if (!resp.ok) {
                throw new Error("Failed to approve file");
              }

              await loadFileApprovals();
            } catch (error) {
              button.removeAttribute("disabled");
              alert("Failed to approve file");
            }
          });
          container.appendChild(button);
        }
      });
    } catch (error) {
      fileApprovalContainers.forEach((container) => {
        container.textContent = "Approval status unavailable";
      });
    }
  }

  loadFileApprovals();
</script>

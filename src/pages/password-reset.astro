---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Logo from "@/components/ui/Logo.astro";
import { Mail, CheckCircle2, ArrowLeft, KeyRound, Loader2 } from "lucide-react";

if (Astro.locals.user) {
  return Astro.redirect("/dashboard");
}
---

<BaseLayout title="Reset your password · OpenCodeHub">
  <div class="flex min-h-[calc(100vh-8rem)] items-center justify-center py-12 px-4">
    <div class="w-full max-w-sm space-y-6">
      <!-- Header -->
      <div class="text-center space-y-2">
        <a href="/" class="inline-flex items-center gap-2.5 hover:opacity-90 transition-opacity">
          <Logo class="h-9 w-9 text-foreground" />
          <span class="text-xl font-bold text-foreground tracking-tight">OpenCodeHub</span>
        </a>
        <h1 class="text-xl font-semibold text-foreground tracking-tight">Reset your password</h1>
        <p class="text-xs text-muted-foreground">
          Enter your email address and we'll send you a password reset link.
        </p>
      </div>

      <!-- Card -->
      <div class="rounded-xl border border-border/80 bg-card/60 backdrop-blur-xl p-6 sm:p-7 shadow-sm">
        <form class="space-y-4" id="reset-form">
          <div class="space-y-1.5">
            <label for="email" class="block text-xs font-medium text-muted-foreground">
              Email address
            </label>
            <div class="relative">
              <Mail className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground pointer-events-none" />
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="name@example.com"
                required
                autofocus
                class="w-full rounded-md border border-border bg-background pl-9 pr-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:border-primary/50 focus:ring-2 focus:ring-primary/20 transition-all"
              />
            </div>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-2 px-4 rounded-md bg-[#238636] hover:bg-[#2ea043] text-white font-semibold text-sm shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-primary/40 flex items-center justify-center gap-2 disabled:opacity-60"
          >
            <span id="btn-text">Send reset link</span>
            <Loader2 id="btn-spinner" className="h-4 w-4 animate-spin hidden" />
          </button>
        </form>

        <!-- Success Message -->
        <div
          id="success-message"
          class="hidden mt-4 rounded-lg border border-emerald-500/30 bg-emerald-500/10 p-4 text-xs text-emerald-400 space-y-1"
        >
          <div class="flex items-start gap-2.5">
            <CheckCircle2 className="h-4 w-4 text-emerald-500 flex-shrink-0 mt-0.5" />
            <div>
              <p class="font-semibold text-foreground">Check your inbox</p>
              <p class="text-muted-foreground mt-0.5">
                If an account exists for that email, we've sent a link to reset your password.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer Link -->
      <div class="rounded-xl border border-border bg-card/40 p-4 text-center text-xs text-muted-foreground shadow-xs">
        Remember your password?{" "}
        <a href="/login" class="font-semibold text-foreground hover:underline inline-flex items-center gap-1">
          <ArrowLeft className="h-3 w-3" />
          <span>Sign in</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById("reset-form") as HTMLFormElement;
  const successMessage = document.getElementById("success-message");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const btnText = document.getElementById("btn-text");
  const btnSpinner = document.getElementById("btn-spinner");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const data = Object.fromEntries(formData);

    if (submitBtn) submitBtn.disabled = true;
    btnText?.classList.add("hidden");
    btnSpinner?.classList.remove("hidden");

    try {
      await fetch("/api/auth/password-reset", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(data),
      });

      form.reset();
      successMessage?.classList.remove("hidden");
    } catch (error) {
      console.error("Error requesting password reset:", error);
      successMessage?.classList.remove("hidden");
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      btnText?.classList.remove("hidden");
      btnSpinner?.classList.add("hidden");
    }
  });
</script>

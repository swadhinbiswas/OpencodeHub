---
import { resolveOrgOwners } from "@/lib/repo-owner";
import { getDatabase, schema } from "@/db";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { desc, eq } from "drizzle-orm";
import {
  Star,
  Search,
  BookMarked,
  GitFork,
  Compass
} from "lucide-react";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login");
}

const db = getDatabase();

// Fetch user's starred repositories
const starredRepos = await resolveOrgOwners(
  await db.query.repositoryStars.findMany({
    where: eq(schema.repositoryStars.userId, user.id),
    orderBy: [desc(schema.repositoryStars.createdAt)],
    with: {
      repository: {
        with: {
          owner: true,
        },
      },
    },
  }),
);

// Language colors
const langColors: Record<string, string> = {
  JavaScript: "bg-[#f1e05a]",
  TypeScript: "bg-[#3178c6]",
  Python: "bg-[#3572A5]",
  Rust: "bg-[#dea584]",
  Go: "bg-[#00ADD8]",
  Java: "bg-[#b07219]",
  Ruby: "bg-[#701516]",
  "C++": "bg-[#f34b7d]",
  C: "bg-[#555555]",
  PHP: "bg-[#4F5D95]",
  HTML: "bg-[#e34c26]",
  CSS: "bg-[#563d7c]",
  Vue: "bg-[#41b883]",
  Astro: "bg-[#ff5a03]",
  Shell: "bg-[#89e051]",
  Dockerfile: "bg-[#384d54]",
};

function timeAgo(date: string | number | Date) {
  if (!date) return "";
  const seconds = Math.floor(
    (new Date().getTime() - new Date(date).getTime()) / 1000
  );
  if (seconds < 60) return "just now";
  if (seconds < 3600) return `${Math.floor(seconds / 60)}m ago`;
  if (seconds < 86400) return `${Math.floor(seconds / 3600)}h ago`;
  if (seconds < 604800) return `${Math.floor(seconds / 86400)}d ago`;
  return new Date(date).toLocaleDateString();
}
---

<BaseLayout title="Your Stars · OpenCodeHub">
  <div class="container max-w-[1280px] mx-auto py-8 px-4 sm:px-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-border mb-6">
      <div>
        <h1 class="text-2xl font-bold text-foreground tracking-tight flex items-center gap-2.5">
          <Star className="h-6 w-6 text-foreground fill-amber-400/20 text-amber-400" />
          <span>Your Stars</span>
          <span class="rounded-full bg-secondary px-2.5 py-0.5 text-xs font-semibold text-muted-foreground border border-border/60">
            {starredRepos.length}
          </span>
        </h1>
        <p class="text-sm text-muted-foreground mt-1">Repositories you have starred across OpenCodeHub</p>
      </div>
      <a
        href="/explore"
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-md border border-border bg-card text-sm font-medium text-foreground hover:bg-accent transition-colors shadow-sm self-start sm:self-auto"
      >
        <Compass className="h-4 w-4" />
        <span>Explore more</span>
      </a>
    </div>

    <!-- Search Bar -->
    <div class="mb-6">
      <div class="relative group max-w-md">
        <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground group-focus-within:text-foreground transition-colors" />
        <input
          type="search"
          id="star-search"
          placeholder="Filter stars..."
          class="w-full h-9 rounded-md border border-border/70 bg-card/60 pl-9 pr-4 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary/40 focus:bg-background transition-all"
        />
      </div>
    </div>

    <!-- Starred Repositories List Card -->
    <div class="rounded-xl border border-border/80 bg-card/60 backdrop-blur-sm overflow-hidden shadow-sm">
      {starredRepos.length > 0 ? (
        <div id="stars-list" class="divide-y divide-border/60">
          {starredRepos.map((star) => {
            const ownerName = star.repository?.owner?.username || "unknown";
            const repoName = star.repository?.name || "repo";
            return (
              <div
                class="star-item flex flex-col sm:flex-row sm:items-start justify-between gap-4 p-5 hover:bg-accent/40 transition-colors"
                data-name={`${ownerName}/${repoName}`.toLowerCase()}
                data-desc={(star.repository?.description || "").toLowerCase()}
              >
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1.5">
                    <BookMarked className="h-4 w-4 text-muted-foreground flex-shrink-0" />
                    <a
                      href={`/${ownerName}/${repoName}`}
                      class="text-sm sm:text-base font-semibold text-primary hover:underline truncate"
                    >
                      {ownerName}/{repoName}
                    </a>
                    <span class="rounded-full border border-border/60 bg-muted/40 px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
                      {star.repository?.visibility || "public"}
                    </span>
                  </div>

                  {star.repository?.description && (
                    <p class="text-xs sm:text-sm text-muted-foreground line-clamp-2 mb-3 leading-relaxed">
                      {star.repository.description}
                    </p>
                  )}

                  <div class="flex items-center gap-4 text-xs text-muted-foreground flex-wrap">
                    {star.repository?.language && (
                      <div class="flex items-center gap-1.5 font-medium">
                        <span class={`h-2.5 w-2.5 rounded-full ${langColors[star.repository.language] || "bg-muted-foreground"}`} />
                        <span>{star.repository.language}</span>
                      </div>
                    )}
                    <div class="flex items-center gap-1">
                      <Star className="h-3.5 w-3.5 text-muted-foreground" />
                      <span>{star.repository?.starCount || 0}</span>
                    </div>
                    <div class="flex items-center gap-1">
                      <GitFork className="h-3.5 w-3.5 text-muted-foreground" />
                      <span>{star.repository?.forkCount || 0}</span>
                    </div>
                    <span>·</span>
                    <span>Starred {timeAgo(star.createdAt)}</span>
                  </div>
                </div>

                <a
                  href={`/${ownerName}/${repoName}`}
                  class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-md border border-border bg-secondary/80 text-xs font-medium text-foreground hover:bg-accent transition-colors self-start shadow-sm"
                >
                  <Star className="h-3.5 w-3.5 fill-amber-400 text-amber-400" />
                  <span>Starred</span>
                </a>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-16 px-4">
          <div class="w-12 h-12 rounded-full bg-secondary/80 border border-border flex items-center justify-center mx-auto mb-3 text-muted-foreground">
            <Star className="h-6 w-6" />
          </div>
          <h3 class="text-base font-semibold text-foreground mb-1">No starred repositories</h3>
          <p class="text-sm text-muted-foreground max-w-sm mx-auto mb-6">
            Explore interesting projects and star them to keep track of work you love.
          </p>
          <a
            href="/explore"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-foreground text-background text-sm font-medium hover:bg-foreground/90 transition-colors shadow-sm"
          >
            <Compass className="h-4 w-4" />
            Explore repositories
          </a>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  const starSearch = document.getElementById("star-search") as HTMLInputElement;
  const starItems = document.querySelectorAll(".star-item");

  starSearch?.addEventListener("input", () => {
    const q = starSearch.value.toLowerCase().trim();
    starItems.forEach((item) => {
      const el = item as HTMLElement;
      const name = el.dataset.name || "";
      const desc = el.dataset.desc || "";
      if (!q || name.includes(q) || desc.includes(q)) {
        el.style.display = "flex";
      } else {
        el.style.display = "none";
      }
    });
  });
</script>
